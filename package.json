{
  "name": "nowo-tech/ui-kit-bundle-assets",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "VITE_ENTRY=modal vite build && VITE_ENTRY=shell vite build && VITE_ENTRY=toast vite build && VITE_ENTRY=confirm vite build && VITE_ENTRY=page-loader vite build && VITE_ENTRY=theme vite build && pnpm run build:theme-boot && VITE_ENTRY=orb vite build && VITE_ENTRY=clipboard vite build && VITE_ENTRY=tabs vite build && VITE_ENTRY=release vite build && VITE_ENTRY=open-modal vite build && VITE_ENTRY=dialog vite build && pnpm run build:css",
    "build:css": "node .scripts/build-layered-css.mjs",
    "build:modal": "VITE_ENTRY=modal vite build",
    "build:shell": "VITE_ENTRY=shell vite build",
    "build:toast": "VITE_ENTRY=toast vite build",
    "build:confirm": "VITE_ENTRY=confirm vite build",
    "build:page-loader": "VITE_ENTRY=page-loader vite build",
    "build:theme": "VITE_ENTRY=theme vite build",
    "build:theme-boot": "VITE_ENTRY=theme-boot vite build && mkdir -p src/Resources/views/inline && cp src/Resources/public/js/nowo-ui-theme-boot.js src/Resources/views/inline/nowo-ui-theme-boot.js",
    "build:orb": "VITE_ENTRY=orb vite build",
    "build:clipboard": "VITE_ENTRY=clipboard vite build",
    "build:tabs": "VITE_ENTRY=tabs vite build",
    "build:release": "VITE_ENTRY=release vite build",
    "build:open-modal": "VITE_ENTRY=open-modal vite build",
    "build:dialog": "VITE_ENTRY=dialog vite build",
    "watch": "VITE_ENTRY=modal vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "datatables.net-dt": "2.3.8",
    "datatables.net-responsive-dt": "3.0.8",
    "happy-dom": "^20.14.6",
    "lucide": "1.56.0",
    "morphicons": "1.7.1",
    "sass": "1.93.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "datatables.net-dt": "^2.3.0",
    "datatables.net-responsive-dt": "^3.0.0",
    "lucide": "^1.0.0",
    "morphicons": "^1.7.0"
  },
  "peerDependenciesMeta": {
    "datatables.net-dt": {
      "optional": true
    },
    "datatables.net-responsive-dt": {
      "optional": true
    },
    "lucide": {
      "optional": true
    },
    "morphicons": {
      "optional": true
    }
  }
}
