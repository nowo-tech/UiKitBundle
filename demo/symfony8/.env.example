# Demo environment template (REQ-DEMO-003). `make up` copies it to .env when .env is missing.
# Local-only values: never put real secrets here.

###> symfony/framework-bundle ###
# APP_ENV: Symfony environment (dev/test/prod). The demo runs in `dev`.
APP_ENV=dev

# APP_SECRET: secret used by Symfony to sign tokens / URIs. Local-only placeholder; generate a random value for any shared instance.
APP_SECRET=change_this_secret_key_to_a_random_value

# APP_DEBUG: 1 shows detailed errors and enables the profiler / Twig debug; 0 behaves like production.
APP_DEBUG=1

# FRANKENPHP_MODE: classic | worker (REQ-DEMO-010). Default: worker.
FRANKENPHP_MODE=worker
###< symfony/framework-bundle ###

# PORT: host port published by docker-compose (bound to 127.0.0.1) and printed by `make up` ("Demo started at").
PORT=8092

###> symfony/routing ###
# DEFAULT_URI: base URL used to generate absolute URLs outside an HTTP request (CLI, e2e); keep it in sync with PORT.
DEFAULT_URI=http://localhost:8092
###< symfony/routing ###
