{
    "name": "nowo-tech/ui-kit-bundle-demo",
    "type": "project",
    "license": "MIT",
    "require": {
        "nowo-tech/ui-kit-bundle": "dev-main as 1.2.99",
        "php": ">=8.4,<8.6",
        "symfony/asset": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/routing": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": "^3.12",
        "twig/string-extra": "^3.12"
    },
    "repositories": [
        {
            "type": "path",
            "url": "/var/ui-kit-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "scripts": {
        "auto-scripts": {
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "test": "@php vendor/bin/phpunit --color=always"
    },
    "require-dev": {
        "nowo-tech/hot-reload-bundle": "^1.4",
        "nowo-tech/twig-inspector-bundle": "*",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "symfony/debug-bundle": "^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^7.4 || ^8.0"
    },
    "extra": {
        "symfony": {
            "require": "8.1.*"
        }
    }
}
