{% extends 'catalogue/_base.html.twig' %}
{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header', 'DemoPlatformCatalogue'), {bundle: 'DemoPlatformCatalogue', title: 'Badges and tokens', intro: 'Status colours come from tokens only; no colour literal in a demo.'}) }}
{% endblock %}
{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Badges', kind: 'content', testid: 'catalogue-badges'} %}
        {% block section_body %}
            <div class="nowo-ui-row-actions">
                {% for tone in ['neutral', 'info', 'success', 'warning', 'danger', 'primary'] %}<span class="nowo-ui-badge nowo-ui-badge--{{ tone }}">{{ tone }}</span>{% endfor %}
            </div>
        {% endblock %}
    {% endembed %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Tokens', intro: 'Swatches of the base tokens (light and dark follow the theme).', kind: 'list'} %}
        {% block section_body %}
            <ul class="nowo-ui-demo-swatches">
                {% for token in ['primary', 'surface', 'surface-muted', 'border', 'text', 'muted', 'success-bg', 'warning-bg', 'danger-bg', 'info-bg'] %}
                    <li class="nowo-ui-demo-swatch" data-nowo-ui-token="{{ token }}"><span class="nowo-ui-demo-swatch__chip" aria-hidden="true"></span><code class="nowo-ui-code">--nowo-ui-{{ token }}</code></li>
                {% endfor %}
            </ul>
        {% endblock %}
    {% endembed %}
{% endblock %}
