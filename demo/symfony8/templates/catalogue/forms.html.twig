{% extends 'catalogue/_base.html.twig' %}
{% form_theme catalogue_form '@NowoUiKitBundle/form/nowo_ui_layout.html.twig' %}
{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header', 'DemoDefaultTheme'), {title: 'Forms', intro: 'Forms always sit in a card; the actions go at the bottom right, the primary button last.'}) }}
{% endblock %}
{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Contact details', intro: 'kind: form — Symfony form, UiKit form theme.', kind: 'form', testid: 'catalogue-form'} %}
        {% block section_body %}
            {{ form_start(catalogue_form, {attr: {id: 'catalogue-contact-form'}}) }}
                {{ form_widget(catalogue_form) }}
            {{ form_end(catalogue_form) }}
        {% endblock %}
        {% block section_footer %}
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('catalogue', {group: 'forms'}) }}">Cancel</a>
            <button type="submit" form="catalogue-contact-form" class="nowo-ui-btn nowo-ui-btn--primary">Save</button>
        {% endblock %}
    {% endembed %}
{% endblock %}
