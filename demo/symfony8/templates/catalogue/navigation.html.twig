{% extends 'catalogue/_base.html.twig' %}
{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Navigation', intro: 'The aside nav (sections, current item), tabs and pagination.'}) }}
{% endblock %}
{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Tabs', intro: 'Server-side tabs: one panel at a time.', kind: 'content'} %}
        {% block section_body %}
            {{ include(nowo_ui_partial('tabs'), {aria_label: 'Invoice views', items: [{label: 'All', href: '#', current: true}, {label: 'Due', href: '#'}, {label: 'Paid', href: '#'}]}) }}
            <p class="nowo-ui-muted">The current tab carries aria-current; panels are separate requests.</p>
        {% endblock %}
    {% endembed %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Pagination', kind: 'content'} %}
        {% block section_body %}
            {{ include(nowo_ui_partial('pagination'), {pagination: {page: 2, per_page: 10, total: 42, total_pages: 5}, item_count: 10, route: 'catalogue', route_params: {group: 'navigation'}}) }}
        {% endblock %}
    {% endembed %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Aside navigation', kind: 'list'} %}
        {% block section_body %}
            <p>The aside groups the demo's nav items in sections; the current item is marked with <code class="nowo-ui-code">aria-current="page"</code>. On phones it is a drawer behind the burger.</p>
        {% endblock %}
    {% endembed %}
{% endblock %}
