{% extends 'catalogue/_base.html.twig' %}
{% block nowo_ui_page_header %}
    {% set _toolbar %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="https://github.com/nowo-tech/UiKitBundle/blob/main/docs/USAGE.md#demo-platform-shell-260">Read the rules</a>{% endset %}
    {{ include(nowo_ui_partial('page_header', 'DemoPlatformCatalogue'), {bundle: 'DemoPlatformCatalogue', title: 'Layout', intro: 'The page grammar every demo follows: page header, flashes, then section cards on one spacing scale.', toolbar: _toolbar}) }}
{% endblock %}
{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Page header', intro: 'Title, subtitle and the page actions on the right; one primary action per view.', kind: 'detail'} %}
        {% block section_body %}
            <p><code class="nowo-ui-code">{% verbatim %}{{ include(nowo_ui_partial('page_header'), {title, intro, toolbar}) }}{% endverbatim %}</code></p>
            <p class="nowo-ui-muted">Bundle demos copy this plain form. UiKit's own catalogue templates pass an internal theme key (<code class="nowo-ui-code">DemoPlatformCatalogue</code>) only because the UiKit demo app also hosts a host-theme showcase; a bundle demo never passes one.</p>
        {% endblock %}
    {% endembed %}
    <div class="nowo-ui-cards">
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Section card', intro: 'Header with title and actions, body, optional footer.', kind: 'detail'} %}
            {% block section_actions %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="#">Action</a>{% endblock %}
            {% block section_body %}<p><code class="nowo-ui-code">{% verbatim %}{% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title, kind} %}{% endverbatim %}</code></p>{% endblock %}
            {% block section_footer %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="#">Footer action</a>{% endblock %}
        {% endembed %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Spacing scale', intro: 'One gap between blocks and between cards.', kind: 'list'} %}
            {% block section_body %}
                <ul class="nowo-ui-list">
                    <li class="nowo-ui-list-item"><code class="nowo-ui-code">--nowo-ui-space-1</code> 0.25rem</li>
                    <li class="nowo-ui-list-item"><code class="nowo-ui-code">--nowo-ui-space-2</code> 0.5rem</li>
                    <li class="nowo-ui-list-item"><code class="nowo-ui-code">--nowo-ui-space-3</code> 1rem (the gap)</li>
                    <li class="nowo-ui-list-item"><code class="nowo-ui-code">--nowo-ui-space-4</code> 1.5rem</li>
                </ul>
            {% endblock %}
        {% endembed %}
    </div>
{% endblock %}
