{#- UiKit demo on the demo platform shell (2.60): the component catalogue and the component showcases, UiKit's default
    theme only. "Shell lab" links the full-page previews of the kit's own shells (no platform shell around them) and
    "Host theme" the one host-theme preview (/page-contract, Acme tokens and stylesheet). No CSS framework anywhere. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'UiKit',
    home_route: 'catalogue',
    repository: 'https://github.com/nowo-tech/UiKitBundle',
    translation_domain: false,
    nav: [
        {label: 'Layout', route: 'catalogue', params: {group: 'layout'}, section: 'Catalogue', testid: 'catalogue-nav-layout'},
        {label: 'Cards and tables', route: 'catalogue', params: {group: 'cards-tables'}, section: 'Catalogue', testid: 'catalogue-nav-cards-tables'},
        {label: 'Forms', route: 'catalogue', params: {group: 'forms'}, section: 'Catalogue', testid: 'catalogue-nav-forms'},
        {label: 'Feedback states', route: 'catalogue', params: {group: 'feedback'}, section: 'Catalogue', testid: 'catalogue-nav-feedback'},
        {label: 'Navigation', route: 'catalogue', params: {group: 'navigation'}, section: 'Catalogue', testid: 'catalogue-nav-navigation'},
        {label: 'Dialogs', route: 'catalogue', params: {group: 'dialogs'}, section: 'Catalogue', testid: 'catalogue-nav-dialogs'},
        {label: 'Badges and tokens', route: 'catalogue', params: {group: 'badges-tokens'}, section: 'Catalogue', testid: 'catalogue-nav-badges-tokens'},
        {label: 'Data tables', route: 'catalogue_admin', params: {group: 'data-tables'}, section: 'Admin components', testid: 'catalogue-nav-data-tables'},
        {label: 'Data display', route: 'catalogue_admin', params: {group: 'data-display'}, section: 'Admin components', testid: 'catalogue-nav-data-display'},
        {label: 'Form patterns', route: 'catalogue_admin', params: {group: 'form-patterns'}, section: 'Admin components', testid: 'catalogue-nav-form-patterns'},
        {label: 'Feedback and overlays', route: 'catalogue_admin', params: {group: 'overlays'}, section: 'Admin components', testid: 'catalogue-nav-overlays'},
        {label: 'Breadcrumbs, tabs and steps', route: 'catalogue_admin', params: {group: 'navigation-patterns'}, section: 'Admin components', testid: 'catalogue-nav-navigation-patterns'},
        {label: 'Dialogs', route: 'kit_dialogs', section: 'Component showcases'},
        {label: 'Page actions and dialogs', route: 'kit_page_actions_dialogs', section: 'Component showcases'},
        {label: 'Remote form dialogs', route: 'kit_remote_form', section: 'Component showcases'},
        {label: 'Row actions confirm', route: 'kit_row_actions_confirm', section: 'Component showcases'},
        {label: 'Small options', route: 'kit_small_options', section: 'Component showcases'},
        {label: 'Side panel', route: 'kit_side_panel', section: 'Component showcases'},
        {label: 'Avatars', route: 'kit_avatars', section: 'Component showcases'},
        {label: 'Multi-select and date range', route: 'kit_multi_select', section: 'Component showcases'},
        {label: 'Combobox', route: 'kit_combobox', section: 'Component showcases'},
        {label: 'Emoji picker and show more', route: 'kit_emoji_show_more', section: 'Component showcases'},
        {label: 'Image crop', route: 'kit_image_crop', section: 'Component showcases'},
        {label: 'Context menu', route: 'kit_context_menu', section: 'Component showcases'},
        {label: 'Sortable', route: 'kit_sortable', section: 'Component showcases'},
        {label: 'Item attributes', route: 'kit_223_item_attributes', section: 'Component showcases'},
        {label: 'Pagination modes', route: 'kit_223_pagination', params: {mode: 'infinite'}, active: ['kit_223_pagination'], section: 'Component showcases'},
        {label: 'Provider fields', route: 'kit_223_provider_fields', section: 'Component showcases'},
        {label: 'Demo platform sample', route: 'kit_demo_platform', active: ['kit_demo_platform'], section: 'Shell lab'},
        {label: 'App shell', route: 'kit_shell', section: 'Shell lab'},
        {label: 'Sidebar layouts', route: 'kit_sidebar_layout', section: 'Shell lab'},
        {label: 'Focus mode', route: 'kit_focus_mode', section: 'Shell lab'},
        {label: 'Compact header', route: 'kit_compact_header', section: 'Shell lab'},
        {label: 'Wiki layout', route: 'kit_wiki_layout', section: 'Shell lab'},
        {label: 'Phone mode', route: 'kit_mobile', section: 'Shell lab'},
        {label: 'Kitchen sink', route: 'nowo_ui_kit_kitchen_sink', section: 'Shell lab'},
        {label: 'Page contract (Acme)', route: 'page_contract_index', section: 'Host theme'},
    ],
} %}
{% set nowo_ui_document_title = nowo_ui_document_title|default('UiKit catalogue') %}
{#- The demo's default-theme exception (config/packages/nowo_ui_kit.yaml): no host class map, the kit page header. -#}
{% set nowo_ui_bundle = 'DemoPlatformCatalogue' %}
