{# Acme host sidebar (host markup: the host owns its shell). #}
{% set _route = app.request.attributes.get('_route') %}
<p class="acme-brand"><span class="acme-brand__mark">A</span> Acme Admin</p>
<nav class="acme-nav" aria-label="Main">
    {% for item in [
        {route: 'page_contract_index', label: 'Overview'},
        {route: 'page_contract_dashboard', label: 'Dashboard'},
        {route: 'page_contract_orders', label: 'Orders'},
        {route: 'page_contract_wizard', label: 'Onboarding'},
        {route: 'page_contract_settings', label: 'Settings'},
    ] %}
        <a class="acme-nav__link{{ _route starts with item.route ? ' is-current' }}" href="{{ path(item.route) }}">{{ item.label }}</a>
    {% endfor %}
</nav>
<p class="acme-nav__foot"><a href="{{ path('page_contract_default_index', {theme: 'default'}) }}">Compare with the default theme →</a></p>
<p class="acme-nav__foot"><a href="{{ path('catalogue') }}">Back to the UiKit catalogue →</a></p>
