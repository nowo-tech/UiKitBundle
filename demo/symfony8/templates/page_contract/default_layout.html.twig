{#
  Default-theme view of the page contract demo: UiKit's own admin layout with Bootstrap and nowo-ui.css only — no
  host tokens, no host stylesheet. Used as the per-page layout override (ListPage(layout: …)) together with the
  DemoDefaultTheme per-bundle exception that resets the host class map and partial.
#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_styles %}
    {#- UiKit 2.0 ships nowo-ui.css in @layer nowo-ui: a CDN framework goes into the base layer (below the kit, as the
        1.x load order did) and the layer order is declared first (PAGE_CONTRACT.md#cascade-layers). -#}
    <style>@layer theme, base, nowo-ui, components, utilities; @import url("https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css") layer(base);</style>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
    <style>
        .nowo-ui-page--admin > .nowo-ui-content { max-width: 72rem; margin: 0 auto; padding: 1.5rem; }
        .demo-masthead { border-bottom: 1px solid var(--bs-border-color); background: var(--bs-body-bg); }
        .demo-masthead .container-xl { max-width: 72rem; }
    </style>
{% endblock %}

{#- Masthead (demo host chrome, not UiKit markup): brand + main navigation with the active item, like a real host
    header. The page content below is UiKit's default theme. -#}
{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route') %}
    <header class="demo-masthead">
        <nav class="navbar navbar-expand container-xl px-4" aria-label="Main">
            <a class="navbar-brand fw-semibold" href="{{ path('page_contract_default_index', {theme: 'default'}) }}">Acme Admin</a>
            <ul class="navbar-nav me-auto">
                {% for item in [
                    {route: 'page_contract_default_dashboard', label: 'Dashboard'},
                    {route: 'page_contract_default_orders', label: 'Orders'},
                    {route: 'page_contract_default_wizard', label: 'Onboarding'},
                    {route: 'page_contract_default_settings', label: 'Settings'},
                ] %}
                    {% set _active = _route starts with item.route or (item.route == 'page_contract_default_orders' and _route starts with 'page_contract_default_order') %}
                    <li class="nav-item"><a class="nav-link{{ _active ? ' active fw-semibold' }}" href="{{ path(item.route, {theme: 'default'}) }}"{% if _active %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
                {% endfor %}
            </ul>
            <a class="small" href="{{ path('page_contract_index') }}">Host theme →</a>
        </nav>
    </header>
{% endblock %}
