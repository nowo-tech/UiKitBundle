{# Orders (list scaffold): the page fills only the row cells; header, filters, table frame, row actions, confirm
   dialogs, pagination and empty state come from the scaffold. Cells carry data-label (card mode of the responsive
   table) and the optional "Placed" column its priority. #}
{% extends '@NowoUiKit/page/list.html.twig' %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _status = {paid: 'badge_success', pending: 'badge_warning', shipped: 'badge_info', refunded: 'badge_neutral'} %}
    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="#">#{{ row.id }}</td>
    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="Customer">{{ row.customer }}<br><small class="nowo-ui-muted">{{ row.email }}</small></td>
    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="Placed" data-nowo-ui-priority="3">{{ row.placed }}</td>
    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="Status"><span class="{{ nowo_ui_class(_status[row.status], _b) }}">{{ row.status|capitalize }}</span></td>
    <td class="{{ nowo_ui_class('table_cell', _b) }} nowo-ui-cell--end" data-label="Total">{{ row.total }} €</td>
{% endblock %}
