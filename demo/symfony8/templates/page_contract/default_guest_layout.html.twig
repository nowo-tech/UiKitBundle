{# Default-theme view, guest pages: UiKit's own guest layout with UiKit's assets only (see default_layout.html.twig).
   The centred card comes from .nowo-ui-page--guest in nowo-ui.css, the document base from nowo-ui-base.css. #}
{% extends '@NowoUiKit/layout/guest.html.twig' %}

{% block nowo_ui_styles %}
    {#- UiKit's two stylesheets and nothing else; nowo_ui_tokens() is deliberately not called (UiKit's own palette). -#}
    <link rel="stylesheet" href="{{ asset('css/nowo-ui-base.css', 'nowo_ui_kit') }}">
    <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
    {#- Icons only: UiKit ships no icon font, and this demo runs with icon_set: bootstrap-icons. -#}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
{% endblock %}
