{# Default-theme view, guest pages: UiKit's own guest layout without host tokens (see default_layout.html.twig). #}
{% extends '@NowoUiKit/layout/guest.html.twig' %}

{% block nowo_ui_styles %}
    {#- UiKit 2.0 ships nowo-ui.css in @layer nowo-ui: a CDN framework goes into the base layer (below the kit, as the
        1.x load order did) and the layer order is declared first (PAGE_CONTRACT.md#cascade-layers). -#}
    <style>@layer theme, base, nowo-ui, components, utilities; @import url("https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css") layer(base);</style>
    <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
    <style>.nowo-ui-page--guest { max-width: 28rem; margin: 3rem auto; padding: 0 1rem; }</style>
{% endblock %}
