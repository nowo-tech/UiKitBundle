{# Shop dashboard (dashboard scaffold): KPI tiles from the view model, two cards from the page (slots, and the card partial). #}
{% extends '@NowoUiKit/page/dashboard.html.twig' %}

{% block nowo_ui_dashboard_cards %}
    {% set _b = page.bundle %}
    <section class="{{ nowo_ui_class('card', _b) }}"{{ nowo_ui_attrs('card', _b) }}>
        <header class="{{ nowo_ui_class('card_header', _b) }}"><h2 class="nowo-ui-card__title">Recent orders</h2></header>
        {# The reusable table partial (View\Table, 2.2): same markup and slots as the list scaffold's table #}
        {{ include(nowo_ui_partial('table', _b), {table: recent, bundle: _b, nowo_ui_page_type: nowo_ui_page_type}, false) }}
    </section>
    {# The UiKit card partial (theme slots card / card_header / card_body, host-replaceable via theme.partials.card). #}
    {% set _stock %}
        <dl class="{{ nowo_ui_class('detail_list', _b) }}">
            {% for item in stock %}
                <div class="nowo-ui-detail-list__item">
                    <dt class="nowo-ui-detail-list__label">{{ item.product }}</dt>
                    <dd class="nowo-ui-detail-list__value"><span class="{{ nowo_ui_class(item.left < 5 ? 'badge_danger' : 'badge_warning', _b) }}">{{ item.left }} left</span></dd>
                </div>
            {% endfor %}
        </dl>
    {% endset %}
    {% set _stock %}{{ _stock }}<p><button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-nowo-ui-dialog-open="restock-dialog">Restock details</button></p>{% endset %}
    {{ include(nowo_ui_partial('card', _b), {title: 'Low stock', body: _stock, bundle: _b}, false) }}
{% endblock %}

{# Generic native dialog (partial `dialog`, 2.1): framework-free, opened by data-nowo-ui-dialog-open #}
{% block nowo_ui_modals %}
    {% set _footer %}<button type="button" class="{{ nowo_ui_class('btn_primary', page.bundle) }}" data-nowo-ui-dialog-close>Got it</button>{% endset %}
    {{ include(nowo_ui_partial('dialog', page.bundle), {
        id: 'restock-dialog',
        title: 'Restock schedule',
        body: '<p>Suppliers deliver on Mondays and Thursdays. Orders placed before 12:00 ship the same day.</p>',
        body_muted: true,
        footer: _footer,
        bundle: page.bundle,
    }, false) }}
{% endblock %}
