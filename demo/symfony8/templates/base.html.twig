<!DOCTYPE html>
<html lang="en" data-nowo-ui-thin-scrollbars{% block html_attributes %}{% endblock %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}UiKit demo{% endblock %}</title>
    {#- UiKit 2.0 ships nowo-ui.css in @layer nowo-ui: a CDN framework goes into the base layer (below the kit, as the
        1.x load order did) and the layer order is declared first (PAGE_CONTRACT.md#cascade-layers). -#}
    <style>@layer theme, base, nowo-ui, components, utilities; @import url("https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css") layer(base);</style>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
    <style>body.page-demo { margin: 0; padding: 0; }</style>
</head>
<body class="{% block body_class %}page-demo{% endblock %}">
    {% block body %}{% endblock %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
