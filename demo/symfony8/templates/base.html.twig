<!DOCTYPE html>
{#-
  Demo base for the pages that bring their own layout (the kitchen sink, the page contract host theme). No CSS
  framework: UiKit's document base (nowo-ui-base.css) under whatever the page links in `stylesheets`.
-#}
<html lang="en" data-nowo-ui-thin-scrollbars{% block html_attributes %}{% endblock %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}UiKit demo{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/nowo-ui-base.css', 'nowo_ui_kit') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="{% block body_class %}page-demo{% endblock %}">
    {% block body %}{% endblock %}
    {% block javascripts %}{% endblock %}
</body>
</html>
