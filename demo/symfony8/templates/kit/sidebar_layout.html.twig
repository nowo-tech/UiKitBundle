{#
  UiKit 2.32 demo: the app shell's sidebar layout (KitSidebarLayoutController). The layout comes from the request
  attribute _nowo_ui_sidebar_layout; the brand from the brand parts (brand_icon_html + brand_name + brand_href), which
  fill both the aside head and the header; no template override and no layout CSS of its own (the Shell lab section of
  css/nowo-ui-demo-platform.css only pins the footer for ?footer=fixed and draws the logo). 2.52: the sidebar style comes from the request attribute
  _nowo_ui_sidebar_style (?style=inset); ?width=content constrains the content; ?panel=column|drawer adds a kit side
  panel (a sticky column, or an open overlay drawer).
#}
{% extends '@NowoUiKit/layout/document.html.twig' %}
{#- Shell lab: UiKit's default theme (the catalogue's exception, no host class map); partials read `bundle`. -#}
{% set bundle = 'DemoPlatformCatalogue' %}
{% set nowo_ui_bundle = 'DemoPlatformCatalogue' %}
{% set nowo_ui_document_title = 'Sidebar layout · UiKit 2.32' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/nowo-ui-demo-platform.css', 'nowo_ui_kit') }}">
{% endblock %}

{% block nowo_ui_body %}
    <a class="{{ nowo_ui_class('skip_link', 'DemoPlatformCatalogue') }}" href="#main-content">Skip to main content</a>
    {% set logo %}<svg class="nowo-ui-lab-logo" viewBox="0 0 24 24" width="24" height="24" focusable="false"><rect x="2" y="2" width="20" height="20" rx="6" fill="currentColor"/><path d="M7 15.5 12 7l5 8.5H7Z" fill="#fff"/></svg>{% endset %}
    {% set header_end %}
        <a class="{{ nowo_ui_class('btn_secondary', 'DemoPlatformCatalogue') }}" href="{{ path('kit_sidebar_layout', query|merge({layout: nowo_ui_sidebar_layout() == 'full-height' ? 'below-header' : 'full-height'})) }}" data-testid="switch-layout">{{ nowo_ui_sidebar_layout() == 'full-height' ? 'Below header' : 'Full height' }}</a>
        {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', {compact: true}) }}
    {% endset %}
    {% set header_context = compact ? include(nowo_ui_partial('header_context', 'DemoPlatformCatalogue'), {
        home_href: path('nowo_ui_kit_kitchen_sink'),
        crumbs: [{label: 'Billing', href: path('kit_sidebar_layout', query)}, {label: 'Invoices'}],
        attr: {'data-testid': 'header-context'},
    }) : '' %}
    {{ include(nowo_ui_partial('app_shell_open', 'DemoPlatformCatalogue'), {
        brand_icon_html: logo,
        brand_name: 'Acme Billing',
        brand_href: path('kit_sidebar_layout', query),
        header_end: header_end,
        header_context: header_context,
        aside_label: 'Billing',
        aside_items: [
            {label: 'Invoices', href: path('kit_sidebar_layout', query), current: true},
            {label: 'Customers', href: path('kit_sidebar_layout', query|merge({at: 'customers'}))},
            {label: 'Reports', href: path('kit_sidebar_layout', query|merge({at: 'reports'}))},
            {label: 'Settings', href: path('kit_sidebar_layout', query|merge({at: 'settings'}))},
        ],
        rail_mode: true,
        rail: mode == 'rail',
        collapsed: mode == 'hidden',
        hover_expand: hover,
        name: 'Ada Lovelace',
        initials: 'AL',
        email: 'ada@example.com',
        burger_icon: 'morph',
        shell_attr: {'data-nowo-ui-sidebar-default': mode, 'data-testid': 'shell', 'data-nowo-ui-lab-footer': footer_fixed ? 'fixed' : null, class: content_width ? 'is-main-content' : null},
    }) }}
    {% set invoices %}
            <section class="{{ nowo_ui_class('card', 'DemoPlatformCatalogue') }}">
                <div class="{{ nowo_ui_class('card_header', 'DemoPlatformCatalogue') }}">
                    <h1 class="{{ nowo_ui_class('card_title', 'DemoPlatformCatalogue') }}">Invoices</h1>
                </div>
                <div class="{{ nowo_ui_class('card_body', 'DemoPlatformCatalogue') }}">
                    <p>Layout <strong data-testid="layout">{{ nowo_ui_sidebar_layout() }}</strong>, style <strong data-testid="style">{{ nowo_ui_sidebar_style() }}</strong>, aside <strong>{{ mode }}</strong>{{ hover ? ', hover expand on' }}{{ footer_fixed ? ', fixed footer' }}{{ content_width ? ', content width' }}.</p>
                    <p><a href="{{ path('kit_sidebar_layout', query|merge({style: nowo_ui_sidebar_style() == 'inset' ? 'classic' : 'inset'})) }}" data-testid="switch-style">Switch to the {{ nowo_ui_sidebar_style() == 'inset' ? 'classic' : 'inset' }} style</a></p>
                    <ul class="kit-demo-rows" data-testid="kit-rows">
                        {% for row in rows %}<li>{{ row }}</li>{% endfor %}
                    </ul>
                </div>
            </section>
    {% endset %}
        <main id="main-content" tabindex="-1" class="nowo-ui-content" data-testid="sidebar-layout-main">
{% if panel %}
            {% embed '@NowoUiKitBundle/partials/_side_panel_container.html.twig' with {open: true, attr: {'data-testid': 'panel-container'}} %}
                {% block nowo_ui_side_panel_main %}
                    {{ invoices }}
                {% endblock %}
                {% block nowo_ui_side_panel_panel %}
                    {% embed '@NowoUiKitBundle/partials/_side_panel.html.twig' with {
                        id: 'demo-chat',
                        title: 'Chat',
                        open: true,
                        layout: panel == 'drawer' ? 'overlay' : 'inline',
                        close_href: path('kit_sidebar_layout', query|merge({panel: null})),
                        attr: {'data-testid': 'side-panel'},
                    } only %}
                        {% block nowo_ui_side_panel_body %}
                            <p>Messages dock here, beside the content (column) or over it (drawer).</p>
                        {% endblock %}
                    {% endembed %}
                {% endblock %}
            {% endembed %}
{% else %}
            {{ invoices }}
{% endif %}
        </main>
    {{ include(nowo_ui_partial('app_shell_close', 'DemoPlatformCatalogue'), {footer_copyright: '© Acme', footer_links: [{label: 'Privacy', href: path('kit_sidebar_layout', query|merge({at: 'privacy'}))}]}) }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('js/nowo-ui-shell.js', 'nowo_ui_kit') }}" defer></script>
    {% if panel %}
        <script src="{{ asset('js/nowo-ui-side-panel.js', 'nowo_ui_kit') }}" defer></script>
    {% endif %}
{% endblock %}
