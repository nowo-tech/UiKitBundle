{#
  UiKit 2.26 demo: the shared avatar partial. A picture goes over the initials, which hide only once it has loaded
  (js/nowo-ui-avatar.js, in the default scripts); a broken URL falls back to the initials; URLs the policy rejects
  render the initials only. The user menu shows the same picture through avatar_src.
#}
{% extends 'kit/_showcase.html.twig' %}
{% set nowo_ui_document_title = 'Avatars · UiKit 2.26' %}

{% block body %}
    <div id="main-content" data-testid="kit-avatars-main">
        <h2>People</h2>
        <ul class="nowo-ui-list-plain nowo-ui-stack-sm" data-testid="kit-people">
            {% for person in people %}
                <li class="nowo-ui-inline">
                    {{ include('@NowoUiKitBundle/partials/_avatar.html.twig', {
                        name: person.name,
                        src: person.src,
                        size: 'sm',
                        decorative: true,
                        attr: {'data-testid': person.testid},
                    }, with_context = false) }}
                    <span>{{ person.name }}</span>
                </li>
            {% endfor %}
        </ul>
        <h2>Sizes, labelled (no name printed next to them)</h2>
        <p class="nowo-ui-inline" data-testid="kit-avatar-sizes">
            {% for size in ['xs', 'sm', null, 'lg'] %}
                {{ include('@NowoUiKitBundle/partials/_avatar.html.twig', {
                    name: 'Ada Lovelace',
                    src: picture,
                    size: size,
                    attr: {'data-testid': 'avatar-size-' ~ (size ?? 'default')},
                }, with_context = false) }}
            {% endfor %}
            {{ include('@NowoUiKitBundle/partials/_avatar.html.twig', {
                name: 'Grace Hopper',
                src: '/does-not-exist.webp',
                attr: {'data-testid': 'avatar-broken-labelled'},
            }, with_context = false) }}
        </p>
        <h2>User menu</h2>
        {{ include('@NowoUiKitBundle/partials/_user_menu.html.twig', {name: 'Ada Lovelace', email: 'ada@example.com', avatar_src: picture, links: [{label: 'App shell', href: path('kit_shell')}]}, false) }}
    </div>
{% endblock %}
