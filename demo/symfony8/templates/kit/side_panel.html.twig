{#
  UiKit 2.25 demo: the side panel / drawer (partials side_panel, side_panel_toggle, side_panel_container and
  js/nowo-ui-side-panel.js). A comments panel at the end side (an inline column on desktop, a full-height drawer at
  <= 767 px) with a count badge and the Alt+Shift+C shortcut, and an overlay "Outline" panel at the start side. The
  toggles and the close link point to ?panel=1 / ?panel=0, so the page also works without JavaScript.
#}
{% extends '@NowoUiKit/layout/document.html.twig' %}
{% set nowo_ui_document_title = 'Side panel · UiKit 2.25' %}

{% block nowo_ui_body %}
    <main id="main-content" class="nowo-ui-content" data-testid="side-panel-demo">
        <div class="kit-side-panel-bar">
            <h1>Release notes 2.25</h1>
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', {compact: true}) }}
            {{ include('@NowoUiKitBundle/partials/_side_panel_toggle.html.twig', {
                target: 'demo-outline',
                label: 'Outline',
                attr: {'data-testid': 'outline-toggle'},
            }, false) }}
            {{ include('@NowoUiKitBundle/partials/_side_panel_toggle.html.twig', {
                target: 'demo-comments',
                label: 'Comments',
                open: open,
                href: path('kit_side_panel', {panel: open ? 0 : 1}),
                icon: 'tabler:message-circle',
                count: 3,
                count_suffix: 'open',
                shortcut: 'Alt+Shift+C',
                attr: {'data-testid': 'comments-toggle'},
            }, false) }}
        </div>
        {% embed '@NowoUiKitBundle/partials/_side_panel_container.html.twig' with {open: open} %}
            {% block nowo_ui_side_panel_main %}
                <article data-testid="side-panel-content">
                    <p>The side panel holds secondary content beside the page: comments, details, an outline. On wide
                        screens it is a column and the page stays usable; on phones it becomes a full-height drawer.</p>
                    <p><a href="#main-content" data-testid="content-link">A link in the content</a></p>
                    <button type="button" class="{{ nowo_ui_class('btn_secondary') }}" data-testid="content-button">A button in the content</button>
                </article>
            {% endblock %}
            {% block nowo_ui_side_panel_panel %}
                {% embed '@NowoUiKitBundle/partials/_side_panel.html.twig' with {
                    id: 'demo-comments',
                    title: 'Comments',
                    open: open,
                    close_href: path('kit_side_panel', {panel: 0}),
                    attr: {'data-testid': 'comments-panel'},
                } only %}
                    {% block nowo_ui_side_panel_body %}
                        <ul class="kit-side-panel-threads">
                            <li><button type="button" class="{{ nowo_ui_class('btn_secondary') }}" data-testid="thread-1">Ana: is this still true?</button></li>
                            <li><button type="button" class="{{ nowo_ui_class('btn_secondary') }}">Bo: typo in the second line</button></li>
                            <li><button type="button" class="{{ nowo_ui_class('btn_secondary') }}">Cy: approved</button></li>
                        </ul>
                        <button type="button" class="{{ nowo_ui_class('btn_primary') }}" data-testid="reply">Reply</button>
                    {% endblock %}
                {% endembed %}
            {% endblock %}
        {% endembed %}
        {% embed '@NowoUiKitBundle/partials/_side_panel.html.twig' with {id: 'demo-outline', title: 'Outline', side: 'start', layout: 'overlay', attr: {'data-testid': 'outline-panel'}} only %}
            {% block nowo_ui_side_panel_body %}
                <ol><li><a href="#main-content">Release notes 2.25</a></li></ol>
            {% endblock %}
        {% endembed %}
    </main>
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('js/nowo-ui-side-panel.js', 'nowo_ui_kit') }}" defer></script>
{% endblock %}
