{#
  UiKit demo (2.41 phone mode): the page-edge tabs launcher (partial edge_tabs_launcher + js/nowo-ui-edge-tabs.js), selects
  (kit geometry vs a host select with a fixed height, which WebKit cut before), a responsive table with phone cards and one
  whose required columns overflow (it scrolls), a `table` with Column::phone, badges and tabs (touch targets). 2.42: a
  listing (listing_head / listing_cells) with ListingField::phone in phone cards, a drawer whose edge tab never folds. The meta
  tag repeats the CSP of the response.
#}
{% extends '@NowoUiKit/layout/document.html.twig' %}
{% set nowo_ui_document_title = 'Phone mode · UiKit' %}

{% block nowo_ui_head %}
    <meta http-equiv="Content-Security-Policy" content="style-src-attr 'none'; script-src-attr 'none'">
{% endblock %}

{% block nowo_ui_body %}
    <header class="kit-mobile-header" data-testid="mobile-header"><strong>UiKit</strong> phone mode</header>
    <main id="main-content" class="nowo-ui-main nowo-ui-content kit-mobile-main" data-testid="mobile-main">
        <h1>Phone mode</h1>
        <p class="kit-mobile-lede" data-testid="lede">This line runs to the right edge of the content, where the page-edge tabs used to sit over it on a phone.</p>

        <nav class="nowo-ui-tabs" aria-label="Sections" data-testid="tabs">
            <a class="nowo-ui-tabs__item is-active" href="#users" aria-current="page">Users</a>
            <a class="nowo-ui-tabs__item" href="#invites">Invitations</a>
        </nav>
        <p>Badges: <span class="nowo-ui-badge" data-testid="badge">Admin</span> <span class="nowo-ui-badge kit-mobile-tiny-badge" data-testid="tiny-badge">10px host</span></p>

        <h2>Selects</h2>
        <div class="kit-mobile-selects" data-testid="selects">
            {# twig-005-ignore: demo controls for the select geometry e2e (MUX-40) #}
            <label>Kit input <select class="nowo-ui-input nowo-ui-input--full" data-testid="select-kit"><option>Cualquier estado</option><option>Activo</option></select></label>
            {# twig-005-ignore #}
            <label>Host select with .nowo-ui-select <select class="nowo-ui-select kit-mobile-host" data-testid="select-opt-in"><option>Cualquier rol</option><option>Admin</option></select></label>
            {# twig-005-ignore #}
            <label>Host geometry only (fixed height, native appearance) <select class="kit-mobile-legacy" data-testid="select-legacy"><option>Cualquier actividad</option></select></label>
            {# twig-005-ignore #}
            <label>Per page <select class="nowo-ui-pagination__select" data-testid="select-pager"><option>25 por página</option><option>50 por página</option></select></label>
        </div>

        <h2>Users (responsive table, phone cards)</h2>
        <div class="nowo-ui-card">
            {% embed '@NowoUiKitBundle/partials/_responsive_table.html.twig' with {phone_layout: 'cards', dialog_id: 'rt-cards', attr: {'data-testid': 'rt-cards'}} only %}
                {% block table %}
                    <table class="nowo-ui-table" data-responsive-table-target="table">
                        <thead><tr>
                            <th data-column="name" data-required="1" data-nowo-ui-phone="primary">User</th>
                            <th data-column="email" data-nowo-ui-phone="meta">Email</th>
                            <th data-column="role">Role</th>
                            <th data-column="status">Status</th>
                            <th data-column="id" data-nowo-ui-phone="hide">Id</th>
                            <th data-column="actions" data-required="1">Actions</th>
                            {% include '@NowoUiKitBundle/partials/_row_detail_head.html.twig' only %}
                        </tr></thead>
                        <tbody>
                        {% for user in [{name: 'Demo Admin', email: 'admin@example.test', role: 'Administrator', status: 'Active', id: 1}, {name: 'Ada Lovelace', email: 'ada@example.test', role: 'Manager', status: 'Invited', id: 2}] %}
                            <tr>
                                <td data-column="name">{{ user.name }}</td>
                                <td data-column="email">{{ user.email }}</td>
                                <td data-column="role"><span class="nowo-ui-badge">{{ user.role }}</span></td>
                                <td data-column="status">{{ user.status }}</td>
                                <td data-column="id">{{ user.id }}</td>
                                <td data-column="actions"><a class="nowo-ui-btn nowo-ui-btn--sm" href="#activity">Activity</a> <a class="nowo-ui-btn nowo-ui-btn--sm" href="#export">Export data</a></td>
                                {% include '@NowoUiKitBundle/partials/_row_detail_cell.html.twig' only %}
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endblock %}
            {% endembed %}
        </div>

        <h2>Users (responsive table, no phone layout)</h2>
        <div class="nowo-ui-card">
            {% embed '@NowoUiKitBundle/partials/_responsive_table.html.twig' with {dialog_id: 'rt-scroll', attr: {'data-testid': 'rt-scroll'}} only %}
                {% block table %}
                    <table class="nowo-ui-table" data-responsive-table-target="table">
                        <thead><tr>
                            <th data-column="name" data-required="1">Usuario (email)</th>
                            <th data-column="role">Rol de plataforma</th>
                            <th data-column="actions" data-required="1">Acciones</th>
                            {% include '@NowoUiKitBundle/partials/_row_detail_head.html.twig' only %}
                        </tr></thead>
                        <tbody>
                            <tr>
                                <td data-column="name" data-testid="rt-scroll-name">demo.administrator@example-organization.test</td>
                                <td data-column="role">Administrator</td>
                                <td data-column="actions" class="kit-mobile-nowrap"><a class="nowo-ui-btn nowo-ui-btn--sm" href="#activity">Actividad</a> <a class="nowo-ui-btn nowo-ui-btn--sm" href="#export">Exportar datos</a> <a class="nowo-ui-btn nowo-ui-btn--sm" href="#sessions">Sesiones</a> <a class="nowo-ui-btn nowo-ui-btn--sm" href="#reset">Restablecer</a></td>
                                {% include '@NowoUiKitBundle/partials/_row_detail_cell.html.twig' only %}
                            </tr>
                        </tbody>
                    </table>
                {% endblock %}
            {% endembed %}
        </div>

        <h2>Users (listing partials, ListingField::phone)</h2>
        <div class="nowo-ui-card">
            {% embed '@NowoUiKitBundle/partials/_responsive_table.html.twig' with {phone_layout: 'cards', dialog_id: 'rt-listing', attr: {'data-testid': 'rt-listing'}, users: users, users_listing: users_listing} only %}
                {% block table %}
                    <table class="nowo-ui-table" data-responsive-table-target="table">
                        <thead><tr>{% include nowo_ui_partial('listing_head') with {listing_layout: users_listing} only %}</tr></thead>
                        <tbody>
                        {% for row in users %}
                            <tr>{% include nowo_ui_partial('listing_cells') with {listing_layout: users_listing, cells_template: 'kit/_mobile_listing_cells.html.twig'} %}</tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endblock %}
            {% endembed %}
        </div>

        <h2>Users (table partial, Column::phone)</h2>
        <div data-testid="column-phone">
            {{ include(nowo_ui_partial('table'), {table: users_table}, false) }}
        </div>
    </main>

    {{ include('@NowoUiKitBundle/partials/_edge_tab.html.twig', {href: '#manual', label: 'Manual', slot: 0, new_tab: false, testid: 'edge-manual'}, false) }}
    {{ include('@NowoUiKitBundle/partials/_edge_tab.html.twig', {href: '#notes', label: 'Technical notes', icon: 'view', slot: 1, new_tab: false, testid: 'edge-notes'}, false) }}
    {{ include('@NowoUiKitBundle/partials/_edge_tab.html.twig', {label: 'Tour this page', icon: 'tour', slot: 2, button: true, testid: 'edge-tour'}, false) }}
    {{ include('@NowoUiKitBundle/partials/_edge_tab.html.twig', {href: '#preferences', label: 'Preferences', icon: 'config', slot: 3, new_tab: false, testid: 'edge-prefs'}, false) }}
    {{ include('@NowoUiKitBundle/partials/_edge_tab.html.twig', {label: 'Customize the listing', icon: 'filter', slot: 4, button: true, testid: 'edge-customizer', attr: {'data-nowo-ui-dialog-open': 'mobile-customizer'}}, false) }}
    {# 2.42 (MUX-01): like Beacon's drawers, the tab rides on the drawer's edge and is its only close control; while the
       drawer is open it has aria-expanded="true", so the launcher never folds it. #}
    <aside class="kit-mobile-drawer" id="kit-mobile-drawer" data-testid="drawer" aria-label="Developer notes">
        {{ include('@NowoUiKitBundle/partials/_edge_tab.html.twig', {label: 'Developer notes', icon: 'view', slot: 5, button: true, testid: 'edge-drawer', attr: {'aria-expanded': 'false', 'aria-controls': 'kit-mobile-drawer'}}, false) }}
        <div class="kit-mobile-drawer__body" data-testid="drawer-body"><h2>Developer notes</h2><p><a href="#notes-link">A link inside the drawer</a></p></div>
    </aside>
    {{ include(nowo_ui_partial('edge_tabs_launcher'), {gutter: true, icon: 'chevron', testid: 'edge-launcher'}, false) }}
    {{ include(nowo_ui_partial('dialog'), {id: 'mobile-customizer', title: 'Customize the listing', body: '<p data-testid="customizer-body">Columns, filters and rows per page.</p>'}, false) }}
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/mobile-demo.css') }}">
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('js/nowo-ui-edge-tabs.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/demo-peers.js') }}" defer></script>
    <script src="{{ asset('js/mobile-drawer-demo.js') }}" defer></script>
{% endblock %}
