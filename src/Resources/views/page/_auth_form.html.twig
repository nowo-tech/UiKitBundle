{#
  Form functions of page/auth.html.twig (2.3), in their own file so the auth scaffold compiles without symfony/form
  (form_start / form_theme exist only with the Form extension; this file is included only when page.form is set).

  Required:
    - part: start | fields | end
    - page: View\AuthPage, form: its FormView
  Optional:
    - bundle, nowo_ui_page_type

  start: page.formThemes (form_theme), form_start (slot `form` + page.formAttributes; `class` appended) and the
  root form errors (CSRF, global errors) in the `form_errors` slot (role="alert"; nothing without errors).
  fields: REQ-TWIG-003 child loop. end: form_end.
#}
{% set _b = bundle|default(null) %}
{% set _pt = nowo_ui_page_type|default(null) %}
{% if part == 'start' %}
    {% if page.formThemes is not empty %}
        {% form_theme form with page.formThemes %}
    {% endif %}
    {% set _fa = page.formAttributes|filter(v => v is not null) %}
    {% set _class = (nowo_ui_class('form', _b) ~ ' ' ~ (_fa.class ?? ''))|trim %}
    {{ form_start(form, {attr: {class: _class, 'data-nowo-ui-region': 'form'}|merge(nowo_ui_theme.attributesFor('form', _b, {}, _pt))|merge(_fa|filter((v, k) => k != 'class'))}) }}
    {% if form.vars.errors|length > 0 %}
        <div class="{{ nowo_ui_class('form_errors', _b) }}" role="alert" data-nowo-ui-region="form-errors"{{ nowo_ui_attrs('form_errors', _b) }}>{{ form_errors(form) }}</div>
    {% endif %}
{% elseif part == 'fields' %}
    {% for child in form %}
        {% if not child.rendered %}
            {{ form_row(child) }}
        {% endif %}
    {% endfor %}
{% elseif part == 'end' %}
    {{ form_end(form) }}
{% endif %}
