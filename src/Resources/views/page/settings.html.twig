{#
  REQ-UI-003 settings scaffold. Variable: page (View\SettingsPage).

  Regions: page header, section tabs (sections with hrefs; level secondary — slot tabs_secondary, pills — when the
  page header has an area nav, 2.2), one card + form per visible section (section.actions after the submit, 2.2).
  Data block: nowo_ui_settings_section (`section` in context; default: the section's form with the REQ-TWIG-003
  child loop and a submit button). section.formThemes (2.1): form_theme applied to section.form before the block.
#}
{% extends page.layout ?? nowo_ui_layout.admin %}
{% set nowo_ui_bundle = page.bundle %}
{% set nowo_ui_page_type = 'settings' %}

{% block nowo_ui_document_title %}{{ page.header.title|nowo_ui_trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {% import '@NowoUiKitBundle/page/_scaffold.html.twig' as scaffold %}
    {{ scaffold.page_header(page, nowo_ui_page_type) }}
{% endblock %}

{% block nowo_ui_content %}
    {% set _b = page.bundle %}
    <div class="nowo-ui-settings-page" data-nowo-ui-page="settings"{{ nowo_ui_html_attrs(page.attributes) }}>
        {% if page.hasTabs() %}
            {% set _tabs = [] %}
            {% for section in page.sections %}
                {% set _tabs = _tabs|merge([{label: section.label|nowo_ui_trans, href: section.href, current: section.id == page.current}]) %}
            {% endfor %}
            {{ include(nowo_ui_partial('tabs', _b), {items: _tabs, region: 'tabs', level: page.header.tabs and not page.header.tabs.isEmpty() ? 'secondary' : 'primary', bundle: _b, nowo_ui_page_type: nowo_ui_page_type}, false) }}
        {% endif %}
        {% for section in page.visibleSections() %}
            <section class="{{ nowo_ui_class('section', _b) }} {{ nowo_ui_class('card', _b) }}" id="nowo-ui-settings-{{ section.id }}" data-nowo-ui-region="section"{{ nowo_ui_attrs('section', _b) }}>
                <header class="{{ nowo_ui_class('card_header', _b) }}">
                    <div class="nowo-ui-card__heading">
                        <h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ section.label|nowo_ui_trans }}</h2>
                        {% if section.intro %}<p class="{{ nowo_ui_class('card_intro', _b) }}">{{ section.intro|nowo_ui_trans }}</p>{% endif %}
                    </div>
                </header>
                <div class="{{ nowo_ui_class('card_body', _b) }}">
                    {% if section.form and section.formThemes is not empty %}
                        {% form_theme section.form with section.formThemes %}
                    {% endif %}
                    {% block nowo_ui_settings_section %}
                        {% if section.form %}
                            {{ include(nowo_ui_partial('section_form', _b), {form: section.form, submit_label: section.submitLabel, actions: section.actions, bundle: _b, nowo_ui_page_type: nowo_ui_page_type}, false) }}
                        {% endif %}
                    {% endblock %}
                </div>
            </section>
        {% endfor %}
    </div>
{% endblock %}
