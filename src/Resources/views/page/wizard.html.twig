{#
  REQ-UI-003 wizard scaffold. Variable: page (View\WizardPage).

  Regions: steps indicator (done / current / upcoming), the current step's form, back / next.
  Data block: nowo_ui_wizard_step (`step` = current View\WizardStep in context; default: page.form with the
  REQ-TWIG-003 child loop, back link and next button).
#}
{#- page.guest (2.2): the guest layout (setup / restore wizards before sign-in); page.layout wins -#}
{% extends page.layout ?? (page.guest ? nowo_ui_layout.guest : nowo_ui_layout.admin) %}
{% set nowo_ui_bundle = page.bundle %}
{% set nowo_ui_page_type = 'wizard' %}

{% block nowo_ui_document_title %}{{ page.header.title|nowo_ui_trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {% import '@NowoUiKitBundle/page/_scaffold.html.twig' as scaffold %}
    {{ scaffold.page_header(page, nowo_ui_page_type) }}
{% endblock %}

{% block nowo_ui_content %}
    {% set _b = page.bundle %}
    {% set step = page.steps[page.currentIndex()] %}
    <div class="nowo-ui-wizard-page" data-nowo-ui-page="wizard"{{ nowo_ui_html_attrs(page.attributes) }}>
        <ol class="{{ nowo_ui_class('wizard_steps', _b) }}" aria-label="{{ 'wizard.steps'|trans({}, 'NowoUiKitBundle') }}" data-nowo-ui-region="steps"{{ nowo_ui_attrs('wizard_steps', _b) }}>
            {% for s in page.steps %}
                {% set _status = page.status(s) %}
                <li class="{{ nowo_ui_class(_status == 'current' ? 'wizard_step_active' : 'wizard_step', _b) }} nowo-ui-wizard-steps__item--{{ _status }}"{% if _status == 'current' %} aria-current="step"{% endif %}>
                    {%- if s.href and _status == 'done' -%}
                        <a href="{{ s.href }}">{{ s.label|nowo_ui_trans }}</a>
                    {%- else -%}
                        <span>{{ s.label|nowo_ui_trans }}</span>
                    {%- endif -%}
                </li>
            {% endfor %}
        </ol>
        <p class="nowo-ui-wizard-page__progress">{{ 'wizard.step_of'|trans({'%current%': page.currentIndex() + 1, '%total%': page.steps|length}, 'NowoUiKitBundle') }}</p>
        <section class="{{ nowo_ui_class('card', _b) }}" data-nowo-ui-region="step">
            <div class="{{ nowo_ui_class('card_body', _b) }}">
                {% block nowo_ui_wizard_step %}
                    {% if page.form %}
                        {{ include(nowo_ui_partial('wizard_form', _b), {page: page, bundle: _b, nowo_ui_page_type: nowo_ui_page_type}, false) }}
                    {% endif %}
                {% endblock %}
            </div>
        </section>
    </div>
{% endblock %}
