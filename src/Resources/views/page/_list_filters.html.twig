{#
  Filters region of page/list.html.twig (theme partial `list_filters`; separate file: form_start / form_end need
  symfony/form). REQ-TWIG-003 child loop; apply / clear chrome outside the loop.

  Required:
    - page: View\ListPage (page.filters: FormView)
  Optional:
    - region (data-nowo-ui-region, default filters), bundle (default page.bundle), nowo_ui_page_type
    - header_actions: page-header actions rendered last in the actions row (list scaffold, headerActionsInFilters)

  Per field (page.filterFields[child name], View\FilterField): placeholder (a Label is translated exactly once in its
  domain, a string printed as given — 2.3), widget class / attributes,
  row class / attributes and width (`nowo-ui-filters__field--<width>`); every row gets the `filters_field` slot.
  2.2: text-like widgets get the `input` slot classes (choice widgets its semantic + host classes only: the form
  theme gives them their framework select class); checkboxes / radios keep the form theme's. An optional,
  single, collapsed choice without a placeholder of its own shows "Any" (filters.any) as its empty option.
  The fields sit on a responsive grid (nowo-ui.css), the actions bottom-aligned right after the last field.
  Actions (slot `filters_actions`): the apply button (page.filtersSubmit: label, icon through the icon partial,
  variant; default `filters.apply`, btn_primary), the clear link (page.filtersClear through the `action` partial, or a
  plain link to page.filtersClearHref) and page.filterActions (through the `action` partial). page.filtersDisplay
  (icon | text | icon_text) sets the display of these buttons unless their Action has one; icon-only buttons keep a
  visually-hidden label + aria-label and get the `btn_icon` slot.

  2.30 host options (`nowo_ui_kit.theme.pages.list.filters`, Theme\ListFiltersOptions; unset = the 2.29 output):
    - display: default of page.filtersDisplay (set, the plain clear link follows the display too)
    - submit_icon / clear_icon: icons of the apply button / plain clear link (default filter / filter_off)
    - submit_class / clear_class: host classes replacing the btn_<variant> slot classes of the apply / clear buttons
    - grid: auto-fit | auto-fill (modifier class nowo-ui-filters--grid-auto-fill) | a track list (the
      --nowo-ui-filters-grid-columns token printed by nowo_ui_tokens(); no inline style); page.filtersGrid wins
    - fold: {enabled, cookie, cookie_path, icons, testids, morph} — the partials/_filters_collapse.html.twig toggle as
      the first child of the form (aria-controls = the form id; Stimulus peer filters-collapse; without JS the card
      stays open); page.filtersFold / page.filtersFoldKey win
#}
{% set _b = bundle|default(page.bundle) %}
{% set _pt = nowo_ui_page_type|default(null) %}
{% set _field_class = nowo_ui_class('filters_field', _b) %}
{% set _opts = nowo_ui_theme.listFilters() %}
{% set _display = page.filtersDisplay ?? _opts.display %}
{% set _fold = page.filtersFold ?? _opts.foldEnabled %}
{% set _grid_class = _opts.gridClass(page.filtersGrid) %}
{% set _form_attr = {class: nowo_ui_class('filters', _b) ~ (_grid_class ? ' ' ~ _grid_class), role: 'search', 'data-nowo-ui-filters': '', 'data-nowo-ui-region': region|default('filters')}|merge(nowo_ui_theme.attributesFor('filters', _b, {}, _pt)) %}
{% if _fold and _form_attr.id is not defined %}
    {% set _form_attr = _form_attr|merge({id: 'nowo-ui-filters-' ~ (page.filters.vars.id is not empty ? page.filters.vars.id : 'list')}) %}
{% endif %}
{{ form_start(page.filters, {attr: _form_attr}) }}
    {%~ if _fold %}
        {{ include('@NowoUiKitBundle/partials/_filters_collapse.html.twig', _opts.foldVariables()|merge({fold_key: page.filtersFoldKey, filter_form: page.filters, controls: _form_attr.id}), false) }}
    {%~ endif %}
    {% for child in page.filters %}
        {% if not child.rendered %}
            {% set _field = page.filterFields[child.vars.name] ?? null %}
            {% set _attr = child.vars.attr %}
            {% set _row_attr = child.vars.row_attr %}
            {% set _row_class = [_row_attr.class ?? null, _field_class] %}
            {% set _prefixes = child.vars.block_prefixes %}
            {% set _choice = 'choice' in _prefixes %}
            {% set _row_vars = {} %}
            {% if 'checkbox' not in _prefixes and 'radio' not in _prefixes and not (_choice and child.vars.expanded) and 'hidden' not in _prefixes %}
                {% set _input_class = _choice ? ('nowo-ui-input ' ~ nowo_ui_theme.extraClasses('input', _b, _pt))|trim : nowo_ui_class('input', _b) %}
                {% set _attr = _attr|merge({class: ((_attr.class ?? '') ~ ' ' ~ _input_class)|trim}) %}
            {% endif %}
            {# 2.3: texts the form theme translates again (attr.placeholder, the choice placeholder) are handed over
               untranslated (|nowo_ui_translatable: translated once, in their own domain) or, for a field rendered
               with translation_domain false, already translated — never twice #}
            {% set _pretranslated = child.vars.translation_domain is same as(false) or child.vars.attr_translation_parameters|default([]) is not empty %}
            {% if _choice and not child.vars.multiple and not child.vars.expanded and not child.vars.required and child.vars.placeholder is same as('') %}
                {% set _any = {key: 'filters.any', domain: 'NowoUiKitBundle'} %}
                {% set _row_vars = {placeholder: child.vars.translation_domain is same as(false) ? _any|nowo_ui_trans : _any|nowo_ui_translatable} %}
            {% endif %}
            {% if _field %}
                {% set _attr = _attr|merge(_field.attributes) %}
                {% if _field.placeholder is not null %}
                    {% set _attr = _attr|merge({placeholder: _pretranslated ? _field.placeholder|nowo_ui_trans : _field.placeholder|nowo_ui_translatable}) %}
                {% endif %}
                {% if _field.class %}
                    {% set _attr = _attr|merge({class: ((_attr.class ?? '') ~ ' ' ~ _field.class)|trim}) %}
                {% endif %}
                {% set _row_attr = _row_attr|merge(_field.rowAttributes) %}
                {% set _row_class = _row_class|merge([_field.width ? 'nowo-ui-filters__field--' ~ _field.width : null, _field.rowClass]) %}
            {% endif %}
            {{ form_row(child, _row_vars|merge({attr: _attr, row_attr: _row_attr|merge({class: _row_class|filter(c => c)|join(' ')})})) }}
        {% endif %}
    {% endfor %}
    <div class="{{ nowo_ui_class('filters_actions', _b) }}"{{ nowo_ui_attrs('filters_actions', _b) }}>
        {% set _submit = page.filtersSubmit %}
        {% set _submit_label = _submit and _submit.label is not null ? _submit.label|nowo_ui_trans : 'filters.apply'|trans({}, 'NowoUiKitBundle') %}
        {% set _submit_display = _submit and _submit.display ? _submit.display : (_display ?? (_submit and _submit.icon ? 'icon_text' : 'text')) %}
        {% if nowo_ui_kit_icon_set|default('bootstrap-icons') == 'none' %}
            {% set _submit_display = 'text' %}
        {% endif %}
        {% set _submit_attrs = (_submit ? _submit.attributes : {})|merge(_submit_display == 'icon' ? {title: _submit_label, 'aria-label': _submit_label} : {}) %}
        {%~ set _submit_icon = _submit and _submit.icon ? _submit.icon : (_opts.submitIcon ?? 'filter') %}
        <button type="submit" class="{{ _opts.submitClass ?? nowo_ui_class('btn_' ~ (_submit and _submit.variant in ['primary', 'secondary', 'danger', 'neutral'] ? (_submit.variant == 'neutral' ? 'secondary' : _submit.variant) : nowo_ui_kit_action_variants.filter|default('primary')), _b) }} nowo-ui-filters__submit{{ _submit_display == 'icon' ? ' ' ~ nowo_ui_class('btn_icon', _b) }}"{{ nowo_ui_html_attrs(_submit_attrs) }}>
            {%- if _submit_display == 'icon' -%}
                {{ include('@NowoUiKitBundle/components/_icon.html.twig', {name: _submit_icon, label: _submit_label}, false)|trim|raw }}
                <span class="visually-hidden">{{ _submit_label }}</span>
            {%- elseif _submit_display == 'icon_text' -%}
                {{ include('@NowoUiKitBundle/components/_icon.html.twig', {name: _submit_icon, label: _submit_label}, false)|trim|raw }}
                <span class="nowo-ui-action__label">{{ _submit_label }}</span>
            {%- else -%}
                {{ _submit_label }}
            {%- endif -%}
        </button>
        {% if page.filtersClear %}
            {{ include(nowo_ui_partial('action', _b), {action: page.filtersClear, context: 'toolbar', display: _display, bundle: _b, nowo_ui_page_type: _pt}|merge(_opts.clearClass is null ? {} : {toolbar_class: _opts.clearClass}), false) }}
        {% elseif page.filtersClearHref %}
            {%~ set _clear_label = 'filters.clear'|trans({}, 'NowoUiKitBundle') %}
            {%~ set _clear_display = _opts.display is null or nowo_ui_kit_icon_set|default('bootstrap-icons') == 'none' ? 'text' : _display %}
            <a class="{{ _opts.clearClass ?? nowo_ui_class('btn_secondary', _b) }}{{ _clear_display == 'icon' ? ' ' ~ nowo_ui_class('btn_icon', _b) }}" href="{{ page.filtersClearHref }}"{% if _clear_display == 'icon' %} title="{{ _clear_label }}" aria-label="{{ _clear_label }}"{% endif %}>
                {%- if _clear_display != 'text' -%}
                    {{ include('@NowoUiKitBundle/components/_icon.html.twig', {name: _opts.clearIcon ?? 'filter_off', label: _clear_label}, false)|trim|raw }}
                    <span class="{{ _clear_display == 'icon' ? 'visually-hidden' : 'nowo-ui-action__label' }}">{{ _clear_label }}</span>
                {%- else -%}
                    {{ _clear_label }}
                {%- endif -%}
            </a>
        {% endif %}
        {% for action in page.filterActions %}
            {{ include(nowo_ui_partial('action', _b), {action: action, context: 'toolbar', display: _display, bundle: _b, nowo_ui_page_type: _pt}, false) }}
        {% endfor %}
        {% if header_actions|default([]) is not empty %}
            <div class="nowo-ui-filters__header-actions" data-nowo-ui-region="header-actions">
                {% for action in header_actions %}
                    {{ include(nowo_ui_partial('action', _b), {action: action, context: 'toolbar', bundle: _b, nowo_ui_page_type: _pt}, false) }}
                {% endfor %}
            </div>
        {% endif %}
    </div>
{{ form_end(page.filters) }}
