{#
  REQ-UI-003 list scaffold. Variable: page (View\ListPage).

  Regions: page header + actions, filters (FormView), table frame, row actions, pagination, empty state, confirm
  dialogs (from row actions with a Confirm; ids scoped per row, one dialog per id: ListPage::confirmDialogs()).
  Header actions: in the page header, or at the end of the filter row when nowo_ui_header_actions_in_filters
  (ListPage::headerActionsInFilters ?? theme.pages.list.header_actions_in_filters, only with filters) — an override
  of nowo_ui_list_filters then renders page.header.actions itself.
  Data blocks: nowo_ui_list_filters (the filters region; default: the `list_filters` partial), nowo_ui_list_head
  (header cells), nowo_ui_list_row (row cells; `row`, `row_key`, `loop` in context), nowo_ui_list_after (after the
  list). Default cells print row[column.key] for each page.columns.
  Responsive (page.responsive = cards, default): the table wrap is a size container; below 40rem the rows render as
  labelled cards (cells need data-label — the default cells print the column label; overridden cells add it), and
  columns with Column::priority 2 / 3 hide below 48rem / 60rem. CSS only (no JS).
  Slots: table_wrap, table, table_head, table_head_row, table_head_cell, table_actions_head, table_row, table_cell,
  table_actions_cell (alignment of the actions column: page.actionsAlign → nowo-ui-cell--<align>), sortable_header +
  sort_link (sortable columns), table_cell_muted (default cells without a value print a muted "—"). Inside a bordered
  panel, add `nowo-ui-table-wrap--flush` to the table_wrap slot: card-mode rows then drop their own border.
#}
{% extends page.layout ?? nowo_ui_layout.admin %}
{% set nowo_ui_bundle = page.bundle %}
{% set nowo_ui_page_type = 'list' %}
{#- header actions at the end of the filter row (ListPage::headerActionsInFilters, else theme.pages.list option) -#}
{% set nowo_ui_header_actions_in_filters = page.filters is not null and page.header.actions is not empty and (page.headerActionsInFilters ?? nowo_ui_theme.listHeaderActionsInFilters()) %}

{% block nowo_ui_document_title %}{{ page.header.title|nowo_ui_trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {% import '@NowoUiKitBundle/page/_scaffold.html.twig' as scaffold %}
    {{ scaffold.page_header(page, nowo_ui_page_type, [], not nowo_ui_header_actions_in_filters) }}
{% endblock %}

{% block nowo_ui_content %}
    {% set _b = page.bundle %}
    <section class="nowo-ui-list-page" data-nowo-ui-page="list"{{ nowo_ui_html_attrs(page.attributes) }}>
        {% block nowo_ui_list_filters %}
            {% if page.filters %}
                {{ include(nowo_ui_partial('list_filters', _b), {page: page, region: 'filters', bundle: _b, nowo_ui_page_type: nowo_ui_page_type, header_actions: nowo_ui_header_actions_in_filters ? page.header.actions : []}, false) }}
            {% endif %}
        {% endblock %}
        {% if page.rows is not empty %}
            {% set _route = page.pagination and page.pagination.route ? page.pagination.route : (app is defined and app ? app.request.attributes.get('_route') : null) %}
            {% set _route_params = (app is defined and app ? app.request.attributes.get('_route_params') : {})|default({})|merge(app is defined and app ? app.request.query.all : {}) %}
            {% set _confirms = [] %}
            {% set _cards = page.responsive == 'cards' %}
            <div class="{{ nowo_ui_class('table_wrap', _b) }}" data-nowo-ui-region="table"{% if _cards %} data-nowo-ui-responsive="cards"{% endif %}{{ nowo_ui_attrs('table_wrap', _b) }}>
                <table class="{{ nowo_ui_class('table', _b) }}{{ _cards ? ' nowo-ui-table--cards' }}"{{ nowo_ui_attrs('table', _b) }}>
                    {% if page.caption %}<caption class="nowo-ui-table__caption">{{ page.caption|nowo_ui_trans }}</caption>{% endif %}
                    <thead class="{{ nowo_ui_class('table_head', _b) }}"{{ nowo_ui_attrs('table_head', _b) }}>
                        <tr class="{{ nowo_ui_class('table_head_row', _b) }}"{{ nowo_ui_attrs('table_head_row', _b) }}>
                            {% block nowo_ui_list_head %}
                                {% for column in page.columns %}
                                    {%- set _sortable = column.sortable and _route %}
                                    <th scope="col" class="{{ nowo_ui_class('table_head_cell', _b) }}{{ _sortable ? ' ' ~ nowo_ui_class('sortable_header', _b) }} nowo-ui-cell--{{ column.align }}{{ column.class ? ' ' ~ column.class }}"{% if column.required %} data-required="1"{% elseif column.priority and column.priority > 1 %} data-nowo-ui-priority="{{ column.priority }}"{% endif %}{% if page.sort == column.key %} aria-sort="{{ page.direction == 'asc' ? 'ascending' : 'descending' }}"{% endif %}{{ nowo_ui_attrs('table_head_cell', _b) }}>
                                        {%- set _label = column.label is null ? column.key : column.label|nowo_ui_trans -%}
                                        {%- if _sortable -%}
                                            <a class="{{ nowo_ui_class('sort_link', _b) }}{{ page.sort == column.key ? ' nowo-ui-sort--' ~ page.direction }}" href="{{ path(_route, _route_params|merge({sort: column.key, direction: page.nextDirection(column.key)})) }}"{{ nowo_ui_attrs('sort_link', _b) }}>{{ _label }}</a>
                                        {%- else -%}
                                            {{ _label }}
                                        {%- endif -%}
                                    </th>
                                {% endfor %}
                            {% endblock %}
                            {% if page.hasRowActions() %}
                                {% set _actions_label = page.actionsLabel is null ? 'table.actions'|trans({}, 'NowoUiKitBundle') : page.actionsLabel|nowo_ui_trans %}
                                <th scope="col" class="{{ nowo_ui_class('table_head_cell', _b) }} {{ nowo_ui_class('table_actions_head', _b) }} nowo-ui-cell--{{ page.actionsAlign }}"{{ nowo_ui_attrs('table_actions_head', _b) }}>
                                    {%- if page.actionsLabelVisible -%}
                                        {{ _actions_label }}
                                    {%- else -%}
                                        <span class="visually-hidden">{{ _actions_label }}</span>
                                    {%- endif -%}
                                </th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for row_key, row in page.rows %}
                            <tr class="{{ nowo_ui_class('table_row', _b) }}">
                                {% block nowo_ui_list_row %}
                                    {% for column in page.columns %}
                                        {%- set _value = row is iterable ? row[column.key]|default(null) : attribute(row, column.key) %}
                                        {%- set _blank = _value is null or _value is same as('') or _value is same as(false) %}
                                        <td class="{{ nowo_ui_class('table_cell', _b) }}{{ _blank ? ' ' ~ nowo_ui_class('table_cell_muted', _b) }} nowo-ui-cell--{{ column.align }}{{ column.class ? ' ' ~ column.class }}" data-label="{{ column.label is null ? column.key : column.label|nowo_ui_trans }}"{% if not column.required and column.priority and column.priority > 1 %} data-nowo-ui-priority="{{ column.priority }}"{% endif %}>{{ _blank ? '—' : _value }}</td>
                                    {% endfor %}
                                {% endblock %}
                                {% if page.hasRowActions() %}
                                    {#- 1.x hashes (label translated, href resolved, CSRF token) + the View\Action as `view`: the
                                        default partial renders the object, 1.x overrides read the hash; confirm
                                        dialogs render once after the table (confirm_external) -#}
                                    {% set _row_actions = [] %}
                                    {% for _action in page.rowActions(row, row_key) %}
                                        {% set _token = _action.form and _action.form._token is defined ? _action.form._token.vars : null %}
                                        {% set _row_actions = _row_actions|merge([_action.toArray()|merge({
                                            label: _action.label is null ? ('action.' ~ _action.kind)|trans({}, 'NowoUiKitBundle') : _action.label|nowo_ui_trans,
                                            href: _action.href ?? (_action.route ? path(_action.route, _action.params) : null),
                                            method: _action.isPost() ? 'POST' : 'GET',
                                            csrf_token: _token ? _token.value : _action.csrfToken,
                                            csrf_field: _token ? _token.full_name : _action.csrfField,
                                            view: _action,
                                        })]) %}
                                        {% if _action.confirm and _action.visible %}
                                            {% set _confirms = _confirms|merge([_action]) %}
                                        {% endif %}
                                    {% endfor %}
                                    <td class="{{ nowo_ui_class('table_cell', _b) }} {{ nowo_ui_class('table_actions_cell', _b) }} nowo-ui-cell--{{ page.actionsAlign }}"{{ nowo_ui_attrs('table_actions_cell', _b) }}>
                                        {{ include(nowo_ui_partial('row_actions', _b), {actions: _row_actions, confirm_external: true, bundle: _b, nowo_ui_page_type: nowo_ui_page_type}, false) }}
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if _confirms is not empty %}
                <div class="nowo-ui-list-page__confirms" data-nowo-ui-region="confirms">
                    {% for _action in page.confirmDialogs(_confirms) %}
                        {{ include(nowo_ui_partial('confirm', _b), {
                            id: _action.confirmId(),
                            confirm: _action.confirm,
                            action: _action,
                            action_href: _action.href ?? (_action.route ? path(_action.route, _action.params) : null),
                            bundle: _b,
                            nowo_ui_page_type: nowo_ui_page_type,
                        }, false) }}
                    {% endfor %}
                </div>
            {% endif %}
            {% if page.pagination %}
                {#- 1.x array shape (+ the object as pagination_model) and the 1.x top-level route / route_params / query
                    (query = the current request query without the page parameters, then Pagination::query), so an
                    untouched 1.x _pagination override keeps filters and sort across pages -#}
                {% set _pager = page.pagination %}
                {% set _request_query = app is defined and app ? app.request.query.all : {} %}
                {% set _pager_query = _request_query|filter((v, k) => k not in [_pager.pageParam, _pager.perPageParam])|merge(_pager.query) %}
                {{ include(nowo_ui_partial('pagination', _b), {
                    pagination: _pager.toArray(),
                    pagination_model: _pager,
                    item_count: page.rows|length,
                    route: _pager.route ?? (app is defined and app ? app.request.attributes.get('_route') : null),
                    route_params: _pager.routeParams ?? (app is defined and app ? app.request.attributes.get('_route_params')|default({}) : {}),
                    query: _pager_query,
                    page_param: _pager.pageParam,
                    per_page_param: _pager.perPageParam,
                    region: 'pagination',
                    bundle: _b,
                    nowo_ui_page_type: nowo_ui_page_type,
                }, false) }}
            {% endif %}
        {% else %}
            {% set _empty = page.empty ?? null %}
            {{ include(nowo_ui_partial('empty', _b), {empty: _empty, message: _empty and _empty.message is not null ? _empty.message|nowo_ui_trans : null, region: 'empty', bundle: _b, nowo_ui_page_type: nowo_ui_page_type}, false) }}
        {% endif %}
        {% block nowo_ui_list_after %}{% endblock %}
    </section>
{% endblock %}
