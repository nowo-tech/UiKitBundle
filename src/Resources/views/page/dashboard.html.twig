{#
  REQ-UI-003 dashboard scaffold. Variable: page (View\DashboardPage).

  Regions: page header, KPI tiles (page.kpis), cards grid.
  Data block: nowo_ui_dashboard_cards (cards inside the grid; use the `card` / `card_header` / `card_body` slots or
  partials/_card.html.twig).
#}
{% extends page.layout ?? nowo_ui_layout.admin %}
{% set nowo_ui_bundle = page.bundle %}
{% set nowo_ui_page_type = 'dashboard' %}

{% block nowo_ui_document_title %}{{ page.header.title|nowo_ui_trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header', page.bundle), {header: page.header, bundle: page.bundle, nowo_ui_page_type: nowo_ui_page_type}, false) }}
{% endblock %}

{% block nowo_ui_content %}
    {% set _b = page.bundle %}
    <div class="nowo-ui-dashboard-page" data-nowo-ui-page="dashboard">
        {% if page.kpis is not empty %}
            <div class="{{ nowo_ui_class('kpis', _b) }}"{{ nowo_ui_attrs('kpis', _b) }}>
                {% for kpi in page.kpis %}
                    <div class="{{ nowo_ui_class('kpi', _b) }} nowo-ui-kpi--{{ kpi.variant }}">
                        <p class="nowo-ui-kpi__label">{{ kpi.label|nowo_ui_trans }}</p>
                        <p class="nowo-ui-kpi__value">
                            {%- if kpi.href -%}<a href="{{ kpi.href }}">{{ kpi.value }}</a>{%- else -%}{{ kpi.value }}{%- endif -%}
                        </p>
                        {% if kpi.hint %}<p class="nowo-ui-kpi__hint">{{ kpi.hint|nowo_ui_trans }}</p>{% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
        <div class="{{ nowo_ui_class('cards', _b) }}"{{ nowo_ui_attrs('cards', _b) }}>
            {% block nowo_ui_dashboard_cards %}{% endblock %}
        </div>
    </div>
{% endblock %}
