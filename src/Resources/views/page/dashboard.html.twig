{#
  REQ-UI-003 dashboard scaffold. Variable: page (View\DashboardPage).

  Regions: page header, KPI tiles (page.kpis; slots kpis, kpi, kpi_label, kpi_value, kpi_hint; KpiTile::linkTile
  makes the whole tile the link, slot kpi_link on that <a> only), cards grid.
  Data block: nowo_ui_dashboard_cards (cards inside the grid; use the `card` / `card_header` / `card_body` slots or
  partials/_card.html.twig).
#}
{% extends page.layout ?? nowo_ui_layout.admin %}
{% set nowo_ui_bundle = page.bundle %}
{% set nowo_ui_page_type = 'dashboard' %}

{% block nowo_ui_document_title %}{{ page.header.title|nowo_ui_trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {% import '@NowoUiKitBundle/page/_scaffold.html.twig' as scaffold %}
    {{ scaffold.page_header(page, nowo_ui_page_type) }}
{% endblock %}

{% block nowo_ui_content %}
    {% set _b = page.bundle %}
    <div class="nowo-ui-dashboard-page" data-nowo-ui-page="dashboard"{{ nowo_ui_html_attrs(page.attributes) }}>
        {% if page.kpis is not empty %}
            <div class="{{ nowo_ui_class('kpis', _b) }}" data-nowo-ui-region="kpis"{{ nowo_ui_attrs('kpis', _b) }}>
                {% for kpi in page.kpis %}
                    {% set _tile_link = kpi.href and kpi.linkTile %}
                    <{{ _tile_link ? 'a' : 'div' }} class="{{ nowo_ui_class('kpi', _b) }} nowo-ui-kpi--{{ kpi.variant }}{{ _tile_link ? ' ' ~ nowo_ui_class('kpi_link', _b) }}"{% if _tile_link %} href="{{ kpi.href }}"{% endif %}{{ nowo_ui_attrs('kpi', _b) }}>
                        <p class="{{ nowo_ui_class('kpi_label', _b) }}">{{ kpi.label|nowo_ui_trans }}</p>
                        <p class="{{ nowo_ui_class('kpi_value', _b) }}">
                            {%- if kpi.href and not _tile_link -%}<a href="{{ kpi.href }}">{{ kpi.value }}</a>{%- else -%}{{ kpi.value }}{%- endif -%}
                        </p>
                        {% if kpi.hint %}<p class="{{ nowo_ui_class('kpi_hint', _b) }}">{{ kpi.hint|nowo_ui_trans }}</p>{% endif %}
                    </{{ _tile_link ? 'a' : 'div' }}>
                {% endfor %}
            </div>
        {% endif %}
        <div class="{{ nowo_ui_class('cards', _b) }}" data-nowo-ui-region="cards"{{ nowo_ui_attrs('cards', _b) }}>
            {% block nowo_ui_dashboard_cards %}{% endblock %}
        </div>
    </div>
{% endblock %}
