{#
  Public page-header contract (2.3) — what the scaffolds render in nowo_ui_page_header, for unique pages too:
      {% block nowo_ui_page_header %}{{ nowo_ui_page_header(header) }}{% endblock %}
      {{ include('@NowoUiKit/page/_page_header.html.twig', {header: header, bundle: 'AcmeFooBundle'}, false) }}
  Includes the `page_header` theme partial with both the 2.0 input (`header`, `actions`) and the 1.x input (`title`,
  `intro` translated, `toolbar` = the header actions + extra_actions pre-rendered through the `action` partial,
  `header_actions_rendered: true`), so host overrides written for either contract render the same header.

  Required:
    - header: View\PageHeader
  Optional:
    - bundle (default nowo_ui_bundle), nowo_ui_page_type (slot resolution; default the context's)
    - extra_actions: list of View\Action rendered after the header actions (FormPage secondary actions)
    - header_actions (default true): false leaves header.actions out of `actions` / `toolbar` and passes `header`
      without them (PageHeader::withActions([])) — the list scaffold renders them in the filter row
  2.21: with header.actionsLayout `split`, `toolbar` holds the `header_actions` partial (icon buttons, one primary, the
  square "more" menu; extra_actions included) instead of one button per action; `status_badge` holds the rendered
  `page_status` partial of header.status (null without; print it with |raw like `toolbar`), for host overrides.
  2.27, presentation (`standard` | `compact`; default nowo_ui_header_presentation(): the request attribute
  _nowo_ui_header_presentation, else nowo_ui_kit.header.presentation): compact passes `intro: null`, `presentation`
  and `title_hidden: true` to the partial (the title stays the page's h1, visually hidden; no breadcrumbs or back
  link: the top bar carries them), and with nowo_ui_kit.header.compact_actions `bar` it behaves as
  `header_actions: false` (extra_actions stay in the page).
#}
{% set _b = bundle|default(nowo_ui_bundle|default(null)) %}
{% set _pt = nowo_ui_page_type|default(null) %}
{% set _presentation = nowo_ui_header_presentation(presentation ?? null) %}
{% set _compact = _presentation == 'compact' %}
{% set _with_header_actions = (header_actions is defined ? header_actions : true) and not (_compact and nowo_ui_header.compactActions() == 'bar') %}
{% set _actions = (_with_header_actions ? header.actions : [])|merge(extra_actions|default([])) %}
{% set _split = _with_header_actions and header.actionsLayout is defined and header.actionsLayout == 'split' %}
{% set _toolbar -%}
    {%- if _split -%}
        {{ include(nowo_ui_partial('header_actions', _b), {actions: _actions, bundle: _b, nowo_ui_page_type: _pt}, false) }}
    {%- else -%}
    {%- for action in _actions -%}
        {{ include(nowo_ui_partial('action', _b), {action: action, context: 'toolbar', bundle: _b, nowo_ui_page_type: _pt}, false) }}
    {%- endfor -%}
    {%- endif -%}
{%- endset %}
{% set _status_badge = header.status is defined and header.status ? include(nowo_ui_partial('page_status', _b), {status: header.status, bundle: _b, nowo_ui_page_type: _pt}, false)|trim : null %}
{{ include(nowo_ui_partial('page_header', _b), {
    header: _with_header_actions ? header : header.withActions([]),
    actions: _actions,
    title: header.title|nowo_ui_trans,
    intro: _compact or header.intro is null ? null : header.intro|nowo_ui_trans,
    toolbar: _actions is empty ? null : _toolbar|trim,
    header_actions_rendered: true,
    status_badge: _status_badge,
    region: 'header',
    bundle: _b,
    nowo_ui_page_type: _pt,
    presentation: _presentation,
    title_hidden: _compact,
}, false) }}
