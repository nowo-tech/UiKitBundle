{#
  Icon by nowo_ui_kit_icon_set.

  Required:
    - name: canonical action kind or free string (ux_icon / fallback class)

  Canonical kinds (REQ-UI-001):
    edit, delete, view, copy, create, save, cancel, restore, share, config,
    export, filter, prev, next, close
  1.17 (chrome toggles): filter_off, scroll_horizontal, rows, chevron_up, chevron_down,
    chevron_right, book
  2.13: tour (guided tour tab)
  2.20: sort, sort_asc, sort_desc (sortable table headers: neutral / ascending / descending arrows)

  Optional:
    - label: accessible text (aria-hidden decorative when parent has aria-label)
#}
{% set icon_set = nowo_ui_kit_icon_set|default('bootstrap-icons') %}
{% set label = label|default(name) %}
{% if icon_set == 'none' %}
    <span class="nowo-ui-icon nowo-ui-icon--text">{{ label }}</span>
{% elseif icon_set == 'ux_icon' %}
    {# Deferred to a separate template: Twig resolves ux_icon() at compile time. #}
    {% set ux_map = {
        edit: 'bi:pencil',
        delete: 'bi:trash',
        view: 'bi:eye',
        copy: 'bi:clipboard',
        create: 'bi:plus-lg',
        save: 'bi:check-lg',
        cancel: 'bi:x-lg',
        restore: 'bi:arrow-counterclockwise',
        share: 'bi:share',
        config: 'bi:gear',
        export: 'bi:download',
        filter: 'bi:funnel',
        prev: 'bi:chevron-left',
        next: 'bi:chevron-right',
        close: 'bi:x-lg',
        filter_off: 'bi:x-circle',
        scroll_horizontal: 'bi:arrows',
        rows: 'bi:view-stacked',
        chevron_up: 'bi:chevron-up',
        chevron_down: 'bi:chevron-down',
        chevron_right: 'bi:chevron-right',
        book: 'bi:book',
        sliders: 'bi:sliders',
        grip: 'bi:grip-vertical',
        stack: 'bi:arrow-90deg-up',
        tour: 'bi:signpost-split',
        sort: 'bi:arrow-down-up',
        sort_asc: 'bi:arrow-up',
        sort_desc: 'bi:arrow-down',
    } %}
    {{ include('@NowoUiKitBundle/components/_icon_ux.html.twig', {name: ux_map[name]|default(name)}, false) }}
{% elseif icon_set == 'tabler-icons' %}
    {% set map = {
        edit: 'ti ti-pencil',
        delete: 'ti ti-trash',
        view: 'ti ti-eye',
        copy: 'ti ti-copy',
        create: 'ti ti-plus',
        save: 'ti ti-check',
        cancel: 'ti ti-x',
        restore: 'ti ti-restore',
        share: 'ti ti-share',
        config: 'ti ti-settings',
        export: 'ti ti-download',
        filter: 'ti ti-filter',
        prev: 'ti ti-chevron-left',
        next: 'ti ti-chevron-right',
        close: 'ti ti-x',
        filter_off: 'ti ti-filter-off',
        scroll_horizontal: 'ti ti-arrows-horizontal',
        rows: 'ti ti-layout-rows',
        chevron_up: 'ti ti-chevron-up',
        chevron_down: 'ti ti-chevron-down',
        chevron_right: 'ti ti-chevron-right',
        book: 'ti ti-book',
        sliders: 'ti ti-adjustments',
        grip: 'ti ti-grip-vertical',
        stack: 'ti ti-corner-left-up',
        tour: 'ti ti-route',
        sort: 'ti ti-arrows-sort',
        sort_asc: 'ti ti-arrow-up',
        sort_desc: 'ti ti-arrow-down',
    } %}
    <i class="{{ map[name]|default('ti ti-' ~ name) }}" aria-hidden="true"></i>
