{#
  Icon by nowo_ui_kit_icon_set.

  Required:
    - name: canonical action kind or free string (ux_icon / fallback class)

  Canonical kinds (REQ-UI-001):
    edit, delete, view, copy, create, save, cancel, restore, share, config,
    export, filter, prev, next, close

  Optional:
    - label: accessible text (aria-hidden decorative when parent has aria-label)
#}
{% set icon_set = nowo_ui_kit_icon_set|default('bootstrap-icons') %}
{% set label = label|default(name) %}
{% if icon_set == 'none' %}
    <span class="nowo-ui-icon nowo-ui-icon--text">{{ label }}</span>
{% elseif icon_set == 'ux_icon' %}
    {# Deferred to a separate template: Twig resolves ux_icon() at compile time. #}
    {% set ux_map = {
        edit: 'bi:pencil',
        delete: 'bi:trash',
        view: 'bi:eye',
        copy: 'bi:clipboard',
        create: 'bi:plus-lg',
        save: 'bi:check-lg',
        cancel: 'bi:x-lg',
        restore: 'bi:arrow-counterclockwise',
        share: 'bi:share',
        config: 'bi:gear',
        export: 'bi:download',
        filter: 'bi:funnel',
        prev: 'bi:chevron-left',
        next: 'bi:chevron-right',
        close: 'bi:x-lg'
    } %}
    {% include '@NowoUiKitBundle/components/_icon_ux.html.twig' with { name: ux_map[name]|default(name) } only %}
{% elseif icon_set == 'tabler-icons' %}
    {% set map = {
        edit: 'ti ti-pencil',
        delete: 'ti ti-trash',
        view: 'ti ti-eye',
        copy: 'ti ti-copy',
        create: 'ti ti-plus',
        save: 'ti ti-check',
        cancel: 'ti ti-x',
        restore: 'ti ti-restore',
        share: 'ti ti-share',
        config: 'ti ti-settings',
        export: 'ti ti-download',
        filter: 'ti ti-filter',
        prev: 'ti ti-chevron-left',
        next: 'ti ti-chevron-right',
        close: 'ti ti-x'
    } %}
    <i class="{{ map[name]|default('ti ti-' ~ name) }}" aria-hidden="true"></i>
{% elseif icon_set == 'svg_inline' %}
    {% set paths = {
        edit: 'M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z',
        delete: 'M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z',
        view: 'M12 5c-7 0-10 7-10 7s3 7 10 7 10-7 10-7-3-7-10-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10z',
        copy: 'M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z',
        create: 'M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z',
        save: 'M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z',
        cancel: 'M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z',
