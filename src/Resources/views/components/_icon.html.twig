        config: 'M19.14 12.94c.04-.31.06-.63.06-.94s-.02-.63-.06-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96a7.2 7.2 0 0 0-1.62-.94l-.36-2.54A.48.48 0 0 0 14 2h-4a.48.48 0 0 0-.48.42l-.36 2.54c-.57.23-1.11.54-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.65 8.87a.49.49 0 0 0 .12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94L2.77 14.5a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.3.59.22l2.39-.96c.5.4 1.05.72 1.62.94l.36 2.54c.05.24.24.42.48.42h4c.24 0 .44-.18.48-.42l.36-2.54c.57-.22 1.12-.54 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.49.49 0 0 0-.12-.61l-2.03-1.58zM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2z',
        export: 'M5 20h14v-2H5v2zM11 4v10.17l3.59-3.58L16 12l-5 5-5-5 1.41-1.41L10 14.17V4h1z',
        filter: 'M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z',
        prev: 'M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z',
        next: 'M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z',
        close: 'M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z'
    } %}
    <svg class="nowo-ui-icon" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="{{ paths[name]|default(paths.view) }}"/>
    </svg>
{% else %}
    {# bootstrap-icons default #}
    {% set map = {
        edit: 'bi bi-pencil',
        delete: 'bi bi-trash',
        view: 'bi bi-eye',
        copy: 'bi bi-clipboard',
        create: 'bi bi-plus-lg',
        save: 'bi bi-check-lg',
        cancel: 'bi bi-x-lg',
        restore: 'bi bi-arrow-counterclockwise',
        share: 'bi bi-share',
        config: 'bi bi-gear',
        export: 'bi bi-download',
        filter: 'bi bi-funnel',
        prev: 'bi bi-chevron-left',
        next: 'bi bi-chevron-right',
        close: 'bi bi-x-lg'
    } %}
    <i class="{{ map[name]|default('bi bi-' ~ name) }}" aria-hidden="true"></i>
{% endif %}
