{% macro flash(type='success', framework=null) -%}
nowo-ui-flash nowo-ui-flash--{{ type == 'danger' or type == 'error' ? 'error' : type }}
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} alert alert-{{ type == 'error' ? 'danger' : type }}
{%- elseif f == 'tailwind' %} rounded-md px-4 py-3 text-sm mb-2 {% if type == 'success' %}bg-emerald-50 text-emerald-800 border border-emerald-200{% elseif type == 'warning' %}bg-amber-50 text-amber-800 border border-amber-200{% elseif type == 'info' %}bg-sky-50 text-sky-800 border border-sky-200{% else %}bg-red-50 text-red-800 border border-red-200{% endif %}
{%- elseif f == 'foundation' %} callout {{ type == 'success' ? 'success' : (type == 'warning' ? 'warning' : 'alert') }}
{%- endif -%}
{%- endmacro %}

{% macro badge(variantOrFramework=null, framework=null) -%}
{%- set frameworks = ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler', 'tailwind', 'foundation', 'custom', 'none'] -%}
{%- set variant = null -%}
{%- if framework -%}
  {%- set variant = variantOrFramework -%}
  {%- set f = _self.resolve_fw(framework) -%}
{%- elseif variantOrFramework in frameworks -%}
  {%- set f = _self.resolve_fw(variantOrFramework) -%}
{%- else -%}
  {%- set variant = variantOrFramework -%}
  {%- set f = _self.resolve_fw(null) -%}
{%- endif -%}
nowo-ui-badge{% if variant %} nowo-ui-badge--{{ variant }}{% endif %}
{%- if f in ['bootstrap', 'bootstrap5', 'tabler'] %} badge{% if variant == 'success' %} bg-success{% elseif variant == 'warning' %} bg-warning text-dark{% elseif variant == 'danger' or variant == 'error' %} bg-danger{% elseif variant == 'info' %} bg-info text-dark{% else %} bg-light text-dark border{% endif %} ms-2
{%- elseif f == 'bootstrap4' %} badge{% if variant == 'success' %} badge-success{% elseif variant == 'warning' %} badge-warning{% elseif variant == 'danger' or variant == 'error' %} badge-danger{% elseif variant == 'info' %} badge-info{% else %} badge-light border{% endif %} ml-2
{%- elseif f == 'tailwind' %} ml-2 inline-flex rounded-full border px-2 py-0.5 text-xs{% if variant == 'success' %} border-emerald-300 text-emerald-800 bg-emerald-50{% elseif variant == 'warning' %} border-amber-300 text-amber-800 bg-amber-50{% elseif variant == 'danger' or variant == 'error' %} border-red-300 text-red-800 bg-red-50{% elseif variant == 'info' %} border-sky-300 text-sky-800 bg-sky-50{% else %} border-slate-300 text-slate-700{% endif %}
{%- elseif f == 'foundation' %} badge{% if variant == 'success' %} success{% elseif variant == 'warning' %} warning{% elseif variant == 'danger' or variant == 'error' %} alert{% else %} secondary{% endif %}
{%- endif -%}
{%- endmacro %}

{% macro action(kind='edit', framework=null) -%}
nowo-ui-action nowo-ui-action--{{ kind }} {{ _self.btn(kind == 'delete' ? 'danger' : (kind == 'view' ? 'secondary' : 'primary'), 'sm', framework) }}
{%- endmacro %}

{% macro modal_toggle_attrs(framework=null) -%}
