{#
  REQ-UI-001: Canonical Nowo UI class helpers.
  Import: {% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}

  Uses Twig global nowo_ui_kit_css_framework (bootstrap5 default).
  Most macros accept an optional trailing `framework` to override the global
  (so feature bundles can pass their own css_framework without coupling configs).
#}
{% macro resolve_fw(framework=null) -%}
{%- if framework -%}{{ framework|trim }}{%- else -%}{{ nowo_ui_kit_css_framework|default('bootstrap5') }}{%- endif -%}
{%- endmacro %}

{% macro fw(framework=null) %}{{ _self.resolve_fw(framework) }}{% endmacro %}

{% macro is_bootstrap(framework=null) %}
{%- set f = _self.resolve_fw(framework) -%}
{{- f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] ? '1' : '' -}}
{% endmacro %}

{% macro btn(variant='secondary', size=null, framework=null) -%}
{%- set f = _self.resolve_fw(framework) -%}
{%- set v = variant|default('secondary') -%}
nowo-ui-btn nowo-ui-btn--{{ v }}{% if size %} nowo-ui-btn--{{ size }}{% endif %}
{%- if f in ['bootstrap', 'bootstrap5', 'tabler'] %}
 btn{% if v == 'primary' %} btn-primary{% elseif v == 'danger' %} btn-outline-danger{% elseif v == 'link' %} btn-link{% else %} btn-outline-secondary{% endif %}{% if size %} btn-{{ size }}{% endif %}
{%- elseif f == 'bootstrap4' %}
 btn{% if v == 'primary' %} btn-primary{% elseif v == 'danger' %} btn-outline-danger{% elseif v == 'link' %} btn-link{% else %} btn-outline-secondary{% endif %}{% if size %} btn-{{ size }}{% endif %}
{%- elseif f == 'tailwind' %}
 inline-flex items-center gap-1 rounded-md font-medium
 {%- if size == 'sm' %} px-2 py-1 text-sm{% else %} px-3 py-1.5 text-sm{% endif %}
 {%- if v == 'primary' %} bg-blue-600 text-white hover:bg-blue-500
 {%- elseif v == 'danger' %} border border-red-500 text-red-600 hover:bg-red-50
 {%- elseif v == 'link' %} text-blue-600 underline-offset-2 hover:underline px-0
 {%- else %} border border-slate-300 text-slate-700 hover:bg-slate-50{% endif %}
{%- elseif f == 'foundation' %}
 button{% if v == 'primary' %} primary{% elseif v == 'danger' %} alert{% else %} secondary{% endif %}{% if size == 'sm' %} tiny{% endif %}
{%- endif -%}
{%- endmacro %}

{% macro toolbar(framework=null) -%}
nowo-ui-toolbar
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} d-flex flex-wrap align-items-center gap-1 mb-2
{%- elseif f == 'tailwind' %} flex flex-wrap items-center gap-1 mb-2
{%- elseif f == 'foundation' %} grid-x grid-margin-x align-middle mb-2
{%- endif -%}
{%- endmacro %}

{% macro page_header(framework=null) -%}
nowo-ui-page-header
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3
{%- elseif f == 'tailwind' %} flex flex-wrap items-start justify-between gap-2 mb-3
{%- elseif f == 'foundation' %} grid-x grid-margin-x align-middle mb-3
{%- endif -%}
{%- endmacro %}

{% macro search_form(framework=null) -%}
nowo-ui-search
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} d-flex flex-wrap gap-2 mb-3
{%- elseif f == 'tailwind' %} flex flex-wrap gap-2 mb-4
{%- elseif f == 'foundation' %} grid-x grid-margin-x mb-3
{%- endif -%}
{%- endmacro %}

{% macro input(framework=null) -%}
nowo-ui-input
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} form-control
{%- elseif f == 'tailwind' %} block w-full max-w-xs rounded-md border border-slate-300 px-3 py-1.5 text-sm
{%- elseif f == 'foundation' %}
{%- endif -%}
{%- endmacro %}

{% macro search_input(framework=null) -%}
{{ _self.input(framework) }} nowo-ui-search__input
{%- set f = _self.resolve_fw(framework) -%}
{%- if f == 'tailwind' %} min-w-56 flex-1 max-w-none
{%- endif -%}
{%- endmacro %}

{% macro list(framework=null) -%}
nowo-ui-list
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} list-group m-0
{%- elseif f == 'tailwind' %} divide-y divide-slate-200 border border-slate-200 rounded-md m-0 p-0 list-none
{%- elseif f == 'foundation' %} no-bullet
{%- endif -%}
{%- endmacro %}

{% macro list_item(framework=null) -%}
nowo-ui-list-item
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} list-group-item d-flex justify-content-between align-items-center
{%- elseif f == 'tailwind' %} flex justify-between items-center px-3 py-2
{%- elseif f == 'foundation' %} callout
{%- endif -%}
{%- endmacro %}

{% macro table_wrap(framework=null) -%}
nowo-ui-table-wrap
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} table-responsive
{%- elseif f == 'tailwind' %} overflow-x-auto
{%- endif -%}
{%- endmacro %}

{% macro table(framework=null) -%}
nowo-ui-table nowo-ui-table--striped
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} table table-hover align-middle
{%- elseif f == 'tailwind' %} min-w-full text-sm text-left
{%- elseif f == 'foundation' %} stack table
{%- endif -%}
{%- endmacro %}

{% macro row_actions(framework=null) -%}
nowo-ui-row-actions
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} d-flex gap-1
{%- elseif f == 'tailwind' %} flex gap-1
{%- elseif f == 'foundation' %} button-group
{%- endif -%}
{%- endmacro %}

{% macro muted(framework=null) -%}
nowo-ui-muted
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} text-muted
{%- elseif f == 'tailwind' %} text-slate-500
{%- elseif f == 'foundation' %} text-secondary
{%- endif -%}
{%- endmacro %}

{% macro empty(framework=null) -%}
nowo-ui-empty {{ _self.muted(framework) }}
{%- endmacro %}

{% macro flash(type='success', framework=null) -%}
nowo-ui-flash nowo-ui-flash--{{ type == 'danger' or type == 'error' ? 'error' : type }}
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} alert alert-{{ type == 'error' ? 'danger' : type }}
{%- elseif f == 'tailwind' %} rounded-md px-4 py-3 text-sm mb-2 {% if type == 'success' %}bg-emerald-50 text-emerald-800 border border-emerald-200{% elseif type == 'warning' %}bg-amber-50 text-amber-800 border border-amber-200{% elseif type == 'info' %}bg-sky-50 text-sky-800 border border-sky-200{% else %}bg-red-50 text-red-800 border border-red-200{% endif %}
{%- elseif f == 'foundation' %} callout {{ type == 'success' ? 'success' : (type == 'warning' ? 'warning' : 'alert') }}
{%- endif -%}
{%- endmacro %}

{% macro badge(framework=null) -%}
nowo-ui-badge
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'tabler'] %} badge bg-light text-dark border ms-2
{%- elseif f == 'bootstrap4' %} badge badge-light border ml-2
{%- elseif f == 'tailwind' %} ml-2 inline-flex rounded-full border border-slate-300 px-2 py-0.5 text-xs text-slate-700
{%- elseif f == 'foundation' %} badge secondary
{%- endif -%}
{%- endmacro %}

{% macro action(kind='edit', framework=null) -%}
nowo-ui-action nowo-ui-action--{{ kind }} {{ _self.btn(kind == 'delete' ? 'danger' : (kind == 'view' ? 'secondary' : 'primary'), 'sm', framework) }}
{%- endmacro %}

{% macro modal_toggle_attrs(framework=null) -%}
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'tabler'] %}data-bs-toggle="modal"{%- elseif f == 'bootstrap4' %}data-toggle="modal"{%- else %}data-nowo-modal-open{% endif -%}
{%- endmacro %}

{% macro modal_target_attr(id, framework=null) -%}
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'tabler'] %}data-bs-target="#{{ id }}"{%- elseif f == 'bootstrap4' %}data-target="#{{ id }}"{%- else %}data-nowo-modal-target="{{ id }}"{% endif -%}
{%- endmacro %}

{% macro modal_dismiss_attrs(framework=null) -%}
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'tabler'] %}data-bs-dismiss="modal"{%- elseif f == 'bootstrap4' %}data-dismiss="modal"{%- else %}data-nowo-modal-close{% endif -%}
{%- endmacro %}

{% macro pagination_wrap(framework=null) -%}
nowo-ui-pagination
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3
{%- elseif f == 'tailwind' %} flex flex-wrap items-center justify-between gap-2 mt-3
{%- endif -%}
{%- endmacro %}

{% macro tab_list(framework=null) -%}
nowo-ui-tabs
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} nav nav-tabs mb-3
{%- elseif f == 'tailwind' %} flex flex-wrap gap-2 border-b border-slate-200 mb-3
{%- elseif f == 'foundation' %} tabs
{%- endif -%}
{%- endmacro %}

{% macro tab_item(active=false, framework=null) -%}
nowo-ui-tabs__item{% if active %} nowo-ui-tabs__item--active{% endif %}
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} nav-link{% if active %} active{% endif %}
{%- elseif f == 'tailwind' %} px-3 py-2 text-sm no-underline{% if active %} border-b-2 border-blue-600 text-blue-700{% else %} text-slate-600{% endif %}
{%- elseif f == 'foundation' %} tabs-title{% if active %} is-active{% endif %}
{%- endif -%}
{%- endmacro %}
