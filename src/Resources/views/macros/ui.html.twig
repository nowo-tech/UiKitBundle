{#
  REQ-UI-001: Canonical Nowo UI class helpers.
  Import: {% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}

  Uses Twig global nowo_ui_kit_css_framework (bootstrap5 default).
  Most macros accept an optional trailing `framework` to override the global
  (so feature bundles can pass their own css_framework without coupling configs).
#}
{% macro resolve_fw(framework=null) -%}
{%- if framework -%}{{ framework|trim }}{%- else -%}{{ nowo_ui_kit_css_framework|default('bootstrap5') }}{%- endif -%}
{%- endmacro %}

{% macro fw(framework=null) %}{{ _self.resolve_fw(framework) }}{% endmacro %}

{% macro is_bootstrap(framework=null) %}
{%- set f = _self.resolve_fw(framework) -%}
{{- f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] ? '1' : '' -}}
{% endmacro %}

{% macro btn(variant='secondary', size=null, framework=null) -%}
{%- set f = _self.resolve_fw(framework) -%}
{%- set v = variant|default('secondary') -%}
nowo-ui-btn nowo-ui-btn--{{ v }}{% if size %} nowo-ui-btn--{{ size }}{% endif %}
{%- if f in ['bootstrap', 'bootstrap5', 'tabler'] %}
 btn{% if v == 'primary' %} btn-primary{% elseif v == 'danger' %} btn-outline-danger{% elseif v == 'link' %} btn-link{% else %} btn-outline-secondary{% endif %}{% if size %} btn-{{ size }}{% endif %}
{%- elseif f == 'bootstrap4' %}
 btn{% if v == 'primary' %} btn-primary{% elseif v == 'danger' %} btn-outline-danger{% elseif v == 'link' %} btn-link{% else %} btn-outline-secondary{% endif %}{% if size %} btn-{{ size }}{% endif %}
{%- elseif f == 'tailwind' %}
 inline-flex items-center gap-1 rounded-md font-medium
 {%- if size == 'sm' %} px-2 py-1 text-sm{% else %} px-3 py-1.5 text-sm{% endif %}
 {%- if v == 'primary' %} bg-blue-600 text-white hover:bg-blue-500
 {%- elseif v == 'danger' %} border border-red-500 text-red-600 hover:bg-red-50
 {%- elseif v == 'link' %} text-blue-600 underline-offset-2 hover:underline px-0
 {%- else %} border border-slate-300 text-slate-700 hover:bg-slate-50{% endif %}
{%- elseif f == 'foundation' %}
 button{% if v == 'primary' %} primary{% elseif v == 'danger' %} alert{% else %} secondary{% endif %}{% if size == 'sm' %} tiny{% endif %}
{%- endif -%}
{%- endmacro %}

{% macro toolbar(framework=null) -%}
nowo-ui-toolbar
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} d-flex flex-wrap align-items-center gap-1 mb-2
{%- elseif f == 'tailwind' %} flex flex-wrap items-center gap-1 mb-2
{%- elseif f == 'foundation' %} grid-x grid-margin-x align-middle mb-2
{%- endif -%}
{%- endmacro %}

{% macro page_header(framework=null) -%}
nowo-ui-page-header
{%- set f = _self.resolve_fw(framework) -%}
{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3
{%- elseif f == 'tailwind' %} flex flex-wrap items-start justify-between gap-2 mb-3
{%- elseif f == 'foundation' %} grid-x grid-margin-x align-middle mb-3
{%- endif -%}
{%- endmacro %}

{% macro search_form(framework=null) -%}
nowo-ui-search
