{%- if f in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} list-group m-0
{%- elseif f == 'tailwind' %} divide-y divide-slate-200 border border-slate-200 rounded-md m-0 p-0 list-none
{%- elseif f == 'foundation' %} no-bullet
