{#
  Combobox field (2.53): the widget of Nowo\UiKitBundle\Form\ComboboxType, through the `combobox` partial. Prepended to
  twig.form_themes by the bundle (and used by form/nowo_ui_layout.html.twig), so form_row() and form_widget() render it in any host
  theme; it defines only `nowo_ui_combobox_*` blocks. Without JavaScript the field is this plain text input and submits what was typed.
#}
{%- block nowo_ui_combobox_widget -%}
    {%- set _c = nowo_ui_combobox -%}
    {%- set _invalid = errors is defined and errors|length > 0 -%}
    {%- set _class = nowo_ui_class('input', _c.bundle) ~ (_invalid ? ' ' ~ nowo_ui_class('input_invalid', _c.bundle)) ~ (attr.class is defined ? ' ' ~ attr.class) -%}
    {%- set _input -%}
        <input type="text" id="{{ id }}" name="{{ full_name }}" class="{{ _class }}" value="{{ value }}" autocomplete="off"
            {%- if required %} required{% endif %}{% if disabled %} disabled{% endif %}
            {%- if help is defined and help is not empty %} aria-describedby="{{ id }}_help"{% endif %}{% if _invalid %} aria-invalid="true"{% endif %}
            {%- for _k, _v in attr|filter((v, k) => k != 'class') %}{% if _v is same as(true) %} {{ _k }}{% elseif _v is not same as(false) and _v is not null %} {{ _k }}="{{ _v }}"{% endif %}{% endfor %}>
    {%- endset -%}
    {{- include(nowo_ui_partial('combobox', _c.bundle), {id: id ~ '_combobox', input: _input, url: _c.url, min_length: _c.min_length, debounce: _c.debounce, param: _c.param, labels: _c.labels, bundle: _c.bundle}, with_context: false) -}}
{%- endblock nowo_ui_combobox_widget -%}
