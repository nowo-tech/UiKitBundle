{% extends layout_template|default('base.html.twig') %}

{% block title %}{{ 'demo.kitchen_sink.title'|trans({}, 'NowoUiKitBundle') }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {#- 1.x partials on hosts whose framework CSS is unlayered (Bootstrap / Tailwind play CDN): the unlayered kit keeps
        the 1.x cascade (PAGE_CONTRACT.md#cascade-layers) -#}
    <link rel="stylesheet" href="{{ asset('css/nowo-ui.unlayered.css', 'nowo_ui_kit') }}">
{% endblock %}

{% block body %}
    {% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}

    {% include '@NowoUiKitBundle/partials/_page_loader.html.twig' with {
        visual: 'orb',
        orb_state: 'breathing'
    } %}

    {% include '@NowoUiKitBundle/partials/_toasts.html.twig' with {
        flashes: {
            success: ['Saved successfully.'],
            warning: [{ title: 'Attention', message: 'Structured toast example.' }]
        }
    } %}

    {% set sink_main %}
        {% include '@NowoUiKitBundle/partials/_page_header.html.twig' with {
            title: 'demo.kitchen_sink.title'|trans({}, 'NowoUiKitBundle'),
            intro: 'demo.kitchen_sink.intro'|trans({}, 'NowoUiKitBundle')
        } %}

        {% include '@NowoUiKitBundle/partials/_tabs.html.twig' with {
            items: [
                { label: 'Buttons', href: '#buttons', current: true },
                { label: 'Locale tabs', href: '#locale-tabs', current: false },
                { label: 'Table', href: '#table', current: false },
                { label: 'Host chrome', href: '#host-chrome', current: false },
                { label: 'Feedback', href: '#feedback', current: false },
                { label: 'Orbs', href: '#orbs', current: false }
            ]
        } %}

        {% include '@NowoUiKitBundle/partials/_filters.html.twig' with {
            q: '',
            clear_href: '#',
            actions: '<button type="button" class="' ~ ui.btn('secondary', 'sm') ~ '" data-nowo-ui-page-loader-show>Show loader</button>'
        } %}

        <section id="buttons" class="nowo-ui-body">
            <div class="{{ ui.toolbar() }}">
                <button type="button" class="{{ ui.btn('primary') }}">Primary</button>
                <button type="button" class="{{ ui.btn('secondary') }}">Secondary</button>
                <button type="button" class="{{ ui.btn('danger', 'sm') }}">Danger sm</button>
                <button type="button" class="{{ ui.btn('link') }}">Link</button>
                <span class="{{ ui.badge() }}">Badge</span>
                <span class="{{ ui.badge('success') }}">Success</span>
                <span class="{{ ui.badge('danger') }}">Danger</span>
                <button type="button" class="{{ ui.btn('primary') }}" {{ ui.modal_toggle_attrs() }} {{ ui.modal_target_attr('nowo-ui-kit-demo-modal') }}>Modal</button>
                <button type="button" class="{{ ui.btn('danger', 'sm') }}" {{ ui.confirm_toggle_attrs() }} {{ ui.confirm_target_attr('nowo-ui-kit-demo-confirm') }}>Confirm</button>
                {% include '@NowoUiKitBundle/partials/_kebab.html.twig' with {
                    items: [
                        { label: 'Open', href: '#' },
                        { label: 'Delete', href: '#', danger: true }
                    ]
                } %}
            </div>
            <div class="{{ ui.progress() }}" style="max-width: 16rem; margin-top: 1rem;">
                <div class="{{ ui.progress_bar() }}" style="width: 45%;" role="progressbar" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            <p class="nowo-ui-body" style="margin-top: 0.75rem;">
                <span class="{{ ui.spinner('sm') }}" aria-hidden="true"></span>
                <span class="{{ ui.muted() }}"> Spinner</span>
            </p>
            <div class="{{ ui.toolbar() }}">
                <button type="button" class="{{ ui.btn('outline') }}">Outline</button>
                <a href="#buttons" class="{{ ui.link() }}">Text link</a>
                <span class="{{ ui.badge('warning') }}">Warning</span>
                <span class="{{ ui.badge('info') }}">Info</span>
                <span class="{{ ui.badge('neutral') }}">Neutral</span>
                {#- REQ-TWIG-005: the control swatches are a Symfony Form (kitchen_forms from the demo controller) -#}
                {% if kitchen_forms is defined %}{{ include('@NowoUiKitBundle/demo/_kitchen_sink_swatch.html.twig', {form: kitchen_forms.swatch, with_search: true}, false) }}{% endif %}
            </div>
            {# Theming (1.13): a host theme is a short block of --nowo-ui-* tokens; here scoped to one wrapper (docs/THEMING.md). #}
            <div class="nowo-ui-body" style="--nowo-ui-primary: #1f6f54; --nowo-ui-primary-hover: #134736; --nowo-ui-border: #d8e2dc; --nowo-ui-border-strong: #d8e2dc; --nowo-ui-surface-muted: #e7f0eb; --nowo-ui-text: #0f1c18; --nowo-ui-radius: 0.5rem; --nowo-ui-tab-active-weight: 500;">
                <p class="{{ ui.muted() }}">Same macros, themed with eight tokens on a wrapper:</p>
                <div class="{{ ui.toolbar() }}">
                    <button type="button" class="{{ ui.btn('primary') }}">Primary</button>
                    <button type="button" class="{{ ui.btn('secondary') }}">Secondary</button>
                    <button type="button" class="{{ ui.btn('outline') }}">Outline</button>
                    <button type="button" class="{{ ui.btn('link') }}">Link</button>
                    <span class="{{ ui.badge('success') }}">Success</span>
                    {% if kitchen_forms is defined %}{{ include('@NowoUiKitBundle/demo/_kitchen_sink_swatch.html.twig', {form: kitchen_forms.swatch_themed, with_search: false}, false) }}{% endif %}
                </div>
                <nav class="{{ ui.tab_list() }}" aria-label="Themed tabs">
                    <a href="#buttons" class="{{ ui.tab_item(true) }}">Active</a>
                    <a href="#table" class="{{ ui.tab_item(false) }}">Inactive</a>
                </nav>
            </div>
        </section>

        {# 2.4: segmented control — two options backed by one checkbox (the form field; nowo-ui-segmented.js syncs it). #}
        <section id="segmented" class="nowo-ui-body" data-demo-segmented>
            <p class="{{ ui.muted() }}" id="demo-segmented-label">Notify me about</p>
            {% include '@NowoUiKitBundle/partials/_segmented.html.twig' with {
                name: 'involved_only',
                id: 'demo-involved-only',
                checked: false,
                labelled_by: 'demo-segmented-label',
                options: [
                    { label: 'All issues', checked: false, title: 'Every issue of the project' },
                    { label: 'Involved only', checked: true, title: 'Issues you created, are assigned to or commented on' }
                ]
            } %}
        </section>

        {# 2.5: locale tabs — one panel per locale; stacked fieldsets without JS, WAI-ARIA tabs once nowo-ui-tabs.js runs.
           The English panel carries a server error (marker + screen-reader text, opened first); the required inputs
           show the browser validation opening a hidden panel. #}
        <section id="locale-tabs" class="nowo-ui-body" data-demo-locale-tabs>
            {% if kitchen_forms is defined %}
                {{ include('@NowoUiKitBundle/demo/_kitchen_sink_locale_tabs.html.twig', {form: kitchen_forms.locale_tabs}, false) }}
            {% endif %}
        </section>

        {% set card_body %}
            <p class="{{ ui.muted() }}">Card / panel building block for admin surfaces.</p>
        {% endset %}
        {% include '@NowoUiKitBundle/partials/_card.html.twig' with {
            title: 'Example card',
            intro: 'Header + body + footer slots',
            body: card_body,
            footer: '<button type="button" class="' ~ ui.btn('secondary', 'sm') ~ '" data-nowo-ui-page-loader-hide>Hide loader</button>'
        } %}

        <section id="table" class="nowo-ui-body">
            <div class="{{ ui.table_wrap() }}">
                <table class="{{ ui.table() }}">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>Alpha <span class="{{ ui.muted() }}">muted</span></td>
                            <td>
                                {% include '@NowoUiKitBundle/partials/_row_actions.html.twig' with {
                                    actions: [
                                        { kind: 'view', href: '#' },
                                        { kind: 'edit', href: '#' },
                                        { kind: 'delete', tag: 'button', confirm_id: 'nowo-ui-kit-demo-confirm' }
                                    ]
                                } %}
                            </td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td>Beta (text actions)</td>
                            <td>
                                {% include '@NowoUiKitBundle/partials/_row_actions.html.twig' with {
                                    display: 'text',
                                    actions: [
                                        { kind: 'edit', href: '#' },
                                        { kind: 'delete', method: 'POST', href: '#', confirm_message: 'Delete Beta?' }
                                    ]
                                } %}
                            </td>
                        </tr>
                        <tr>
                            <td>3</td>
                            <td>Gamma (icon + text)</td>
                            <td>
                                {% include '@NowoUiKitBundle/partials/_row_actions.html.twig' with {
                                    display: 'icon_text',
                                    actions: [
                                        { kind: 'copy', href: '#' },
                                        { kind: 'view', href: '#' },
                                        { kind: 'config', href: '#' }
                                    ]
                                } %}
                            </td>
                        </tr>
                        <tr data-demo-popover-row>
                            <td>4</td>
                            <td>Delta (2.4: overflow menu as a native popover — never clipped by the table scroller)</td>
                            <td>
                                {% include '@NowoUiKitBundle/partials/_row_actions.html.twig' with {
                                    menu: true,
                                    popover: true,
                                    menu_label: 'Actions',
                                    actions: [
                                        { kind: 'view', href: '#table' },
                                        { kind: 'edit', href: '#table' },
                                        { kind: 'delete', label: 'Archive', href: '#table' }
                                    ]
                                } %}
                                {% include '@NowoUiKitBundle/partials/_kebab.html.twig' with {
                                    id: 'demo-kebab-popover',
                                    popover: true,
                                    items: [
                                        { label: 'Duplicate', href: '#table' },
                                        { label: 'Delete', href: '#table', danger: true }
                                    ]
                                } %}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            {% if pagination is defined %}
                {% include '@NowoUiKitBundle/partials/_pagination.html.twig' with {
                    pagination: pagination,
                    item_count: item_count|default(2),
                    route: route|default('nowo_ui_kit_kitchen_sink'),
                    route_params: route_params|default({}),
                    query: query|default({}),
                    per_page_choices: [10, 25, 50]
                } %}
            {% endif %}

            {#- 2.20 sortable headers (View\Table + Listing\SortRequest): server-side links keep the query and go back to
                page 1; the second table is rendered whole and sorts in the browser where the Stimulus peer table-sort is
                registered (docs/STIMULUS.md) -#}
            {% if kitchen_tables is defined %}
                <div id="sortable">
                    {% for _sortable_table in kitchen_tables %}
                        {{ include(nowo_ui_partial('table'), {table: _sortable_table, route: route|default('nowo_ui_kit_kitchen_sink')}, false) }}
                    {% endfor %}
                </div>
            {% endif %}
        </section>

        {# 1.17 host chrome: static markup (no-JS fallback) — the Stimulus peers responsive-table, filters-collapse and
           disclosure-icon add the behaviour in hosts that register them (docs/STIMULUS.md). #}
        <section id="host-chrome" class="nowo-ui-body">
            {% if kitchen_forms is defined %}
                {{ include('@NowoUiKitBundle/demo/_kitchen_sink_filter_bar.html.twig', {form: kitchen_forms.host_chrome}, false) }}
            {% endif %}

            <div class="nowo-ui-card">
                {% embed '@NowoUiKitBundle/partials/_responsive_table.html.twig' with {table_mode: 'scroll', dialog_id: 'kitchen-sink-rt'} %}
                    {% block table %}
                        {# Macro imports are not inherited by embed blocks. #}
                        {% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
                        <table class="nowo-ui-data-table" data-responsive-table-target="table">
                            <thead>
                                <tr>
                                    <th data-column="name" data-required="1">Name</th>
                                    <th data-column="status" data-required="1">Status</th>
                                    <th data-column="owner">Owner</th>
                                    <th data-column="updated">Updated</th>
                                    <th data-column="notes">Notes</th>
                                    {% include '@NowoUiKitBundle/partials/_row_detail_head.html.twig' only %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in [
                                    {name: 'Alpha', status: 'success', owner: 'Ada Lovelace', updated: '2026-10-16 09:12', notes: 'First row of the responsive table demo.'},
                                    {name: 'Beta', status: 'warning', owner: 'Grace Hopper', updated: '2026-10-15 17:40', notes: 'Columns hide from the end while the table does not fit.'},
                                ] %}
                                    <tr>
                                        <td data-column="name">{{ row.name }}</td>
                                        <td data-column="status"><span class="{{ ui.badge(row.status) }}">{{ row.status }}</span></td>
                                        <td data-column="owner">{{ row.owner }}</td>
                                        <td data-column="updated">{{ row.updated }}</td>
                                        <td data-column="notes">{{ row.notes }}</td>
                                        {% include '@NowoUiKitBundle/partials/_row_detail_cell.html.twig' only %}
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endblock %}
                {% endembed %}
            </div>

            <div class="nowo-ui-card nowo-ui-corner-host">
                {% include '@NowoUiKitBundle/partials/_corner_tab.html.twig' with {label: 'Card settings', icon: 'config'} only %}
                <details open>
                    <summary>{% include '@NowoUiKitBundle/partials/_disclosure_icon.html.twig' only %} Disclosure chevron (open)</summary>
                    <p class="{{ ui.muted() }}">Static icons follow &lt;details open&gt; or aria-expanded; the morphicons module animates them.</p>
                </details>
                <p class="{{ ui.muted() }}">Thin scrollbars: <code>data-nowo-ui-thin-scrollbars</code> on &lt;html&gt; (this demo) or <code>.nowo-ui-thin-scroll</code> on any scroller.</p>
            </div>

            {% include '@NowoUiKitBundle/partials/_edge_tab.html.twig' with {href: 'https://github.com/nowo-tech/UiKitBundle/blob/main/docs/USAGE.md'} only %}
        </section>

        <section id="feedback" class="nowo-ui-body">
            <ul class="{{ ui.list() }}">
                <li class="{{ ui.list_item() }}"><span>Item A</span><span class="{{ ui.badge('info') }}">3</span></li>
                <li class="{{ ui.list_item() }}"><span>Item B</span><span class="{{ ui.badge('warning') }}">1</span></li>
            </ul>
            {% include '@NowoUiKitBundle/partials/_empty.html.twig' %}
        </section>

        <section id="orbs" class="nowo-ui-body">
            {% include '@NowoUiKitBundle/partials/_page_header.html.twig' with {
                title: 'Thinking orbs',
                intro: 'Local canvas orbs (MIT thinking-orbs engine). Size 64 / inline 20.'
            } %}
            <div class="nowo-ui-orb-row">
                {% for state in ['working', 'searching', 'solving', 'listening', 'connecting', 'weaving', 'composing', 'breathing', 'shaping'] %}
                    <div class="nowo-ui-orb-row__item">
                        {% include '@NowoUiKitBundle/partials/_thinking_orb.html.twig' with { state: state, size: 64 } %}
                        <p class="nowo-ui-orb-row__caption">{{ state }}</p>
                    </div>
                {% endfor %}
            </div>
            <p class="{{ ui.muted() }}" style="margin-top: 1rem;">
                Inline
                {% include '@NowoUiKitBundle/partials/_thinking_orb.html.twig' with { state: 'searching', size: 20 } %}
                searching…
            </p>
        </section>

        {% set modal_footer %}
            <button type="button" class="{{ ui.btn('secondary') }}" {{ ui.modal_dismiss_attrs() }}>Close</button>
        {% endset %}
        {% include '@NowoUiKitBundle/partials/_modal_shell.html.twig' with {
            id: 'nowo-ui-kit-demo-modal',
            title: 'Demo modal',
            body: '<p>Modal body content.</p>',
            footer: modal_footer
        } %}

        {% set confirm_footer %}
            <button type="button" class="{{ ui.btn('secondary') }}" {{ ui.confirm_dismiss_attrs() }}>{{ 'action.cancel'|trans({}, 'NowoUiKitBundle') }}</button>
            <button type="button" class="{{ ui.btn('danger') }}" {{ ui.confirm_dismiss_attrs() }}>{{ 'action.delete'|trans({}, 'NowoUiKitBundle') }}</button>
        {% endset %}
        {% include '@NowoUiKitBundle/partials/_confirm.html.twig' with {
            id: 'nowo-ui-kit-demo-confirm',
            title: 'Delete item?',
            body: '<p>This action cannot be undone. Host forms should POST with CSRF.</p>',
            footer: confirm_footer
        } %}
    {% endset %}

    {% set header_end %}
        {% include '@NowoUiKitBundle/partials/_width_toggle.html.twig' with { compact: true } %}
        {% include '@NowoUiKitBundle/partials/_theme_toggle.html.twig' with { compact: true } %}
        {% include '@NowoUiKitBundle/partials/_locale_switcher.html.twig' with {
            compact: true,
            current: 'en',
            locales: [
                { code: 'en', label: 'English', href: '#', current: true },
                { code: 'es', label: 'Español', href: '#' },
                { code: 'de', label: 'Deutsch', href: '#' }
            ]
        } %}
    {% endset %}

    {% set brand_html %}
        {% include '@NowoUiKitBundle/partials/_brand.html.twig' with { name: 'Nowo UiKit', href: '#' } %}
    {% endset %}

    {% include '@NowoUiKitBundle/partials/_shell.html.twig' with {
        brand_html: brand_html,
        header_end: header_end,
        aside_label: 'nav.aside'|trans({}, 'NowoUiKitBundle'),
        aside_items: [
            { label: 'Kitchen sink', href: '#buttons', current: true },
            {
                label: 'Sections',
                open: true,
                children: [
                    { label: 'Table', href: '#table' },
                    { label: 'Feedback', href: '#feedback' }
                ]
            }
        ],
        name: 'Demo User',
        email: 'demo@example.com',
        initials: 'DU',
        user_links: [
            { label: 'Preferences', href: '#', current: false },
            { label: 'Dashboard', href: '#' }
        ],
        logout_href: '#logout',
        footer_brand: 'Nowo UiKit',
        footer_links: [
            { label: 'Privacy', href: '#' },
            { label: 'Terms', href: '#' }
        ],
        footer_copyright: '© 2026 Nowo.tech',
        main: sink_main
    } %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/nowo-ui-modal.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/nowo-ui-shell.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/nowo-ui-toast.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/nowo-ui-confirm.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/nowo-ui-page-loader.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/nowo-ui-theme.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/nowo-ui-orb.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/nowo-ui-popover.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/nowo-ui-segmented.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/nowo-ui-tabs.js', 'nowo_ui_kit') }}" defer></script>
{% endblock %}
