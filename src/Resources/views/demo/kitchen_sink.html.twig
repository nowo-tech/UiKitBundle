{% extends layout_template|default('base.html.twig') %}

{% block title %}{{ 'demo.kitchen_sink.title'|trans({}, 'NowoUiKitBundle') }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
{% endblock %}

{% block body %}
    {% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}

    {% include '@NowoUiKitBundle/partials/_page_loader.html.twig' with {
        visual: 'orb',
        orb_state: 'breathing'
    } %}

    {% include '@NowoUiKitBundle/partials/_toasts.html.twig' with {
        flashes: {
            success: ['Saved successfully.'],
            warning: [{ title: 'Attention', message: 'Structured toast example.' }]
        }
    } %}

    {% set sink_main %}
        {% include '@NowoUiKitBundle/partials/_page_header.html.twig' with {
            title: 'demo.kitchen_sink.title'|trans({}, 'NowoUiKitBundle'),
            intro: 'demo.kitchen_sink.intro'|trans({}, 'NowoUiKitBundle')
        } %}

        {% include '@NowoUiKitBundle/partials/_tabs.html.twig' with {
            items: [
                { label: 'Buttons', href: '#buttons', current: true },
                { label: 'Table', href: '#table', current: false },
                { label: 'Feedback', href: '#feedback', current: false },
                { label: 'Orbs', href: '#orbs', current: false }
            ]
        } %}

        {% include '@NowoUiKitBundle/partials/_filters.html.twig' with {
            q: '',
            clear_href: '#',
            actions: '<button type="button" class="' ~ ui.btn('secondary', 'sm') ~ '" data-nowo-ui-page-loader-show>Show loader</button>'
        } %}

        <section id="buttons" class="nowo-ui-body">
            <div class="{{ ui.toolbar() }}">
                <button type="button" class="{{ ui.btn('primary') }}">Primary</button>
                <button type="button" class="{{ ui.btn('secondary') }}">Secondary</button>
                <button type="button" class="{{ ui.btn('danger', 'sm') }}">Danger sm</button>
                <button type="button" class="{{ ui.btn('link') }}">Link</button>
                <span class="{{ ui.badge() }}">Badge</span>
                <span class="{{ ui.badge('success') }}">Success</span>
                <span class="{{ ui.badge('danger') }}">Danger</span>
                <button type="button" class="{{ ui.btn('primary') }}" {{ ui.modal_toggle_attrs() }} {{ ui.modal_target_attr('nowo-ui-kit-demo-modal') }}>Modal</button>
                <button type="button" class="{{ ui.btn('danger', 'sm') }}" {{ ui.confirm_toggle_attrs() }} {{ ui.confirm_target_attr('nowo-ui-kit-demo-confirm') }}>Confirm</button>
                {% include '@NowoUiKitBundle/partials/_kebab.html.twig' with {
                    items: [
                        { label: 'Open', href: '#' },
                        { label: 'Delete', href: '#', danger: true }
                    ]
                } %}
            </div>
            <div class="{{ ui.progress() }}" style="max-width: 16rem; margin-top: 1rem;">
                <div class="{{ ui.progress_bar() }}" style="width: 45%;" role="progressbar" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            <p class="nowo-ui-body" style="margin-top: 0.75rem;">
                <span class="{{ ui.spinner('sm') }}" aria-hidden="true"></span>
                <span class="{{ ui.muted() }}"> Spinner</span>
            </p>
        </section>

        {% set card_body %}
            <p class="{{ ui.muted() }}">Card / panel building block for admin surfaces.</p>
        {% endset %}
        {% include '@NowoUiKitBundle/partials/_card.html.twig' with {
            title: 'Example card',
            intro: 'Header + body + footer slots',
            body: card_body,
            footer: '<button type="button" class="' ~ ui.btn('secondary', 'sm') ~ '" data-nowo-ui-page-loader-hide>Hide loader</button>'
        } %}

        <section id="table" class="nowo-ui-body">
            <div class="{{ ui.table_wrap() }}">
                <table class="{{ ui.table() }}">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>Alpha <span class="{{ ui.muted() }}">muted</span></td>
                            <td>
                                {% include '@NowoUiKitBundle/partials/_row_actions.html.twig' with {
                                    actions: [
                                        { kind: 'view', href: '#' },
                                        { kind: 'edit', href: '#' },
                                        { kind: 'delete', tag: 'button', confirm_id: 'nowo-ui-kit-demo-confirm' }
                                    ]
                                } %}
                            </td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td>Beta (text actions)</td>
                            <td>
                                {% include '@NowoUiKitBundle/partials/_row_actions.html.twig' with {
                                    display: 'text',
                                    actions: [
                                        { kind: 'edit', href: '#' },
                                        { kind: 'delete', method: 'POST', href: '#', confirm_message: 'Delete Beta?' }
                                    ]
                                } %}
                            </td>
                        </tr>
                        <tr>
                            <td>3</td>
                            <td>Gamma (icon + text)</td>
                            <td>
                                {% include '@NowoUiKitBundle/partials/_row_actions.html.twig' with {
                                    display: 'icon_text',
                                    actions: [
                                        { kind: 'copy', href: '#' },
                                        { kind: 'view', href: '#' },
                                        { kind: 'config', href: '#' }
                                    ]
                                } %}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            {% if pagination is defined %}
                {% include '@NowoUiKitBundle/partials/_pagination.html.twig' with {
                    pagination: pagination,
                    item_count: item_count|default(2),
                    route: route|default('nowo_ui_kit_kitchen_sink'),
                    route_params: route_params|default({}),
                    query: query|default({})
                } %}
            {% endif %}
        </section>

        <section id="feedback" class="nowo-ui-body">
            <ul class="{{ ui.list() }}">
                <li class="{{ ui.list_item() }}"><span>Item A</span><span class="{{ ui.badge('info') }}">3</span></li>
                <li class="{{ ui.list_item() }}"><span>Item B</span><span class="{{ ui.badge('warning') }}">1</span></li>
            </ul>
            {% include '@NowoUiKitBundle/partials/_empty.html.twig' %}
        </section>

        <section id="orbs" class="nowo-ui-body">
            {% include '@NowoUiKitBundle/partials/_page_header.html.twig' with {
                title: 'Thinking orbs',
                intro: 'Local canvas orbs (MIT thinking-orbs engine). Size 64 / inline 20.'
            } %}
            <div class="nowo-ui-orb-row">
                {% for state in ['working', 'searching', 'solving', 'listening', 'connecting', 'weaving', 'composing', 'breathing', 'shaping'] %}
                    <div class="nowo-ui-orb-row__item">
                        {% include '@NowoUiKitBundle/partials/_thinking_orb.html.twig' with { state: state, size: 64 } %}
                        <p class="nowo-ui-orb-row__caption">{{ state }}</p>
                    </div>
                {% endfor %}
            </div>
            <p class="{{ ui.muted() }}" style="margin-top: 1rem;">
                Inline
                {% include '@NowoUiKitBundle/partials/_thinking_orb.html.twig' with { state: 'searching', size: 20 } %}
                searching…
            </p>
        </section>

        {% set modal_footer %}
            <button type="button" class="{{ ui.btn('secondary') }}" {{ ui.modal_dismiss_attrs() }}>Close</button>
        {% endset %}
        {% include '@NowoUiKitBundle/partials/_modal_shell.html.twig' with {
            id: 'nowo-ui-kit-demo-modal',
            title: 'Demo modal',
            body: '<p>Modal body content.</p>',
            footer: modal_footer
        } %}

        {% set confirm_footer %}
            <button type="button" class="{{ ui.btn('secondary') }}" {{ ui.confirm_dismiss_attrs() }}>{{ 'action.cancel'|trans({}, 'NowoUiKitBundle') }}</button>
            <button type="button" class="{{ ui.btn('danger') }}" {{ ui.confirm_dismiss_attrs() }}>{{ 'action.delete'|trans({}, 'NowoUiKitBundle') }}</button>
        {% endset %}
        {% include '@NowoUiKitBundle/partials/_confirm.html.twig' with {
            id: 'nowo-ui-kit-demo-confirm',
            title: 'Delete item?',
            body: '<p>This action cannot be undone. Host forms should POST with CSRF.</p>',
            footer: confirm_footer
        } %}
    {% endset %}

    {% set header_end %}
        {% include '@NowoUiKitBundle/partials/_width_toggle.html.twig' with { compact: true } %}
        {% include '@NowoUiKitBundle/partials/_theme_toggle.html.twig' with { compact: true } %}
        {% include '@NowoUiKitBundle/partials/_locale_switcher.html.twig' with {
            compact: true,
            current: 'en',
            locales: [
                { code: 'en', label: 'English', href: '#', current: true },
                { code: 'es', label: 'Español', href: '#' },
                { code: 'de', label: 'Deutsch', href: '#' }
            ]
        } %}
    {% endset %}

    {% set brand_html %}
        {% include '@NowoUiKitBundle/partials/_brand.html.twig' with { name: 'Nowo UiKit', href: '#' } %}
    {% endset %}

    {% include '@NowoUiKitBundle/partials/_shell.html.twig' with {
        brand_html: brand_html,
        header_end: header_end,
        aside_label: 'nav.aside'|trans({}, 'NowoUiKitBundle'),
        aside_items: [
            { label: 'Kitchen sink', href: '#buttons', current: true },
            {
                label: 'Sections',
                open: true,
                children: [
                    { label: 'Table', href: '#table' },
                    { label: 'Feedback', href: '#feedback' }
                ]
            }
        ],
        name: 'Demo User',
        email: 'demo@example.com',
        initials: 'DU',
        user_links: [
            { label: 'Preferences', href: '#', current: false },
            { label: 'Dashboard', href: '#' }
        ],
        logout_href: '#logout',
        footer_brand: 'Nowo UiKit',
        footer_links: [
            { label: 'Privacy', href: '#' },
            { label: 'Terms', href: '#' }
        ],
        footer_copyright: '© 2026 Nowo.tech',
        main: sink_main
    } %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/nowo-ui-modal.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/nowo-ui-shell.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/nowo-ui-toast.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/nowo-ui-confirm.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/nowo-ui-page-loader.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/nowo-ui-theme.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/nowo-ui-orb.js', 'nowo_ui_kit') }}" defer></script>
{% endblock %}
