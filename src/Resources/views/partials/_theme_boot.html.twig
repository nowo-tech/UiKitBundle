{#
  Pre-paint theme boot (1.15) — include in <head> before any stylesheet. Runs synchronously and sets
  data-theme (+ data-bs-theme, 2.15.4; <html data-nowo-ui-bs-theme="off"> opts out) / data-ui-density / data-motion / data-font-scale / data-contrast on <html> from the
  preference attributes the host prints on <html> (data-nowo-ui-pref-theme, -density, -motion,
  -font-scale, -contrast, -sidebar), falling back to the stored theme (data-nowo-ui-theme-cookie, then
  data-nowo-ui-theme-storage localStorage key) and the OS. See docs/USAGE.md#pre-paint-theme-boot.

  Optional:
    - inline: true (default) prints the script inline (no extra request, needs the CSP nonce);
      false emits <script src> for `js/nowo-ui-theme-boot.js` (allow the asset origin in script-src)
    - nonce: CSP nonce (default: request attribute `csp_nonce` when set)
    - src: script URL when inline is false (default: the bundle asset)
#}
{% set _request = app is defined and app ? app.request : null %}
{% set _nonce = nonce|default(_request ? _request.attributes.get('csp_nonce') : null) %}
{% if inline is not defined or inline %}
<script{% if _nonce %} nonce="{{ _nonce }}"{% endif %} data-nowo-ui-theme-boot>{{ source('@NowoUiKitBundle/inline/nowo-ui-theme-boot.js')|raw }}</script>
{% else %}
<script src="{{ src|default(asset('js/nowo-ui-theme-boot.js', 'nowo_ui_kit')) }}"{% if _nonce %} nonce="{{ _nonce }}"{% endif %} data-nowo-ui-theme-boot></script>
{% endif %}
