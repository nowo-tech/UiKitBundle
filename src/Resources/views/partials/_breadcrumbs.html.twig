{#
  Breadcrumbs of a View\PageHeader (REQ-UI-003): BreadcrumbKit's breadcrumb_render() when installed and enabled
  (nowo_ui_kit.breadcrumbs.breadcrumb_kit), else the plain trail from header.breadcrumbs.
  header.breadcrumbsMode (2.2): auto (BreadcrumbKit's trail, or header.breadcrumbs when the kit renders nothing),
  kit (BreadcrumbKit only), own (header.breadcrumbs only). BreadcrumbKit's output is wrapped in a plain
  <div class="nowo-ui-breadcrumbs" data-nowo-ui-breadcrumbs="kit"> without the slot's host classes / attributes
  (2.2: the kit's own <nav> already carries them).

  Required:
    - header: View\PageHeader

  Optional:
    - bundle
  Slots: breadcrumbs (root), breadcrumb_link (crumb links), breadcrumb_separator (the "/" before every item but the
  first, aria-hidden; host overrides without it keep the CSS separator).
#}
{% set bundle = bundle|default(null) %}
{% set _mode = header.breadcrumbsMode ?? 'auto' %}
{% set _kit = _mode != 'own' and nowo_ui_breadcrumb_kit_available() ? nowo_ui_breadcrumb_kit(header.breadcrumbCollection)|trim : '' %}
{% if _kit is not same as('') %}
    <div class="nowo-ui-breadcrumbs" data-nowo-ui-breadcrumbs="kit">{{ _kit|raw }}</div>
{% elseif _mode != 'kit' and header.breadcrumbs is not empty %}
    <nav class="{{ nowo_ui_class('breadcrumbs', bundle) }}" aria-label="{{ 'breadcrumbs.nav'|trans({}, 'NowoUiKitBundle') }}"{{ nowo_ui_attrs('breadcrumbs', bundle) }}>
        <ol class="nowo-ui-breadcrumbs__list">
            {% for crumb in header.breadcrumbs %}
                <li class="nowo-ui-breadcrumbs__item">
                    {%- if not loop.first %}<span class="{{ nowo_ui_class('breadcrumb_separator', bundle) }}" aria-hidden="true"{{ nowo_ui_attrs('breadcrumb_separator', bundle) }}>/</span>{% endif %}
                    {% if crumb.href and not loop.last %}
                        <a class="{{ nowo_ui_class('breadcrumb_link', bundle) }}" href="{{ crumb.href }}"{{ nowo_ui_attrs('breadcrumb_link', bundle) }}>{{ crumb.label|nowo_ui_trans }}</a>
                    {% else %}
                        <span class="nowo-ui-breadcrumbs__current"{% if loop.last %} aria-current="page"{% endif %}>{{ crumb.label|nowo_ui_trans }}</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </nav>
{% endif %}
