{#
  Left aside / sidebar navigation.

  Optional:
    - id: HTML id (default nowo-ui-aside)
    - label: section label
    - items: list of { label, href, current?: bool, attr?: {} }
    - framework
#}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set framework = framework|default(null) %}
{% set id = id|default('nowo-ui-aside') %}
{% set label = label|default('nav.aside'|trans({}, 'NowoUiKitBundle')) %}
<aside id="{{ id }}" class="{{ ui.aside(framework) }}" data-nowo-ui-aside aria-label="{{ label }}">
    <div class="nowo-ui-aside__inner">
        {% if label %}
            <p class="nowo-ui-aside__label">{{ label }}</p>
        {% endif %}
        <nav class="nowo-ui-aside__nav">
            {% for item in items|default([]) %}
                {% set is_current = item.current|default(false) %}
                <a
                    class="nowo-ui-aside__link{{ is_current ? ' is-current' : '' }}"
                    href="{{ item.href }}"
                    {% if is_current %}aria-current="page"{% endif %}
                    {% if item.attr is defined %}
                        {% for name, value in item.attr %}{{ name }}="{{ value }}" {% endfor %}
                    {% endif %}
                >{{ item.label }}</a>
            {% endfor %}
        </nav>
        {% if aside_extra is defined and aside_extra %}
            <div class="nowo-ui-aside__extra">{{ aside_extra|raw }}</div>
        {% endif %}
    </div>
</aside>
