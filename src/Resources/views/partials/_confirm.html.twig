{#
  Accessible confirm <dialog> (destructive actions). Host supplies POST+CSRF in footer/body.

  Required:
    - id (optional with confirm: falls back to confirm.id)
    - title (or confirm)

  Optional:
    - body (HTML string)
    - footer (HTML string; default Cancel button)
    - cancel_label
    - framework
    - confirm (2.0 contract): View\Confirm — title / message / confirm + cancel labels / variant / expectedValue
      (type-to-confirm input: the confirm button stays disabled until the value matches, nowo-ui-confirm.js)
    - action + action_href (2.0): non-GET View\Action submitted by the confirm button (POST form in the footer)
    - bundle: per-bundle theme exceptions (slot `confirm` classes / attributes; host classes of confirm_panel,
      confirm_header, confirm_title, confirm_body, confirm_message, confirm_expect_label, confirm_footer)
  Buttons read the theme slots btn_secondary (cancel) and btn_<variant> (confirm) when the ThemeExtension is
  loaded (1.x output unchanged with an empty theme; framework_defaults honoured); the expected-value input reads
  the `input` slot.
#}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set framework = framework|default(null) %}
{% set bundle = bundle|default(null) %}
{% set _t = nowo_ui_theme|default(null) %}
{% set _pt = nowo_ui_page_type|default(null) %}
{% set _extra = _t ? _t.extraClasses('confirm', bundle, _pt) : '' %}
{% set _confirm = confirm|default(null) %}
{% set _message = null %}
{% set _confirm_label = null %}
{% if _confirm %}
    {% set id = id|default(_confirm.id) %}
    {% set title = _confirm.title.key is defined ? _confirm.title.key|trans(_confirm.title.params, _confirm.title.domain) : _confirm.title %}
    {% if _confirm.message is not null %}
        {% set _message = _confirm.message.key is defined ? _confirm.message.key|trans(_confirm.message.params, _confirm.message.domain) : _confirm.message %}
    {% endif %}
    {% if _confirm.cancelLabel is not null %}
        {% set cancel_label = _confirm.cancelLabel.key is defined ? _confirm.cancelLabel.key|trans(_confirm.cancelLabel.params, _confirm.cancelLabel.domain) : _confirm.cancelLabel %}
    {% endif %}
    {% set _confirm_label = _confirm.confirmLabel is null ? 'action.confirm'|trans({}, 'NowoUiKitBundle') : (_confirm.confirmLabel.key is defined ? _confirm.confirmLabel.key|trans(_confirm.confirmLabel.params, _confirm.confirmLabel.domain) : _confirm.confirmLabel) %}
{% endif %}
{% set cancel_label = cancel_label|default('action.cancel'|trans({}, 'NowoUiKitBundle')) %}
<dialog
    id="{{ id }}"
    class="nowo-ui-confirm{{ _extra ? ' ' ~ _extra }}"
    data-nowo-ui-confirm
    aria-labelledby="{{ id }}-title"
    {{- _t ? _t.renderAttributes('confirm', bundle, {}, _pt)|raw }}
>
    <div class="{{ _t ? _t.macroClasses('confirm_panel', 'nowo-ui-confirm__panel', bundle, _pt) : 'nowo-ui-confirm__panel' }}">
        <header class="{{ _t ? _t.macroClasses('confirm_header', 'nowo-ui-confirm__header', bundle, _pt) : 'nowo-ui-confirm__header' }}">
            <h2 class="{{ _t ? _t.macroClasses('confirm_title', 'nowo-ui-confirm__title', bundle, _pt) : 'nowo-ui-confirm__title' }}" id="{{ id }}-title">{{ title }}</h2>
        </header>
        {% if _message is not null %}
            <div class="{{ _t ? _t.macroClasses('confirm_body', 'nowo-ui-confirm__body', bundle, _pt) : 'nowo-ui-confirm__body' }}"><p class="{{ _t ? _t.macroClasses('confirm_message', 'nowo-ui-confirm__message', bundle, _pt) : 'nowo-ui-confirm__message' }}">{{ _message }}</p></div>
        {% elseif body is defined and body %}
            <div class="{{ _t ? _t.macroClasses('confirm_body', 'nowo-ui-confirm__body', bundle, _pt) : 'nowo-ui-confirm__body' }}">{{ body|raw }}</div>
        {% endif %}
        {% set _expected = _confirm ? _confirm.expectedValue : null %}
        {% if _expected is not null %}
            {% set _expected_label = _confirm.expectedLabel is null ? 'confirm.type_to_confirm'|trans({'%value%': _expected}, 'NowoUiKitBundle') : (_confirm.expectedLabel.key is defined ? _confirm.expectedLabel.key|trans(_confirm.expectedLabel.params|merge({'%value%': _expected}), _confirm.expectedLabel.domain) : _confirm.expectedLabel) %}
            <div class="nowo-ui-confirm__expect">
                <label class="{{ _t ? _t.macroClasses('confirm_expect_label', 'nowo-ui-confirm__expect-label', bundle, _pt) : 'nowo-ui-confirm__expect-label' }}" for="{{ id }}-expected">{{ _expected_label }}</label>
                <input id="{{ id }}-expected" class="{{ _t ? _t.classFor('input', bundle, framework, _pt) : 'nowo-ui-input' }} nowo-ui-confirm__expect-input" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" required pattern="{{ _confirm.expectedPattern() }}" data-nowo-confirm-expected="{{ _expected }}"{% if action is defined and action %} form="{{ id }}-form"{% endif %}>
            </div>
        {% endif %}
        <div class="{{ _t ? _t.macroClasses('confirm_footer', 'nowo-ui-confirm__footer', bundle, _pt) : 'nowo-ui-confirm__footer' }}">
            {% if footer is defined and footer %}
                {{ footer|raw }}
            {% else %}
                <button type="button" class="{{ _t ? _t.macroClasses('btn_secondary', ui.btn('secondary', null, framework), bundle, _pt) : ui.btn('secondary', null, framework) }}" data-nowo-confirm-close>
                    {{ cancel_label }}
                </button>
                {% if _confirm and action is defined and action %}
                    {{ include('@NowoUiKitBundle/partials/_action_post.html.twig', {
                        action: action,
                        action_href: action_href|default(action.href),
                        button_class: (_t ? _t.macroClasses('btn_' ~ _confirm.variant, ui.btn(_confirm.variant, null, framework), bundle, _pt) : ui.btn(_confirm.variant, null, framework)) ~ ' nowo-ui-confirm__submit',
                        button_attrs: _expected is null ? {} : {'data-nowo-confirm-submit': true, disabled: not action.disabled},
                        button_html: _confirm_label,
                        form_id: _expected is null ? null : id ~ '-form',
                    }, false) }}
                {% endif %}
            {% endif %}
        </div>
    </div>
</dialog>
