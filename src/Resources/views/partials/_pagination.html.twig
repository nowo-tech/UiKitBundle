{#
  Server-side table pagination (never client DataTables paging).

  Required:
    - pagination: {page, per_page, total, total_pages} OR (2.0 contract) a View\Pagination object
      (route / query / route_params / page_param / per_page_param taken from it when not passed)
    - item_count: number of rows on the current page (optional with a View\Pagination: computed)

  Route resolution:
    - route (+ route_params), OR omit route to use the current request route

  Optional:
    - query: extra query params preserved across pages (filters)
    - nav_label: aria-label translation key (default pagination.nav)
    - trans_domain (default NowoUiKitBundle) for showing/previous/next
    - nav_trans_domain (default = trans_domain) for aria-label
    - framework: css_framework override for macros
    - region: data-nowo-ui-region on the root (scaffolds pass `pagination`)
    - pagination_model (scaffolds): the View\Pagination when `pagination` is its 1.x array (toArray())
    - page_param / per_page_param: query parameter names (default from `pagination`, else page / per_page)
    - per_page_choices (2.4): list of per-page values linked after the info line ("Per page: 10 25 50 100"; choosing
      one goes back to page 1); per_page_selector: true uses the View\Pagination's allowedPerPage
      (Pagination::fromTotal()). Default: none (unchanged output).
  The list scaffold also passes the 1.x top-level route, route_params and query (current request query without the
  page parameters, merged with Pagination::query), so a 1.x override keeps the filters across pages.
    - bundle: per-bundle theme exceptions (slots pagination, pagination_link, pagination_active, pagination_info
      add host classes; slot pagination attributes on the root)
    - variant (2.6): `compact` (default: the View\Pagination's variant, else `full`) renders the `pagination_compact`
      partial with the same input instead (previous / "Page n of m" / next + per-page select)
#}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set bundle = bundle|default(null) %}
{% set _variant = variant|default(pagination_model is defined and pagination_model ? pagination_model.variant : (pagination is iterable ? pagination.variant|default('full') : pagination.variant)) %}
{% if _variant == 'compact' %}
    {{ include(nowo_ui_theme is defined and nowo_ui_theme ? nowo_ui_theme.partial('pagination_compact', bundle) : '@NowoUiKitBundle/partials/_pagination_compact.html.twig', {pagination: pagination_model is defined and pagination_model ? pagination_model : pagination}) }}
{% else %}
{% set _t = nowo_ui_theme|default(null) %}
{% set _pt = nowo_ui_page_type|default(null) %}
{% set per_page_choices = per_page_choices|default(per_page_selector|default(false) and pagination is not iterable ? pagination.allowedPerPage : []) %}
{% if pagination is not iterable %}
    {% set item_count = item_count|default(pagination.to() - pagination.from() + 1) %}
    {% set pagination = pagination.toArray() %}
{% endif %}
{% set query = query|default(pagination.query|default({})) %}
{% set nav_label = nav_label|default('pagination.nav') %}
{% set framework = framework|default(null) %}
{% set trans_domain = trans_domain|default('NowoUiKitBundle') %}
{% set nav_trans_domain = nav_trans_domain|default(trans_domain) %}
{% set route = route|default(pagination.route|default(app.request.attributes.get('_route'))) %}
{% set route_params = route_params|default(pagination.route_params|default(app.request.attributes.get('_route_params')|default({}))) %}
{% set page_param = page_param|default(pagination.page_param|default('page')) %}
{% set per_page_param = per_page_param|default(pagination.per_page_param|default('per_page')) %}
{% set _info_extra = _t ? _t.extraClasses('pagination_info', bundle, _pt) : '' %}
{% set _link_class = _t ? _t.macroClasses('pagination_link', 'page-link nowo-ui-pagination__link', bundle, _pt) : 'page-link nowo-ui-pagination__link' %}
{% set _disabled_class = _t ? _t.macroClasses('pagination_link', 'page-link nowo-ui-pagination__link is-disabled', bundle, _pt) : 'page-link nowo-ui-pagination__link is-disabled' %}
{% set _active_class = _t ? _t.macroClasses('pagination_active', 'page-link nowo-ui-pagination__link is-active', bundle, _pt) : 'page-link nowo-ui-pagination__link is-active' %}
{% set page = pagination.page|default(1) %}
{% set per_page = pagination.per_page|default(25) %}
{% set total = pagination.total|default(0) %}
{% set total_pages = pagination.total_pages|default(1) %}
{% if total_pages < 1 %}
    {% set total_pages = 1 %}
{% endif %}
{% if total > 0 %}
    {% set from = (page - 1) * per_page + 1 %}
    {% set to = (page - 1) * per_page + item_count %}
    {% set base_params = route_params|merge(query)|merge({(per_page_param): per_page}) %}
    <div class="{{ _t ? _t.macroClasses('pagination', ui.pagination_wrap(framework), bundle, _pt) : ui.pagination_wrap(framework) }}"{{ _t ? _t.renderAttributes('pagination', bundle, {}, _pt)|raw }}{% if region|default(null) %} data-nowo-ui-region="{{ region }}"{% endif %}>
        <p class="nowo-ui-pagination__info{{ _info_extra ? ' ' ~ _info_extra }}">
            {{ 'pagination.showing'|trans({'%from%': from, '%to%': to, '%total%': total}, trans_domain) }}
        </p>
        {% if per_page_choices is not empty %}
            <p class="nowo-ui-pagination__per-page" data-nowo-ui-region="per-page">
                <span class="nowo-ui-pagination__per-page-label">{{ 'pagination.per_page'|trans({}, trans_domain) }}</span>
                {% for _choice in per_page_choices %}
                    {% if _choice == per_page %}
                        <span class="{{ _active_class }}" aria-current="true">{{ _choice }}</span>
                    {% else %}
                        <a class="{{ _link_class }}" href="{{ path(route, base_params|merge({(per_page_param): _choice, (page_param): 1})) }}">{{ _choice }}</a>
                    {% endif %}
                {% endfor %}
            </p>
        {% endif %}
        {% if total_pages > 1 %}
            <nav class="nowo-ui-pagination__nav" aria-label="{{ nav_label|trans({}, nav_trans_domain) }}">
                <ul class="pagination">
                    <li class="page-item{% if page <= 1 %} disabled{% endif %}">
                        {% if page > 1 %}
                            <a class="{{ _link_class }}" href="{{ path(route, base_params|merge({(page_param): page - 1})) }}" aria-label="{{ 'pagination.previous'|trans({}, trans_domain) }}">«</a>
                        {% else %}
                            <span class="{{ _disabled_class }}" aria-disabled="true" aria-label="{{ 'pagination.previous'|trans({}, trans_domain) }}">«</span>
                        {% endif %}
                    </li>

                    {% for p in 1..total_pages %}
                        {% if p == page %}
                            <li class="page-item active" aria-current="page">
                                <span class="{{ _active_class }}">{{ p }}</span>
                            </li>
                        {% elseif p == 1 or p == total_pages or (p >= page - 2 and p <= page + 2) %}
                            <li class="page-item">
                                <a class="{{ _link_class }}" href="{{ path(route, base_params|merge({(page_param): p})) }}">{{ p }}</a>
                            </li>
                        {% elseif p == page - 3 or p == page + 3 %}
                            <li class="page-item disabled" aria-hidden="true">
                                <span class="page-link nowo-ui-pagination__ellipsis">…</span>
                            </li>
                        {% endif %}
                    {% endfor %}

                    <li class="page-item{% if page >= total_pages %} disabled{% endif %}">
                        {% if page < total_pages %}
                            <a class="{{ _link_class }}" href="{{ path(route, base_params|merge({(page_param): page + 1})) }}" aria-label="{{ 'pagination.next'|trans({}, trans_domain) }}">»</a>
                        {% else %}
                            <span class="{{ _disabled_class }}" aria-disabled="true" aria-label="{{ 'pagination.next'|trans({}, trans_domain) }}">»</span>
                        {% endif %}
                    </li>
                </ul>
            </nav>
        {% endif %}
    </div>
{% endif %}
{% endif %}
