{#
  Key figures row (2.21, theme partial `stat_row`): one compact row of View\Stat tiles — label over value, optional
  hint — above the details of a record (ShowPage::stats). A <dl>: each tile is a <div> with its <dt> / <dd>.
  Values are printed escaped; Stat::href makes the value a link; Stat::tone colours it (nowo-ui-stat--<tone>).

  Required:
    - items: list<View\Stat>
  Optional:
    - label: accessible name of the row (aria-label; View\Label or string)
    - attr: extra root attributes (no on*), bundle, nowo_ui_page_type
  2.23: View\Stat::attributes on the tile <div>, Stat::valueAttributes on the value <dd> (escaped, no on*; empty =
  unchanged markup), for hosts that update figures live (data-uptime-24h…).
  Slots: stat_row, stat, stat_label, stat_value, stat_hint. Tokens: --nowo-ui-stat-min-width, --nowo-ui-stat-gap,
  --nowo-ui-stat-bg, --nowo-ui-stat-border, --nowo-ui-stat-value-size (light / dark through the base tokens).
#}
{% set _b = bundle|default(null) %}
{% set _label = label|default(null) %}
<dl class="{{ nowo_ui_class('stat_row', _b) }}{{ (attr.class ?? false) ? ' ' ~ attr.class }}" data-nowo-ui-region="stats"{% if _label %} aria-label="{{ _label|nowo_ui_trans }}"{% endif %}{{ nowo_ui_attrs('stat_row', _b) }}{{ nowo_ui_html_attrs(nowo_ui_attrs_without_class(attr|default({}))) }}>
    {% for stat in items %}
        <div class="{{ nowo_ui_class('stat', _b) }} nowo-ui-stat--{{ stat.tone }}{{ (stat.attributes.class ?? false) ? ' ' ~ stat.attributes.class }}"{{ nowo_ui_attrs('stat', _b) }}{{ nowo_ui_html_attrs(nowo_ui_attrs_without_class(stat.attributes ?? {})) }}>
            <dt class="{{ nowo_ui_class('stat_label', _b) }}">{{ stat.label|nowo_ui_trans }}</dt>
            <dd class="{{ nowo_ui_class('stat_value', _b) }}{{ (stat.valueAttributes.class ?? false) ? ' ' ~ stat.valueAttributes.class }}"{{ nowo_ui_html_attrs(nowo_ui_attrs_without_class(stat.valueAttributes ?? {})) }}>{% if stat.href %}<a href="{{ stat.href }}">{{ stat.value|nowo_ui_trans }}</a>{% else %}{{ stat.value|nowo_ui_trans }}{% endif %}</dd>
            {% if stat.hint is not null %}
                <dd class="{{ nowo_ui_class('stat_hint', _b) }}">{{ stat.hint|nowo_ui_trans }}</dd>
            {% endif %}
        </div>
    {% endfor %}
</dl>
