{#
  Filter / search actions bar.

  Optional:
    - action: form action URL
  2.19 (REQ-TWIG-005): the form renders through form_start / form_end (same method, action, field name q_name,
  input id nowo-ui-filter-q, classes); the raw form is a deprecated fallback without symfony/form.
    - method: get|post (default get)
    - q: current search value
    - q_name: input name (default q)
    - placeholder
    - actions: HTML string (extra buttons)
    - clear_href: clear filters link
    - framework
    - collapsible (1.17, default false): foldable card — partials/_filters_collapse.html.twig as the first child
      (the active count is 1 when `q` is set)
    - collapse (1.17): options for _filters_collapse (fold_key, fold_cookie, folded, active_count, morph, icons,
      labels, testids)
#}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set framework = framework|default(null) %}
{% set method = method|default('get') %}
{% set q_name = q_name|default('q') %}
{% set placeholder = placeholder|default('filters.search_placeholder'|trans({}, 'NowoUiKitBundle')) %}
{#- 2.19 (REQ-TWIG-005): form_start / form_end of a GET search Form Type (Form\SearchFilterType, field q_name);
    without symfony/form the deprecated raw form (_filters_legacy) -#}
{% if nowo_ui_theme is defined %}
    {{ include('@NowoUiKitBundle/partials/_ui_form.html.twig', _context|merge({ui_form_kind: 'search', ui_form_options: {q_name: q_name, q: q|default('') ~ '', placeholder: placeholder ~ '', input_class: ui.search_input(framework) ~ '', partial: 'filters'}, ui_form_template: '@NowoUiKitBundle/partials/_filters_form.html.twig', ui_form_legacy: '@NowoUiKitBundle/partials/_filters_legacy.html.twig'}), false) }}
{% else %}
    {{ include('@NowoUiKitBundle/partials/_filters_legacy.html.twig', _context, false) }}
{% endif %}
