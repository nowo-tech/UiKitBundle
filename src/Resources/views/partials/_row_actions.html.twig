{#
  Canonical row-action cluster (REQ-UI-001).

  Required:
    - actions: list of action hashes (see below) and/or (2.0 contract) View\Action objects — objects render
      through the `action` theme partial (route resolution, POST form or confirm <dialog>, no inline handlers);
      a hash with a `view` key (View\Action) renders that object (the list scaffold passes 1.x hashes + `view`)

  Optional:
    - framework: css_framework override
    - display: icon | text | icon_text (defaults to nowo_ui_kit_row_actions_display)
    - confirm_external (2.0): true when the confirm dialogs of the actions are rendered elsewhere (the list scaffold
      renders them once after the table): actions with a Confirm print only their toggle button
    - bundle (2.0): per-bundle theme exceptions (slots row_actions, action, action_primary | action_secondary |
      action_danger | action_neutral (by resolved variant: delete = danger, create / save = primary, other kinds
      neutral, explicit variants as given): host classes; row_action_disabled (disabled actions): host classes
      on 1.x hashes, semantic + host classes on objects; row_actions attributes)
    - menu (2.4, bool, default false): the actions go into one overflow menu (the `menu` partial, toggle label
      menu_label, default "More actions") instead of a button cluster. View\Action objects (and hashes with `view`)
      keep their POST / confirm / dialog behaviour; 1.x hashes become GET links (POST hashes need a View\Action).
    - popover (2.4, bool; default theme.popover_menus): with `menu`, the panel is a native [popover] (top layer, never
      clipped by the table scroller)

  Each action:
    kind          edit|delete|view|copy|create|save|cancel|restore|share|config|export|filter|prev|next|close
                  (drives nowo-ui-action--{kind}, default btn variant, default icon + i18n key action.{kind})
    href          GET link or POST form action URL
    label         visible / aria label (default: action.{kind}|trans NowoUiKitBundle)
    icon          override icon name for _icon (default: kind)
    variant       override btn variant (primary|secondary|danger|…)
    method        GET (default) | POST
    tag           auto (default) | a | button | form
                  auto → form if method=POST; button if confirm_id/modal_id and no href; else a
                  form (2.19, REQ-TWIG-005): form_start / form_end of a hidden-field Form Type (same URL, POST,
                  csrf_field / csrf_token, attributes); raw markup only without symfony/form (deprecated)
    csrf_token    when method=POST
    csrf_field    CSRF field name (default _token)
    confirm_id    UiKit _confirm target (data-nowo-confirm-*)
    modal_id      framework modal target
    confirm_message  transitional window.confirm on form submit (prefer confirm_id)
    attr          extra HTML attributes (hash)
    disabled      bool
#}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set framework = framework|default(null) %}
{% set display = display|default(nowo_ui_kit_row_actions_display|default('icon')) %}
{% if display not in ['icon', 'text', 'icon_text'] %}
    {% set display = 'icon' %}
{% endif %}
{% set bundle = bundle|default(null) %}
{% set _t = nowo_ui_theme|default(null) %}
{% set _pt = nowo_ui_page_type|default(null) %}
{% set _root = ui.row_actions(framework) ~ ' nowo-ui-row-actions--' ~ display|replace({_: '-'}) %}
{% if menu|default(false) %}
    {% set _menu_items = [] %}
    {% for action in actions %}
        {% if action is not iterable %}
            {% set _menu_items = _menu_items|merge([action]) %}
        {% elseif action.view is defined and action.view %}
            {% set _menu_items = _menu_items|merge([action.view]) %}
        {% elseif (action.visible is not defined or action.visible) and action.href|default(null) and (action.method|default('GET'))|upper == 'GET' %}
            {% set _menu_items = _menu_items|merge([{label: action.label|default(('action.' ~ action.kind|default('edit'))|trans({}, 'NowoUiKitBundle')), href: action.href, danger: action.kind|default('') == 'delete', attr: action.attr|default({})}]) %}
        {% endif %}
    {% endfor %}
<div class="{{ _t ? _t.macroClasses('row_actions', _root ~ ' nowo-ui-row-actions--menu', bundle, _pt) : _root ~ ' nowo-ui-row-actions--menu' }}"{{ _t ? _t.renderAttributes('row_actions', bundle, {}, _pt)|raw }}>
    {{ include(_t ? _t.partial('menu', bundle) : '@NowoUiKitBundle/partials/_menu.html.twig', {items: _menu_items, label: menu_label|default(null), align: 'end', popover: popover ?? null, confirm_external: confirm_external|default(false), bundle: bundle, nowo_ui_page_type: _pt}, false) }}
</div>
{% else %}
<div class="{{ _t ? _t.macroClasses('row_actions', _root, bundle, _pt) : _root }}"{{ _t ? _t.renderAttributes('row_actions', bundle, {}, _pt)|raw }}>
    {% for action in actions %}
        {% if action is not iterable or (action.view is defined and action.view) %}
            {{ include(_t ? _t.partial('action', bundle) : '@NowoUiKitBundle/partials/_action.html.twig', {action: action is iterable ? action.view : action, context: 'row', display: display, framework: framework, bundle: bundle, confirm_external: confirm_external|default(false), nowo_ui_page_type: _pt}, false) }}
        {% elseif action.visible is not defined or action.visible %}
            {% set kind = action.kind|default('edit') %}
            {% set label = action.label|default(('action.' ~ kind)|trans({}, 'NowoUiKitBundle')) %}
            {% set icon_name = action.icon|default(kind) %}
            {% set method = (action.method|default('GET'))|upper %}
            {% set tag = action.tag|default('auto') %}
            {% if tag == 'auto' %}
                {% if method == 'POST' %}
                    {% set tag = 'form' %}
                {% elseif (action.confirm_id is defined and action.confirm_id) or (action.modal_id is defined and action.modal_id) %}
                    {% set tag = action.href is defined and action.href ? 'a' : 'button' %}
                {% else %}
                    {% set tag = 'a' %}
                {% endif %}
            {% endif %}
            {% set _hash_variant = action.variant|default(null) == 'neutral' ? null : action.variant|default(null) %}
            {% set class = _t ? _t.macroClasses('action', ui.action(kind, framework, _hash_variant), bundle, _pt) : ui.action(kind, framework, _hash_variant) %}
            {% if _t %}
                {% set _variant = action.variant|default(null) ?: (kind == 'delete' ? 'danger' : (kind in ['create', 'save'] ? 'primary' : 'neutral')) %}
                {% set _variant_extra = _variant in ['primary', 'secondary', 'danger', 'neutral'] ? _t.extraClasses('action_' ~ _variant, bundle, _pt) : '' %}
                {% set class = class ~ (_variant_extra ? ' ' ~ _variant_extra) %}
            {% endif %}
            {% set disabled = action.disabled|default(false) %}
            {% if disabled and _t %}
                {% set _disabled_extra = _t.extraClasses('row_action_disabled', bundle, _pt) %}
                {% set class = class ~ (_disabled_extra ? ' ' ~ _disabled_extra) %}
            {% endif %}

            {% if tag == 'form' %}
                {#- 2.19 (REQ-TWIG-005): a POST hash renders through form_start / form_end (Form\HiddenFieldsType with the
                    csrf_token in csrf_field, via _ui_form); without symfony/form the deprecated raw form (_row_actions_legacy) -#}
                {% set _row_vars = {action: action, class: class, label: label, disabled: disabled, display: display, icon_name: icon_name} %}
                {% if nowo_ui_theme is defined %}
                    {{ include('@NowoUiKitBundle/partials/_ui_form.html.twig', _row_vars|merge({ui_form_kind: 'hidden', ui_form_options: {fields: action.csrf_token is defined and action.csrf_token ? {(action.csrf_field|default('_token')): action.csrf_token} : {}, partial: 'row_actions'}, ui_form_template: '@NowoUiKitBundle/partials/_row_actions_form.html.twig', ui_form_legacy: '@NowoUiKitBundle/partials/_row_actions_legacy.html.twig'}), false) }}
                {% else %}
                    {{ include('@NowoUiKitBundle/partials/_row_actions_legacy.html.twig', _row_vars, false) }}
                {% endif %}
            {% elseif tag == 'button' %}
                <button
                    type="button"
                    class="{{ class }}"
                    title="{{ label }}"
                    aria-label="{{ label }}"
                    {% if disabled %}disabled{% endif %}
                    {% if action.confirm_id is defined and action.confirm_id %}
                        {{ ui.confirm_toggle_attrs() }}
                        {{ ui.confirm_target_attr(action.confirm_id) }}
                    {% endif %}
                    {% if action.modal_id is defined and action.modal_id %}
                        {{ ui.modal_toggle_attrs(framework) }}
                        {{ ui.modal_target_attr(action.modal_id, framework) }}
                    {% endif %}
                    {% if action.attr is defined %}
                        {% for name, value in action.attr %}{{ name }}="{{ value }}" {% endfor %}
                    {% endif %}
                >
                    {{ include('@NowoUiKitBundle/partials/_action_inner.html.twig', {
                        display: display,
                        icon_name: icon_name,
                        label: label,
                    }, false) }}
                </button>
            {% else %}
                <a
                    class="{{ class }}{% if disabled %} is-disabled{% endif %}"
                    href="{{ action.href|default('#') }}"
                    title="{{ label }}"
                    aria-label="{{ label }}"
                    {% if disabled %}aria-disabled="true" tabindex="-1"{% endif %}
                    {% if action.confirm_id is defined and action.confirm_id %}
                        {{ ui.confirm_toggle_attrs() }}
                        {{ ui.confirm_target_attr(action.confirm_id) }}
                    {% endif %}
                    {% if action.modal_id is defined and action.modal_id %}
                        {{ ui.modal_toggle_attrs(framework) }}
                        {{ ui.modal_target_attr(action.modal_id, framework) }}
                    {% endif %}
                    {% if action.attr is defined %}
                        {% for name, value in action.attr %}{{ name }}="{{ value }}" {% endfor %}
                    {% endif %}
                >
                    {{ include('@NowoUiKitBundle/partials/_action_inner.html.twig', {
                        display: display,
                        icon_name: icon_name,
                        label: label,
                    }, false) }}
                </a>
            {% endif %}
        {% endif %}
    {% endfor %}
</div>
{% endif %}
