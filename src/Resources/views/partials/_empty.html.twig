{#
  Empty state.

  Optional:
    - message: string (default empty.default translation)
    - framework: css_framework override
    - empty (2.0 contract): View\EmptyState — title, message (labels translated), action (through _action)
    - bundle: per-bundle theme exceptions (slot `empty`)
#}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set framework = framework|default(null) %}
{% set bundle = bundle|default(null) %}
{% set _t = nowo_ui_theme|default(null) %}
{% set _pt = nowo_ui_page_type|default(null) %}
{% set _class = _t ? _t.macroClasses('empty', ui.empty(framework), bundle, _pt) : ui.empty(framework) %}
{% if empty is defined and empty %}
    {% set _title = empty.title is null ? null : (empty.title.key is defined ? empty.title.key|trans(empty.title.params, empty.title.domain) : empty.title) %}
    {% set _message = empty.message is null ? 'empty.default'|trans({}, 'NowoUiKitBundle') : (empty.message.key is defined ? empty.message.key|trans(empty.message.params, empty.message.domain) : empty.message) %}
    <div class="{{ _class }}"{{ _t ? _t.renderAttributes('empty', bundle, {}, _pt)|raw }}>
        {% if _title %}<p class="nowo-ui-empty__title">{{ _title }}</p>{% endif %}
        <p class="nowo-ui-empty__message">{{ _message }}</p>
        {% if empty.action %}
            <div class="nowo-ui-empty__action">{{ include('@NowoUiKitBundle/partials/_action.html.twig', {action: empty.action, context: 'toolbar', framework: framework, bundle: bundle, nowo_ui_page_type: _pt}, false) }}</div>
        {% endif %}
    </div>
{% else %}
<p class="{{ _class }}">{{ message|default('empty.default'|trans({}, 'NowoUiKitBundle')) }}</p>
{% endif %}
