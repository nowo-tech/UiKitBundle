{#
  One level of the `tree` partial (recursive). Variables: nodes, level (1-based), tab_first (the first item gets
  tabindex 0 when no item is current), actions_template, movable, bundle.
#}
{% for node in nodes %}
    {% set _children = node.children|default([]) %}
    {% set _is_parent = _children is not empty or node.has_children|default(false) %}
    {% set _expanded = _is_parent and node.expanded|default(false) %}
    {% set _group_id = 'nowo-ui-tree-' ~ (node.id ~ '')|replace({' ': '_'}) ~ '-group' %}
    <li class="{{ nowo_ui_class('tree_item', bundle) }}" role="none" data-nowo-ui-tree-node="{{ node.id }}"{{ nowo_ui_attrs('tree_item', bundle) }}>
        <div class="nowo-ui-tree__row{{ node.current|default(false) ? ' is-current' }}">
            {%- if _is_parent -%}
                <span class="nowo-ui-tree__toggle" aria-hidden="true" data-nowo-ui-tree-toggle></span>
            {%- else -%}
                <span class="nowo-ui-tree__spacer" aria-hidden="true"></span>
            {%- endif -%}
            <a class="{{ nowo_ui_class('tree_link', bundle) }}" href="{{ node.href }}" role="treeitem" data-nowo-ui-tree-item tabindex="{{ node.current|default(false) or (tab_first and loop.first and level == 1) ? '0' : '-1' }}" aria-level="{{ level }}" aria-setsize="{{ nodes|length }}" aria-posinset="{{ loop.index }}"{% if _is_parent %} aria-expanded="{{ _expanded ? 'true' : 'false' }}" aria-owns="{{ _group_id }}"{% endif %}{% if node.current|default(false) %} aria-current="page"{% endif %}{% if movable %} draggable="true"{% endif %}{{ nowo_ui_attrs('tree_link', bundle) }}>
                {%- if node.icon|default(null) is not null %}<span class="nowo-ui-tree__icon" aria-hidden="true">{{ node.icon }}</span>{% endif -%}
                <span class="nowo-ui-tree__label">{{ node.label|nowo_ui_trans }}</span>
                {%- if node.badge|default(null) is not null %}<span class="nowo-ui-tree__badge">{{ node.badge }}</span>{% endif -%}
            </a>
            {%- if actions_template %}{{ include(actions_template, {node: node}, false) }}{% endif -%}
        </div>
        {%- if _is_parent %}
            <ul class="{{ nowo_ui_class('tree_group', bundle) }}" role="group" id="{{ _group_id }}"{% if not _expanded %} hidden{% endif %}{% if _children is empty and node.children_url|default(null) %} data-nowo-ui-tree-children-url="{{ node.children_url }}"{% endif %}{{ nowo_ui_attrs('tree_group', bundle) }}>
                {%- if _children is not empty %}{{ include('@NowoUiKitBundle/partials/_tree_items.html.twig', {nodes: _children, level: level + 1, tab_first: false, actions_template: actions_template, movable: movable, bundle: bundle}, false) }}{% endif -%}
            </ul>
        {%- endif %}
    </li>
{% endfor %}
