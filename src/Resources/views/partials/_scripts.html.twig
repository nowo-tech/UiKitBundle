{#
  UiKit runtime scripts (2.2, theme partial `scripts`): one deferred <script> per UiKit runtime (modal, confirm, dialog,
  toast, tabs, theme; 2.4: popover, segmented), from UiKit's own asset package (never a CDN). Printed by the UiKit document layout; host
  layouts with their own script list include this partial instead of copying the list, so a runtime added by a later
  UiKit minor (like `dialog` in 2.1) is loaded without touching the host:
      {{ include(nowo_ui_partial('scripts')) }}
  Every runtime is small, idempotent and binds by delegation, so the whole set is printed once per page whatever the
  partials on it (stateless: no per-request registry).

  Optional:
    - script_names: list of runtime names (2.55.1: an empty list prints none of the defaults, only the theme-appended runtimes; omit or pass null for the default nowo_ui_script_names(): modal, confirm, dialog, toast, tabs, theme, popover, segmented; 2.6: autosubmit; 2.26: avatar). Opt-in runtimes are merged by the host: emoji-picker, show-more, tree (2.24), side-panel (2.25), header-crumbs (2.27, the compact breadcrumb collapse), sortable, image-crop (2.43), image-input (2.47), rail (2.48, the rail_toggle partial), combobox (2.53, the combobox partial / ComboboxType); focus-mode (2.55) is added by itself when nowo_ui_kit.theme.focus_mode.enabled is true : script_names: nowo_ui_script_names()|merge(['header-crumbs'])
    - nonce: CSP nonce (default the request attribute csp_nonce)
  2.54: with theme.context_menus the opt-in `context-menu` runtime is appended to the list (once).
  2.65: with theme.pages.list.filters.sheet the opt-in `filter-sheet` runtime is appended to the list (once).
#}
{% set _request = app is defined and app ? app.request : null %}
{% set _nonce = nonce|default(_request ? _request.attributes.get('csp_nonce') : null) %}
{% set _script_names = script_names is defined and script_names is not null ? script_names : nowo_ui_script_names() %}
{% set _t = nowo_ui_theme|default(null) %}
{% if _t and _t.contextMenus is defined and _t.contextMenus() and 'context-menu' not in _script_names %}
    {% set _script_names = _script_names|merge(['context-menu']) %}
{% endif %}
{#- 2.65: the list_filters phone sheet (theme.pages.list.filters.sheet) needs the filter-sheet runtime -#}
{% if _t and _t.listFilters is defined and _t.listFilters().sheet and 'filter-sheet' not in _script_names %}
    {% set _script_names = _script_names|merge(['filter-sheet']) %}
{% endif %}
{% if ((nowo_ui_kit_focus_mode|default({})).enabled ?? false) is same as(true) and 'focus-mode' not in _script_names %}
    {% set _script_names = _script_names|merge(['focus-mode']) %}
{% endif %}
{% for _script in _script_names %}
    <script src="{{ asset('js/nowo-ui-' ~ _script ~ '.js', 'nowo_ui_kit') }}" defer{% if _nonce %} nonce="{{ _nonce }}"{% endif %}></script>
{% endfor %}
