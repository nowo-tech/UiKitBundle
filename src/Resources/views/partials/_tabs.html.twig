{#
  Generic tabs.

  Required:
    - items: list of { label, href, current?: bool, attr?: {} }
    - aria_label: string (already translated) OR defaults to tabs.nav

  Optional:
    - framework

  2.0 contract (REQ-UI-003; 1.x inputs render unchanged):
    - label: also a View\Label (or {key, domain, params}), translated
    - bundle: per-bundle theme exceptions; theme slots tabs (classes + attributes), tab, tab_active
    - region: data-nowo-ui-region on the <nav> (scaffolds pass `tabs`)
    - attr (2.1): root attributes of the <nav> (e.g. {'data-turbo': 'false'} kept from a bundle's 1.x markup), merged
      over the `tabs` slot attributes; true = bare attribute, false / null = omitted, no on* handlers
    - level (2.2): primary (default; slot `tabs`) | secondary (slot `tabs_secondary`: pills / sub-nav for section tabs
      under an area nav — the settings scaffold passes it when PageHeader::tabs is set)
    - icon (2.16): per item, a canonical icon kind or an icon name (`tabler:bug`, see components/_icon). The item then
      renders `<span class="nowo-ui-tabs__icon">` + `<span class="nowo-ui-tabs__label">` and `data-rail-label`; which
      of the two shows is the host's tab style, `data-tab-style` on any ancestor (usually <html>): absent or `text`
      (label only, as before), `icon-text`, `icon` (label visually hidden except on the current tab, shown as a tooltip
      on hover / focus). Items without an icon always show their label.
#}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set framework = framework|default(null) %}
{% set bundle = bundle|default(null) %}
{% set _t = nowo_ui_theme|default(null) %}
{% set _pt = nowo_ui_page_type|default(null) %}
{% set aria_label = aria_label|default('tabs.nav'|trans({}, 'NowoUiKitBundle')) %}
{% set _attr = attr|default({}) %}
{% set _secondary = level|default('primary') == 'secondary' %}
<nav class="{{ _secondary ? (_t ? _t.classFor('tabs_secondary', bundle, framework, _pt) : 'nowo-ui-tabs nowo-ui-tabs--secondary') : (_t ? _t.macroClasses('tabs', ui.tab_list(framework), bundle, _pt) : ui.tab_list(framework)) }}" aria-label="{{ aria_label }}"
    {{- _t ? _t.renderAttributes(_secondary ? 'tabs_secondary' : 'tabs', bundle, _attr, _pt)|raw -}}
    {%- if not _t %}{% for name, value in _attr %}{% if value is same as(true) %} {{ name }}{% elseif value is not null and value is not same as(false) %} {{ name }}="{{ value }}"{% endif %}{% endfor %}{% endif %}
    {%- if region|default(null) %} data-nowo-ui-region="{{ region }}"{% endif %}>
    {% for item in items %}
        {% set is_current = item.current|default(false) %}
        {% set _label = item.label.key is defined ? item.label.key|trans(item.label.params|default({}), item.label.domain|default('messages')) : item.label %}
        {% set _icon = item.icon|default(null) and nowo_ui_kit_icon_set|default('bootstrap-icons') != 'none' ? item.icon : null %}
        <a
            class="{{ _t ? _t.macroClasses(is_current ? 'tab_active' : 'tab', ui.tab_item(is_current, framework), bundle, _pt) : ui.tab_item(is_current, framework) }}"
            href="{{ item.href }}"
            {% if is_current %}aria-current="page"{% endif %}
            {% if _icon %}data-rail-label="{{ _label }}"{% endif %}
            {% if item.attr is defined %}
                {% for name, value in item.attr %}{{ name }}="{{ value }}" {% endfor %}
            {% endif %}
        >{% if _icon %}<span class="nowo-ui-tabs__icon" aria-hidden="true">{{ include('@NowoUiKitBundle/components/_icon.html.twig', {name: _icon, label: _label}, false)|trim|raw }}</span><span class="nowo-ui-tabs__label">{{ _label }}</span>{% else %}{{ _label }}{% endif %}</a>
    {% endfor %}
</nav>
