{#
  Page header: title + optional intro + toolbar slot.

  Required:
    - title: string (or header)

  Optional:
    - intro: string
    - toolbar: HTML string (pre-rendered) OR use block via embed
    - framework
    - header (2.0 contract): View\PageHeader — title / intro (labels translated), breadcrumbs (BreadcrumbKit or
      plain trail), actions (toolbar buttons through _action), back (2.7, `back_link` partial above the title);
      theme slots page_header, page_title, page_intro, toolbar
    - bundle: per-bundle theme exceptions
    - header_actions_rendered (scaffolds): true when `toolbar` already holds the rendered header actions (the
      scaffolds pre-render them, plus FormPage secondary actions, so 1.x overrides that print `toolbar` show them);
      `actions` then lists every View\Action of that toolbar for 2.0 overrides
    - region: data-nowo-ui-region on the root (scaffolds pass `header`)
  2.21: header.status (View\PageStatus) renders through the `page_status` partial next to the title, both inside a
  `page_title_row` wrapper (no wrapper without a status); header.actionsLayout `split` renders header.actions through
  the `header_actions` partial (icon buttons, one primary, the square "more" menu) instead of one button each.
  Breadcrumbs (none when nowo_ui_kit.breadcrumbs.enabled is false, 2.3.1) and actions render through the theme partials `breadcrumbs` and `action`; header.tabs (View\AreaNav,
  2.1) renders under the title row through the `tabs` partial (region `area-nav`, inside nowo-ui-page-header__nav).
  2.27, presentation (`standard` | `compact`; default nowo_ui_header_presentation(), through the `nowo_ui_header`
  global; any value but `standard` / `compact` is ignored, e.g. an unrelated context variable) / title_hidden (only `true`): compact adds the
  root modifier nowo-ui-page-header--compact and data-nowo-ui-page-header="compact", keeps the title as the page's h1
  with `visually-hidden`, and renders no intro, breadcrumbs or back link (the top bar carries the trail); status badge,
  toolbar and tabs stay. data-nowo-ui-page-header-empty marks a compact header with nothing visible left (no toolbar,
  tabs or status), so CSS collapses its box. Host overrides receive `presentation` and `title_hidden`.
#}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set framework = framework|default(null) %}
{% set bundle = bundle|default(null) %}
{% set _t = nowo_ui_theme|default(null) %}
{% set _pt = nowo_ui_page_type|default(null) %}
{% set _hp = nowo_ui_header|default(null) %}
{% set _compact = (title_hidden ?? false) is same as(true) or (_hp ? _hp.isCompact(presentation ?? null) : (presentation ?? null) is same as('compact')) %}
{% if header is defined and header %}
    {% set title = header.title.key is defined ? header.title.key|trans(header.title.params, header.title.domain) : header.title %}
    {% set intro = header.intro is null ? null : (header.intro.key is defined ? header.intro.key|trans(header.intro.params, header.intro.domain) : header.intro) %}
{% endif %}
{% set _toolbar_class = _t ? _t.macroClasses('toolbar', ui.toolbar(framework), bundle, _pt) : ui.toolbar(framework) %}
{% set _header = header is defined and header ? header : null %}
{% set _status = _header and _header.status is defined ? _header.status : null %}
{% set _split = _header and _header.actionsLayout is defined and _header.actionsLayout == 'split' and not header_actions_rendered|default(false) %}
{% set _title_row_open = '' %}
{% set _title_row_close = '' %}
{% set _split_html = '' %}
{% if _status %}
{% set _title_row_open %}<div class="{{ _t ? _t.classFor('page_title_row', bundle, framework, _pt) : 'nowo-ui-page-header__title-row' }}">{% endset %}
{% set _title_row_close %}{{ include(_t ? _t.partial('page_status', bundle) : '@NowoUiKitBundle/partials/_page_status.html.twig', {status: _status, bundle: bundle, nowo_ui_page_type: _pt}, false)|trim|raw }}</div>{% endset %}
{% endif %}
{% if _split %}
{% set _split_html %}{{ include(_t ? _t.partial('header_actions', bundle) : '@NowoUiKitBundle/partials/_header_actions.html.twig', {split: _header.splitActions(), bundle: bundle, nowo_ui_page_type: _pt}, false)|trim|raw }}{% endset %}
{% endif %}
{% if _compact %}
{% set _has_toolbar = (header is defined and header and header.actions is not empty and not header_actions_rendered|default(false)) or (toolbar is defined and toolbar) %}
{% set _has_tabs = header is defined and header and header.tabs is defined and header.tabs and not header.tabs.isEmpty() %}
{% set intro = null %}
{% endif %}
<div class="{{ _t ? _t.macroClasses('page_header', ui.page_header(framework), bundle, _pt) : ui.page_header(framework) }}{{ _compact ? ' nowo-ui-page-header--compact' }}"{{ _t ? _t.renderAttributes('page_header', bundle, {}, _pt)|raw }}{% if _compact %} data-nowo-ui-page-header="compact"{% if not (_has_toolbar or _has_tabs or _status) %} data-nowo-ui-page-header-empty{% endif %}{% endif %}{% if region|default(null) %} data-nowo-ui-region="{{ region }}"{% endif %}>
    <div class="nowo-ui-page-header__text">
        {#- nowo_ui_kit.breadcrumbs.enabled (2.3.1): false drops the trail from every page header. 2.27: compact has none. -#}
        {% if header is defined and header and ((nowo_ui_breadcrumbs ?? {}).enabled ?? true) and not _compact %}
            {{ include(_t ? _t.partial('breadcrumbs', bundle) : '@NowoUiKitBundle/partials/_breadcrumbs.html.twig', {header: header, bundle: bundle, nowo_ui_page_type: _pt}, false) }}
        {% endif %}
        {% if header is defined and header and header.back and not _compact %}
            {{ include(_t ? _t.partial('back_link', bundle) : '@NowoUiKitBundle/partials/_back_link.html.twig', {href: header.back.href, label: header.back.label, testid: header.back.testid, bundle: bundle}, false) }}
        {% endif %}
        {# 2.3: full slot resolution (semantic + framework defaults + host classes), so Bootstrap hosts get the `h3`
           type scale instead of a full-size h1 #}
        {{ _title_row_open }}<h1 class="{{ _t ? _t.classFor('page_title', bundle, framework, _pt) : 'nowo-ui-page-header__title' }}{{ _compact ? ' visually-hidden' }}">{{ title }}</h1>{{ _title_row_close }}
        {% if intro is defined and intro %}
            {% set _intro_extra = _t ? _t.extraClasses('page_intro', bundle, _pt) : '' %}
            <p class="nowo-ui-page-header__intro{{ _intro_extra ? ' ' ~ _intro_extra }}">{{ intro }}</p>
        {% endif %}
    </div>
    {% if header is defined and header and header.actions is not empty and not header_actions_rendered|default(false) %}
        <div class="{{ _toolbar_class }}">
            {% for action in (_split ? [] : header.actions) %}
                {{ include(_t ? _t.partial('action', bundle) : '@NowoUiKitBundle/partials/_action.html.twig', {action: action, context: 'toolbar', framework: framework, bundle: bundle, nowo_ui_page_type: _pt}, false) }}
            {% endfor %}
            {{ _split_html }}{% if toolbar is defined and toolbar %}{{ toolbar|raw }}{% endif %}
        </div>
    {% elseif toolbar is defined and toolbar %}
        <div class="{{ _toolbar_class }}">{{ toolbar|raw }}</div>
    {% endif %}
    {% if header is defined and header and header.tabs is defined and header.tabs and not header.tabs.isEmpty() %}
        {% set _nav = header.tabs %}
        {% set _items = [] %}
        {% for item in _nav.items %}
            {% set _items = _items|merge([{label: item.label, href: item.href, current: item.active, attr: item.attributes, icon: item.icon}]) %}
        {% endfor %}
        <div class="nowo-ui-page-header__nav">
            {{ include(_t ? _t.partial('tabs', bundle) : '@NowoUiKitBundle/partials/_tabs.html.twig', {
                items: _items,
                aria_label: _nav.label is null ? null : (_nav.label.key is defined ? _nav.label.key|trans(_nav.label.params, _nav.label.domain) : _nav.label),
                attr: _nav.attributes,
                region: 'area-nav',
                framework: framework,
                bundle: bundle,
                nowo_ui_page_type: _pt,
            }, false) }}
        </div>
    {% endif %}
</div>
