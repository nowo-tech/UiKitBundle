{#
  Page header: title + optional intro + toolbar slot.

  Required:
    - title: string (or header)

  Optional:
    - intro: string
    - toolbar: HTML string (pre-rendered) OR use block via embed
    - framework
    - header (2.0 contract): View\PageHeader — title / intro (labels translated), breadcrumbs (BreadcrumbKit or
      plain trail), actions (toolbar buttons through _action); theme slots page_header, page_title, page_intro,
      toolbar
    - bundle: per-bundle theme exceptions
#}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set framework = framework|default(null) %}
{% set bundle = bundle|default(null) %}
{% set _t = nowo_ui_theme|default(null) %}
{% if header is defined and header %}
    {% set title = header.title.key is defined ? header.title.key|trans(header.title.params, header.title.domain) : header.title %}
    {% set intro = header.intro is null ? null : (header.intro.key is defined ? header.intro.key|trans(header.intro.params, header.intro.domain) : header.intro) %}
{% endif %}
<div class="{{ _t ? _t.macroClasses('page_header', ui.page_header(framework), bundle) : ui.page_header(framework) }}"{{ _t ? _t.renderAttributes('page_header', bundle)|raw }}>
    <div class="nowo-ui-page-header__text">
        {% if header is defined and header %}
            {{ include('@NowoUiKitBundle/partials/_breadcrumbs.html.twig', {header: header, bundle: bundle}, false) }}
        {% endif %}
        {% set _title_extra = _t ? _t.extraClasses('page_title', bundle) : '' %}
        <h1 class="nowo-ui-page-header__title{{ _title_extra ? ' ' ~ _title_extra }}">{{ title }}</h1>
        {% if intro is defined and intro %}
            {% set _intro_extra = _t ? _t.extraClasses('page_intro', bundle) : '' %}
            <p class="nowo-ui-page-header__intro{{ _intro_extra ? ' ' ~ _intro_extra }}">{{ intro }}</p>
        {% endif %}
    </div>
    {% if header is defined and header and header.actions is not empty %}
        <div class="{{ _t ? _t.macroClasses('toolbar', ui.toolbar(framework), bundle) : ui.toolbar(framework) }}">
            {% for action in header.actions %}
                {{ include('@NowoUiKitBundle/partials/_action.html.twig', {action: action, context: 'toolbar', framework: framework, bundle: bundle}, false) }}
            {% endfor %}
            {% if toolbar is defined and toolbar %}{{ toolbar|raw }}{% endif %}
        </div>
    {% elseif toolbar is defined and toolbar %}
        <div class="{{ ui.toolbar(framework) }}">{{ toolbar|raw }}</div>
    {% endif %}
</div>
