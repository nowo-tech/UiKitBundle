{#
  Symfony flash messages → nowo-ui-flash.

  Optional:
    - framework: css_framework override
    - flash_messages (2.2): override app.flashes ({type: [messages]}; tests / embedding) — preferred input
    - flashes (2.0, deprecated in 2.2): same override, honoured only outside page scaffolds (no nowo_ui_page_type in
      the context): a page that keeps a 1.x `flashes` variable must not stop the layout from consuming the session
      flashes
    - trans_domain (2.0): translate string messages (and structured title / message) with this domain;
      default null = print as given (1.x behaviour)
    - bundle (2.0): per-bundle theme exceptions (slots flash_<type> add host classes; slot `flashes` attributes /
      classes go on an optional wrapper rendered only when the theme configures them)
#}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set framework = framework|default(null) %}
{% set bundle = bundle|default(null) %}
{% set trans_domain = trans_domain|default(null) %}
{% set _t = nowo_ui_theme|default(null) %}
{% set _pt = nowo_ui_page_type|default(null) %}
{% if flash_messages is defined and flash_messages is not null %}
    {% set _messages = flash_messages %}
{% elseif flashes is defined and flashes is not null and _pt is null %}
    {% set _messages = flashes %}
{% else %}
    {% set _messages = app.flashes %}
{% endif %}
{% set _wrap_extra = _t ? _t.extraClasses('flashes', bundle, _pt) : '' %}
{% set _wrap_attrs = _t ? _t.renderAttributes('flashes', bundle, {}, _pt) : '' %}
{% if _wrap_extra or _wrap_attrs %}<div class="nowo-ui-flashes {{ _wrap_extra }}"{{ _wrap_attrs|raw }}>{% endif %}
{% for label, messages in _messages %}
    {% set flashType = label == 'error' or label == 'danger' ? 'error' : (label == 'notice' ? 'info' : label) %}
    {% set _class = _t and flashType in ['success', 'error', 'warning', 'info'] ? _t.macroClasses('flash_' ~ flashType, ui.flash(flashType, framework), bundle, _pt) : ui.flash(flashType, framework) %}
    {% for message in messages %}
        {% if message is iterable and message.title is defined %}
            {% set _text = (trans_domain ? message.title|trans({}, trans_domain) : message.title) ~ (message.message is defined and message.message ? ' — ' ~ (trans_domain ? message.message|trans({}, trans_domain) : message.message) : '') %}
        {% else %}
            {% set _text = trans_domain ? message|trans({}, trans_domain) : message %}
        {% endif %}
        <div class="{{ _class }}" role="alert">{{ _text }}</div>
    {% endfor %}
{% endfor %}
{% if _wrap_extra or _wrap_attrs %}</div>{% endif %}
