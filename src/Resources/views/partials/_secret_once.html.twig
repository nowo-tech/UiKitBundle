{#
  One-time secret (2.69, theme partial `secret_once`; opt-in runtime `secret-once`): a secret shown once (a new API
  token, a recovery code) with hide / reveal and copy controls. The secret is printed EXACTLY ONCE, as the text of
  the value element: never in a data-* attribute, a hidden input, a title, an aria-label or a second text node.

      {{ include(nowo_ui_partial('secret_once'), {secret: plain_token, label: 'API token', hint: 'Copy it now: it is shown only once.', clear_on_hide: true}, false) }}

  Without JavaScript the secret is plain, selectable text (one click selects all of it) and the buttons stay `hidden`;
  it is never hidden server-side. js/nowo-ui-secret-once.js masks it (CSS only: the node stays where it is), toggles
  it (aria-pressed), copies the node's text with the Clipboard API and says so in a role="status" region.

  REQUIRED of the host: send the page AND every fragment carrying the secret (remote dialog, Turbo frame) with
  `Cache-Control: no-store, private` (no script can wipe a response replayed from the HTTP cache); on Turbo Drive pages
  also print <meta name="turbo-cache-control" content="no-cache">.

  Required:
    - secret (string): printed escaped, once
  Optional:
    - label (View\Label|string, default "Secret"): visible name of the group (also the description of the buttons)
    - hint (View\Label|string): help text under the value (e.g. "Shown only once")
    - secret_id (default nowo-ui-secret-<random>): id of the value element (a partial-scoped name: an inherited `id`
      is never used); `<secret_id>-label` / `-hint` are derived from it
    - revealed (default false): start revealed once the runtime runs (masked otherwise)
    - clear_on_hide (default false): hiding wipes the text in place; copy and reveal are then disabled
    - clear_after (ms, default 0 = never): wipe the text this long after the runtime upgrades the root (page
      load, or when a fragment carrying it is inserted)
    - wipe_on_leave (default true, audit ZAB S3-L1): wipe the text when the enclosing <dialog> closes, on `pagehide`
      (never restored from the back/forward cache) and on `turbo:before-cache` (never kept in a Turbo snapshot); false prints data-nowo-ui-secret-once-keep-on-leave
    - labels: {show, copy, copied, copy_failed, masked, cleared} overrides (escaped)
    - attr: extra root attributes (no on*; the data-nowo-ui-secret-once* names are reserved)
#}
{% set _id = secret_id ?? ('nowo-ui-secret-' ~ random()) %}
{% set _labels = labels|default({}) %}
{% set _text = {
    show: (_labels.show ?? null) is not null ? _labels.show|nowo_ui_trans : 'secret_once.show'|trans({}, 'NowoUiKitBundle'),
    copy: (_labels.copy ?? null) is not null ? _labels.copy|nowo_ui_trans : 'secret_once.copy'|trans({}, 'NowoUiKitBundle'),
    copied: (_labels.copied ?? null) is not null ? _labels.copied|nowo_ui_trans : 'secret_once.copied'|trans({}, 'NowoUiKitBundle'),
    copy_failed: (_labels.copy_failed ?? null) is not null ? _labels.copy_failed|nowo_ui_trans : 'secret_once.copy_failed'|trans({}, 'NowoUiKitBundle'),
    masked: (_labels.masked ?? null) is not null ? _labels.masked|nowo_ui_trans : 'secret_once.masked'|trans({}, 'NowoUiKitBundle'),
    cleared: (_labels.cleared ?? null) is not null ? _labels.cleared|nowo_ui_trans : 'secret_once.cleared'|trans({}, 'NowoUiKitBundle'),
} %}
{% set _clear_after = (clear_after ?? 0)|abs|round(0, 'floor') %}
{% set _attr = nowo_ui_safe_attrs(attr|default({}), ['role', 'aria-labelledby', 'aria-describedby', 'data-nowo-ui-secret-once', 'data-nowo-ui-secret-once-state', 'data-nowo-ui-secret-once-ready', 'data-nowo-ui-secret-once-revealed', 'data-nowo-ui-secret-once-clear-on-hide', 'data-nowo-ui-secret-once-clear-after', 'data-nowo-ui-secret-once-keep-on-leave', 'data-nowo-ui-secret-once-copied-label', 'data-nowo-ui-secret-once-copy-failed-label', 'data-nowo-ui-secret-once-cleared-label']) %}
<div class="nowo-ui-secret-once{{ (_attr.class ?? false) ? ' ' ~ _attr.class }}" role="group" aria-labelledby="{{ _id }}-label"{% if hint ?? null %} aria-describedby="{{ _id }}-hint"{% endif %} data-nowo-ui-secret-once data-nowo-ui-secret-once-copied-label="{{ _text.copied }}" data-nowo-ui-secret-once-copy-failed-label="{{ _text.copy_failed }}" data-nowo-ui-secret-once-cleared-label="{{ _text.cleared }}"{% if revealed ?? false %} data-nowo-ui-secret-once-revealed{% endif %}{% if clear_on_hide ?? false %} data-nowo-ui-secret-once-clear-on-hide{% endif %}{% if (wipe_on_leave ?? true) is same as(false) %} data-nowo-ui-secret-once-keep-on-leave{% endif %}{% if _clear_after > 0 %} data-nowo-ui-secret-once-clear-after="{{ _clear_after }}"{% endif %}{{ nowo_ui_html_attrs(nowo_ui_attrs_without_class(_attr)) }}>
    <span class="nowo-ui-secret-once__label" id="{{ _id }}-label">{{ (label ?? null) is not null ? label|nowo_ui_trans : 'secret_once.label'|trans({}, 'NowoUiKitBundle') }}</span>
    <div class="nowo-ui-secret-once__field">
        <code class="nowo-ui-secret-once__value" id="{{ _id }}" translate="no" spellcheck="false" autocomplete="off" autocapitalize="off" data-nowo-ui-secret-once-value>{{ secret }}</code>
        <span class="nowo-ui-secret-once__mask" data-nowo-ui-secret-once-mask><span aria-hidden="true">&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;</span><span class="visually-hidden">{{ _text.masked }}</span></span>
        <span class="nowo-ui-secret-once__cleared" data-nowo-ui-secret-once-cleared>{{ _text.cleared }}</span>
    </div>
    <div class="nowo-ui-secret-once__actions" data-nowo-ui-secret-once-controls hidden>
        <button type="button" class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" aria-pressed="false" aria-controls="{{ _id }}" aria-describedby="{{ _id }}-label" data-nowo-ui-secret-once-toggle>{{ _text.show }}</button>
        <button type="button" class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" aria-describedby="{{ _id }}-label" data-nowo-ui-secret-once-copy>{{ _text.copy }}</button>
        <span class="nowo-ui-secret-once__status" role="status" data-nowo-ui-secret-once-status></span>
    </div>
    {%- if hint ?? null %}
    <p class="nowo-ui-secret-once__hint" id="{{ _id }}-hint">{{ hint|nowo_ui_trans }}</p>
    {%- endif %}
</div>
