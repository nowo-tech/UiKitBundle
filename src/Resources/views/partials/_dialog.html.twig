{#
  Generic native <dialog> (2.1, REQ-UI-003): header (title + close button), body, footer. Framework-free
  alternative to the Bootstrap-JS `modal_shell` (kept for BC): the preferred dialog of page-contract bundles.
  Opened by any element with data-nowo-ui-dialog-open="<id>" (js/nowo-ui-dialog.js, loaded by the UiKit document
  layout); closed by [data-nowo-ui-dialog-close], Escape, a form with method "dialog" or (backdrop_close) a backdrop
  click. No inline handlers (CSP).

  Required:
    - id
    - title: string or View\Label (translated), or title_html

  Optional:
    - body: HTML string (raw), or override the `nowo_ui_dialog_body` block through embed
    - footer: HTML string (raw)
    - size: md (default) | wide (2.29) → the two dialog sizes (docs/PAGE_CONTRACT.md "Dialog sizes and anatomy"):
      medium min(40rem, 100vw - 2rem) × min(36rem, 100dvh - 2rem), wide min(56rem, …) × min(52rem, …), tokens
      --nowo-dialog-{width,height}-{md,wide}. The 2.1 values keep their class and map onto them: sm → medium, lg / xl →
      wide (nowo-ui-dialog--<size>). 2.31: the height is the content's, capped at the size's (the body scrolls, header
      and footer stay); theme.dialog.height: size gives a dialog with a field, list, table or fold the size's height
    - status (2.29): a status badge next to the title — View\PageStatus or a hash {label, tone (success | danger |
      warning | neutral | info; any other tone → neutral), title, attributes}; rendered by the `page_status` partial
      inside a `nowo-ui-dialog__title-row` (no wrapper without a status). Any other value (a string, a number, a hash
      without a label — e.g. a `status` variable inherited from the context) is ignored: no badge, the 2.28 markup
      (View\PageStatus::fromOption())
    - footer_target (2.29): true renders an empty, hidden footer (data-nowo-ui-dialog-footer) that a script fills —
      the remote form dialog moves the fragment's form actions into it
    - placement (2.12): center (default) | end | start — end / start make a full-height side panel that slides in from
      that edge (nowo-ui-dialog--end / --start; the size sets its width); with the remote content of the script
      (data-nowo-ui-dialog-src on the opener) it is the "side panel" pattern (help, manuals, customizers)
    - body_muted: true = muted body text (slot dialog_body_muted, nowo-ui-dialog__body--muted; no framework CSS needed)
    - dismissible: false hides the header close button (default true)
    - backdrop_close: false keeps the dialog open on a backdrop click (default true)
    - close_label: accessible name of the close button (default action.close)
    - root_class (2.28): extra classes appended to the <dialog> (the `remote_form_dialog` partial adds its modifier)
    - attr: extra attributes of the <dialog>, merged over the `dialog` slot attributes
    - title_html (2.2): rich title, trusted HTML printed raw — escape what you interpolate (e.g. a name in <code>
      built with |e); wins over
      title. A Twig Markup `title` (e.g. a `{% set %}` capture) also prints unescaped
    - title_attr / body_attr (2.2): extra attributes of the title <h2> / the body <div>, merged over the
      dialog_title / dialog_body slot attributes (true = bare attribute, false / null = omitted, no on* handlers)
    - footer_attr / header_attr (2.34): extra attributes of the <footer> / <header>, merged over the dialog_footer /
      dialog_header slot attributes; `class` is added to the slot classes. Checked by nowo_ui_safe_attrs() (no on*,
      style, srcdoc or unsafe URLs)
    - back_href (2.34): a back arrow (<a>, slot dialog_back) before the title. A link to a URL: it leaves the dialog. An
      unsafe URL (javascript:, data:…, nowo_ui_safe_href()) prints no arrow. It checks the scheme, not the origin (//host
      and /\host pass): validate any value taken from the request (?back=, the referer)
    - back_label (2.34; View\Label|string): accessible name of the arrow (default action.back)
  Replace one dialog by another (2.2): an opener inside an open dialog with data-nowo-ui-dialog-replace closes the
  enclosing dialog first and hands its focus-return target over (focus goes back to the element that opened the
  first dialog).
    - bundle: per-bundle theme exceptions
  Slots: dialog (root), dialog_header, dialog_title, dialog_back (2.34), dialog_body (+ dialog_body_muted), dialog_footer
  (classes + attributes).
#}
{% set bundle = bundle|default(null) %}
{% set _pt = nowo_ui_page_type|default(null) %}
{% set _size = size|default('md') %}
{% set _status = nowo_ui_dialog_status(status ?? null) %}
{% set _placement = placement|default('center') %}
{% set title = title|default(null) %}
{% set _title = title.key is defined ? title.key|trans(title.params, title.domain) : title %}
{% set _close_label = close_label|default('action.close'|trans({}, 'NowoUiKitBundle')) %}
{% set _header_attr = nowo_ui_safe_attrs(header_attr|default({})) %}
{% set _footer_attr = nowo_ui_safe_attrs(footer_attr|default({}), footer_target|default(false) ? ['data-nowo-ui-dialog-footer', 'hidden'] : []) %}
{% set _back_href = nowo_ui_safe_href(back_href|default(null)) %}
{% set _back_label = back_label|default(null) is null ? 'action.back'|trans({}, 'NowoUiKitBundle') : back_label|nowo_ui_trans %}
<dialog id="{{ id }}" class="{{ nowo_ui_class('dialog', bundle) }}{{ _size in ['sm', 'lg', 'xl', 'wide'] ? ' nowo-ui-dialog--' ~ _size }}{{ _placement in ['end', 'start'] ? ' nowo-ui-dialog--' ~ _placement }}{{ root_class|default('') ? ' ' ~ root_class }}{{ (attr.class ?? false) ? ' ' ~ attr.class }}" data-nowo-ui-dialog aria-labelledby="{{ id }}-title"
    {{- (backdrop_close ?? true) ? ' data-nowo-ui-dialog-backdrop-close' }}
    {{- nowo_ui_theme.renderAttributes('dialog', bundle, nowo_ui_attrs_without_class(attr|default({})), _pt)|raw }}>
    <header class="{{ nowo_ui_class('dialog_header', bundle) }}{{ _header_attr.class is defined ? ' ' ~ _header_attr.class }}"{{ nowo_ui_attrs('dialog_header', bundle, nowo_ui_attrs_without_class(_header_attr)) }}>
        {% if _back_href %}<a class="{{ nowo_ui_class('dialog_back', bundle) }}" href="{{ _back_href }}" aria-label="{{ _back_label }}" title="{{ _back_label }}"{{ nowo_ui_attrs('dialog_back', bundle) }}><span aria-hidden="true">&larr;</span></a>{% endif %}{% if _status %}<div class="nowo-ui-dialog__title-row">{% endif %}<h2 class="{{ nowo_ui_class('dialog_title', bundle) }}{{ (title_attr.class ?? false) ? ' ' ~ title_attr.class }}" id="{{ id }}-title"{{ nowo_ui_attrs('dialog_title', bundle, nowo_ui_attrs_without_class(title_attr|default({}))) }}>{% if title_html|default(null) %}{{ title_html|raw }}{% else %}{{ _title }}{% endif %}</h2>{% if _status %}{{ include(nowo_ui_partial('page_status', bundle), {status: _status, bundle: bundle}, false)|trim|raw }}</div>{% endif %}

        {% if dismissible ?? true %}
            <button type="button" class="nowo-ui-dialog__close" data-nowo-ui-dialog-close aria-label="{{ _close_label }}" title="{{ _close_label }}"><span aria-hidden="true">&times;</span></button>
        {% endif %}
    </header>
    <div class="{{ nowo_ui_class('dialog_body', bundle) }}{{ body_muted|default(false) ? ' ' ~ nowo_ui_class('dialog_body_muted', bundle) }}{{ (body_attr.class ?? false) ? ' ' ~ body_attr.class }}"{{ nowo_ui_attrs('dialog_body', bundle, nowo_ui_attrs_without_class(body_attr|default({}))) }}>
        {%- block nowo_ui_dialog_body %}{{ body|default('')|raw }}{% endblock -%}
    </div>
    {% if footer|default(null) %}
        <footer class="{{ nowo_ui_class('dialog_footer', bundle) }}{{ _footer_attr.class is defined ? ' ' ~ _footer_attr.class }}"{{ nowo_ui_attrs('dialog_footer', bundle, nowo_ui_attrs_without_class(_footer_attr)) }}>{{ footer|raw }}</footer>
    {% elseif footer_target|default(false) %}
        <footer class="{{ nowo_ui_class('dialog_footer', bundle) }}{{ _footer_attr.class is defined ? ' ' ~ _footer_attr.class }}" data-nowo-ui-dialog-footer hidden{{ nowo_ui_attrs('dialog_footer', bundle, nowo_ui_attrs_without_class(_footer_attr)) }}></footer>
    {% endif %}
</dialog>
