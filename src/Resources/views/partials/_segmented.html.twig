{#
  Segmented control (2.4, theme partial `segmented`): a two-option choice backed by ONE checkbox, both options
  visible as a radio group (e.g. "All issues" / "Involved only"). The checkbox stays the form field (same name and
  POST value; a Live Component `data-model` on it keeps working); nowo-ui-segmented.js syncs it when an option is
  chosen (click, arrow keys, Home / End) and dispatches `change`. Without JavaScript the options do nothing, so use
  it where JS is available (Live Components) or keep a plain checkbox. Slots: segmented (root, role="radiogroup"),
  segmented_option (each option button, role="radio"; the selected one also gets is-active).

  Required:
    - options: two hashes {label (View\Label|string), checked (bool: the checkbox value this option stands for),
      title?, attr?}, e.g. [{label: 'All', checked: false}, {label: 'Involved', checked: true}]
    - field (FormView of a CheckboxType) OR name (+ checked, value default "1", id) for a plain checkbox (2.19: built
      as a CheckboxType FormView too — same name / value / checked; without `id` the input gets the form's
      generated id; raw input only without symfony/form, deprecated)
  Optional:
    - label (View\Label|string): aria-label of the group, or labelled_by: id of the visible label (aria-labelledby)
    - input_attr: extra checkbox attributes (data-model for Live Components…), attr: root attributes (no on*)
    - bundle, nowo_ui_page_type
#}
{% set _b = bundle|default(null) %}
{% set _field = field ?? null %}
{% set _checked = _field is not null ? _field.vars.checked|default(false) : checked|default(false) %}
{% set _input_attr = {'data-nowo-ui-segmented-input': true, tabindex: '-1'}|merge(input_attr|default({})) %}
<div class="{{ nowo_ui_class('segmented', _b) }}" role="radiogroup" data-nowo-ui-segmented{% if labelled_by|default(null) %} aria-labelledby="{{ labelled_by }}"{% elseif label|default(null) is not null %} aria-label="{{ label|nowo_ui_trans }}"{% endif %}{{ nowo_ui_attrs('segmented', _b) }}{{ nowo_ui_html_attrs(attr|default({})) }}>
    {% for _option in options %}
        {% set _selected = (_option.checked|default(false) ? true : false) == (_checked ? true : false) %}
        <button type="button" role="radio" class="{{ nowo_ui_class('segmented_option', _b) }}{{ _selected ? ' is-active' }}" aria-checked="{{ _selected ? 'true' : 'false' }}" tabindex="{{ _selected ? '0' : '-1' }}"{% if _option.title|default(null) is not null %} title="{{ _option.title|nowo_ui_trans }}"{% endif %} data-nowo-ui-segmented-option data-nowo-ui-segmented-checked="{{ _option.checked|default(false) ? 'true' : 'false' }}"{{ nowo_ui_attrs('segmented_option', _b) }}{{ nowo_ui_html_attrs(_option.attr|default({})) }}>{{ _option.label|nowo_ui_trans }}</button>
    {% endfor %}
    <span class="nowo-ui-segmented__field">
        {%- if _field is not null -%}
            {#- separate template: form_widget() exists only with symfony/form (optional) -#}
            {{ include('@NowoUiKitBundle/partials/_segmented_field.html.twig', {field: _field, input_attr: _input_attr}, false) }}
        {%- else -%}
            {#- 2.19 (REQ-TWIG-005): a plain checkbox (name / checked / value / id) is a CheckboxType FormView too;
                without symfony/form the deprecated raw input (_segmented_legacy_checkbox) -#}
            {%- set _plain_vars = {input_attr: _input_attr, name: name, value: (value|default('1')) ~ '', id: id|default(null), checked: _checked ? true : false} -%}
            {%- if nowo_ui_theme is defined -%}
                {{ include('@NowoUiKitBundle/partials/_ui_form.html.twig', _plain_vars|merge({ui_form_kind: 'checkbox', ui_form_options: {name: name, checked: _plain_vars.checked, value: _plain_vars.value, id: _plain_vars.id, partial: 'segmented'}, ui_form_template: '@NowoUiKitBundle/partials/_segmented_checkbox_form.html.twig', ui_form_legacy: '@NowoUiKitBundle/partials/_segmented_legacy_checkbox.html.twig'}), false) }}
            {%- else -%}
                {{ include('@NowoUiKitBundle/partials/_segmented_legacy_checkbox.html.twig', _plain_vars, false) }}
            {%- endif -%}
        {%- endif -%}
    </span>
</div>
