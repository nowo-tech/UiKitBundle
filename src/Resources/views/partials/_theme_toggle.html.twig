{#
  Theme toggle (light/dark). Pair with js/nowo-ui-theme.js or host Stimulus.

  Optional:
    - compact: hide text label
    - storage_key: localStorage key (default nowo-ui-theme)
#}
{% set compact = compact|default(false) %}
<button
    type="button"
    class="nowo-ui-theme-toggle{{ compact ? ' nowo-ui-theme-toggle--compact' : '' }}"
    data-nowo-ui-theme-toggle
    data-nowo-ui-theme-storage="{{ storage_key|default('nowo-ui-theme') }}"
    data-label-light="{{ 'theme.light'|trans({}, 'NowoUiKitBundle') }}"
    data-label-dark="{{ 'theme.dark'|trans({}, 'NowoUiKitBundle') }}"
    data-aria-to-light="{{ 'theme.switch_to_light'|trans({}, 'NowoUiKitBundle') }}"
    data-aria-to-dark="{{ 'theme.switch_to_dark'|trans({}, 'NowoUiKitBundle') }}"
    aria-pressed="false"
    aria-label="{{ 'theme.switch_to_dark'|trans({}, 'NowoUiKitBundle') }}"
>
    <svg class="nowo-ui-theme-toggle__icon nowo-ui-theme-toggle__icon--sun" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.75"/>
        <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.05 5.05l1.56 1.56M17.39 17.39l1.56 1.56M5.05 18.95l1.56-1.56M17.39 6.61l1.56-1.56" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
    </svg>
    <svg class="nowo-ui-theme-toggle__icon nowo-ui-theme-toggle__icon--moon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M20.2 13.4A7.8 7.8 0 0 1 10.6 3.8 8.2 8.2 0 1 0 20.2 13.4Z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
    </svg>
    {% if not compact %}
        <span class="nowo-ui-theme-toggle__label" data-nowo-ui-theme-label>{{ 'theme.dark'|trans({}, 'NowoUiKitBundle') }}</span>
    {% endif %}
</button>
