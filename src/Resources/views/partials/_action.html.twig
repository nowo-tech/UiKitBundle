{#
  One view-model Action (REQ-UI-003, Nowo\UiKitBundle\View\Action) — toolbar button or row action.

  Required:
    - action: View\Action

  Optional:
    - context: toolbar (default; theme slot btn_<variant>) | row (ui.action classes + `action` slot + the
      `action_<variant>` slot of the resolved variant — primary | secondary | danger | neutral —, display modes;
      toolbar: neutral paints with btn_secondary, variant link with btn_link; a disabled row action adds the
      row_action_disabled slot)
    - display: icon | text | icon_text — row context: default nowo_ui_kit_row_actions_display; toolbar context:
      only when passed (context option, e.g. ListPage::filtersDisplay), default icon + text with an icon, else text.
      Action::display wins over both. Icon-only: icon (action.icon, else the kind icon) + visually-hidden label,
      aria-label / title, and the `btn_icon` slot in toolbar context
    - framework: css_framework override
    - toolbar_class (2.30, toolbar context): host classes replacing the btn_<variant> slot classes (the
      `nowo-ui-action--<kind>` hook and, icon-only, the btn_icon slot stay)
    - bundle: bundle name for per-bundle theme exceptions
    - confirm_external: true = an action with a Confirm prints only its toggle button (the dialog is rendered
      elsewhere with the same id, e.g. once after the list table)
    - confirm_shared (2.68): {id, row} = an action with a Confirm opens the one shared confirm dialog `id` (partial
      `confirm_shared`, rendered once by the `table` partial) instead of its own: the toggle carries the dialog content
      as data-nowo-confirm-* attributes and the row prints only a hidden POST form (target + CSRF) with the id
      <confirmId>-form-<content key>-<row>, which the shared dialog's confirm button submits (the form's own submit is
      disabled, so Enter in the type-to-confirm input never submits it past the check). Without JavaScript the toggle does
      nothing, as with its own dialog; Action::fallbackHref keeps its <noscript> link
      2.70: also `true` (the group nowo-ui-menu-confirm), a group id (string) or `{id, row, render}`; without the
      option, the group nowo-ui-menu-confirm when nowo_ui_kit.table_confirm is shared and confirm_external is not set.
      A `true` / string group (and that default) renders the shared dialog after the action, once per request and id
      (nowo_ui_confirm_shared_once()); a hash renders it only with `render: true` (the 2.68 hash of the `table` partial
      is rendered by the table). false = the per-action dialog
    - confirm_group (2.70): group id (string), the same as confirm_shared: '<id>'; wins over confirm_shared
    - confirm_row (2.70): the row part of the hidden form id (int or string, default the hash's `row`, else 0); give
      it when two rows may hold identical actions (same target and CSRF token)
    - runtime (2.70): iife | stimulus — runtime of the shared dialog this partial renders (default
      nowo_ui_kit.dialogs.runtime)
    - menu_item (2.21): true = drawn as an item of a `menu` panel (slot menu_item, `nowo-ui-menu__item--danger` for
      danger actions) instead of a toolbar button — the `menu` partial passes it with `menu_items: true`

  With nowo_ui_kit.action_icons set for its kind, an Action without an icon of its own draws the kind's icon in a toolbar
  (default display icon_text) and in a menu item; a menu item with its own icon draws it once the map is not empty.
  Without the option both stay text, as before. nowo_ui_kit.action_variants: the variant of a kind when the action has
  no explicit one.

  Non-GET actions submit a POST form (CSRF-only FormView when given, else csrf token field); actions with a
  Confirm open the UiKit confirm <dialog>, whose confirm button submits. Action::fallbackHref (2.1) adds a
  <noscript> link to that URL (e.g. a page/confirm page) next to the dialog toggle. Action::dialogId (2.2) renders a
  <button type="button" data-nowo-ui-dialog-open aria-haspopup="dialog" aria-controls> opening the `dialog` partial
  with that id; with an href too it is an <a href> (no-JS fallback) that also loads that URL into the dialog body
  (data-nowo-ui-dialog-src). Action::title (2.2): translated tooltip (`title`; the accessible name stays the label);
  a disabled action with a title is wrapped in <span class="nowo-ui-action__tip" title> so the tooltip still shows.
  With icon_set none every action renders text-only (label once; the accessible name is unchanged). No inline on* handlers.
#}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set context = context|default('toolbar') %}
{% set framework = framework|default(null) %}
{% set bundle = bundle|default(null) %}
{% set _pt = nowo_ui_page_type|default(null) %}
{% set _context_display = display is defined and display in ['icon', 'text', 'icon_text'] ? display : null %}
{% set display = display|default(nowo_ui_kit_row_actions_display|default('icon')) %}
{% if display not in ['icon', 'text', 'icon_text'] %}
    {% set display = 'icon' %}
{% endif %}
{% if action.visible %}
    {% set display = action.display ?? (context == 'row' ? display : (_context_display ?? (action.icon or nowo_ui_kit_action_icons[action.kind] is defined ? 'icon_text' : 'text'))) %}
    {#- icon_set none: no icon to show, so every action is text-only (an icon-only action would print its label as the
        "icon" next to the visually-hidden one, icon_text the label twice) -#}
    {% if nowo_ui_kit_icon_set|default('bootstrap-icons') == 'none' %}
        {% set display = 'text' %}
    {% endif %}
    {% set label = action.label is not null ? action.label|nowo_ui_trans : ('action.' ~ action.kind)|trans({}, 'NowoUiKitBundle') %}
    {% set href = action.href ?? (action.route ? path(action.route, action.params) : null) %}
    {% set variant = action.variant ?: nowo_ui_kit_action_variants[action.kind]|default(action.resolvedVariant()) %}
    {% if context == 'row' %}
        {% set class = nowo_ui_theme.macroClasses('action', ui.action(action.kind, framework, variant == 'neutral' ? null : action.variant), bundle, _pt) %}
        {% set _variant_extra = variant in ['primary', 'secondary', 'danger', 'neutral'] ? nowo_ui_theme.extraClasses('action_' ~ variant, bundle, _pt) : '' %}
        {% set class = class ~ (_variant_extra ? ' ' ~ _variant_extra) ~ (action.disabled ? ' ' ~ nowo_ui_class('row_action_disabled', bundle, framework)) %}
    {% elseif variant in ['primary', 'secondary', 'danger', 'neutral', 'link'] %}
        {% set class = nowo_ui_class('btn_' ~ (variant == 'neutral' ? 'secondary' : variant), bundle, framework) ~ ' nowo-ui-action--' ~ action.kind %}
    {% else %}
        {% set class = nowo_ui_theme.macroClasses('btn', ui.btn(variant, null, framework), bundle, _pt) ~ ' nowo-ui-action--' ~ action.kind %}
    {% endif %}
    {#- 2.30: toolbar_class (toolbar context) replaces the btn_<variant> classes, e.g. the list filters clear_class -#}
    {% if context != 'row' and toolbar_class|default(null) is not empty %}
        {% set class = toolbar_class ~ ' nowo-ui-action--' ~ action.kind %}
    {% endif %}
    {% if context != 'row' and display == 'icon' %}
        {% set class = class ~ ' ' ~ nowo_ui_class('btn_icon', bundle, framework) %}
    {% endif %}
    {%~ if menu_item|default(false) %}
        {%~ set display = nowo_ui_kit_icon_set|default('bootstrap-icons') != 'none' and (nowo_ui_kit_action_icons[action.kind] is defined or (action.icon and nowo_ui_kit_action_icons|default({}) is not empty)) ? 'icon_text' : 'text' %}
        {%~ set class = nowo_ui_class('menu_item', bundle, framework) ~ (variant == 'danger' ? ' nowo-ui-menu__item--danger') ~ ' nowo-ui-action--' ~ action.kind %}
    {%~ endif %}
    {% set inner %}
        {%- if context == 'row' or display == 'icon' -%}
            {{ include('@NowoUiKitBundle/partials/_action_inner.html.twig', {display: display, icon_name: action.icon ?? action.kind, label: label}, false) }}
        {%- else -%}
            {%- if display == 'icon_text' -%}
                {{ include('@NowoUiKitBundle/components/_icon.html.twig', {name: action.icon ?? action.kind, label: label}, false) }}
            {%- endif -%}
            <span class="nowo-ui-action__label">{{ label }}</span>
        {%- endif -%}
    {% endset %}
    {% set _tip = action.title is null ? null : action.title|nowo_ui_trans %}
    {% set class = class ~ ((action.attributes.class ?? false) ? ' ' ~ action.attributes.class) %}{% set attrs = nowo_ui_attrs_without_class(action.attributes)|merge(context == 'row' or display == 'icon' ? {title: label, 'aria-label': label} : {})|merge(_tip is null ? {} : {title: _tip}) %}
    {% set _wrap_tip = _tip is not null and action.disabled %}
    {% if _wrap_tip %}<span class="nowo-ui-action__tip" title="{{ _tip }}">{% endif %}
    {% set confirm_id = action.confirmId() %}{% set _shared = nowo_ui_confirm_group(confirm_shared ?? null, confirm_group ?? null, confirm_row ?? null, confirm_external|default(false), nowo_ui_kit_table_confirm|default('per_row')) %}
    {% if confirm_id and _shared %}
        {#- 2.68: the shared confirm dialog — the content rides on the toggle, the POST form stays in the row (hidden) -#}
        {%- set _c = action.confirm %}
        {#- the content key keeps rows of another page (infinite scroll restarts `row`) on their own form -#}
        {%- set _form_id = confirm_id ~ '-form-' ~ action.confirmKey()|slice(0, 10) ~ '-' ~ (_shared.row ?? 0) %}
        {%- set _c_message = _c.message is null ? null : _c.message|nowo_ui_trans %}
        {%- set _c_attrs = {
            'data-nowo-confirm-form': action.disabled ? null : _form_id,
            'data-nowo-confirm-title': _c.title|nowo_ui_trans,
            'data-nowo-confirm-message': _c_message,
            'data-nowo-confirm-message-in-header': _c_message is not null and (_c.messageInHeader ?? (nowo_ui_theme.confirmMessageInHeader() ?? false)) ? '1' : null,
            'data-nowo-confirm-confirm-label': _c.confirmLabel is null ? null : _c.confirmLabel|nowo_ui_trans,
            'data-nowo-confirm-cancel-label': _c.cancelLabel is null ? null : _c.cancelLabel|nowo_ui_trans,
            'data-nowo-confirm-variant': _c.variant,
            'data-nowo-confirm-size': _c.size == 'md' ? null : _c.size,
            'data-nowo-confirm-expected-value': _c.expectedValue,
            'data-nowo-confirm-expected-pattern': _c.expectedPattern(),
            'data-nowo-confirm-expected-label': _c.expectedValue is null ? null : (_c.expectedLabel is null ? 'confirm.type_to_confirm'|trans({'%value%': _c.expectedValue}, 'NowoUiKitBundle') : _c.expectedLabel|nowo_ui_trans({'%value%': _c.expectedValue})),
        } %}
        <button type="button" class="{{ class }}"{% for name, value in attrs|merge(_c_attrs) %}{% if value is same as(true) %} {{ name }}{% elseif value is not null and value is not same as(false) %} {{ name }}="{{ value }}"{% endif %}{% endfor %}{% if action.disabled %} disabled{% endif %} {{ ui.confirm_toggle_attrs() }} {{ ui.confirm_target_attr(_shared.id) }} aria-haspopup="dialog">{{ inner }}</button>
        {%- if action.fallbackHref and not action.disabled %}<noscript><a class="{{ class }} nowo-ui-action__fallback" href="{{ action.fallbackHref }}"{% if context == 'row' or display == 'icon' %} title="{{ label }}" aria-label="{{ label }}"{% endif %}>{{ inner }}</a></noscript>{% endif -%}
        {%- if not action.disabled %}<div hidden>{{ include('@NowoUiKitBundle/partials/_action_post.html.twig', {
            action: action,
            action_href: href,
            button_class: 'nowo-ui-confirm__row-submit',
            button_attrs: {tabindex: '-1', disabled: true},
            button_html: label,
            form_id: _form_id,
        }, false)|trim }}</div>{% endif %}
    {% elseif confirm_id %}
        <button type="button" class="{{ class }}"{% for name, value in attrs %}{% if value is same as(true) %} {{ name }}{% elseif value is not null and value is not same as(false) %} {{ name }}="{{ value }}"{% endif %}{% endfor %}{% if action.disabled %} disabled{% endif %} {{ ui.confirm_toggle_attrs() }} {{ ui.confirm_target_attr(confirm_id) }}>{{ inner }}</button>
        {% if action.fallbackHref and not action.disabled %}
            <noscript><a class="{{ class }} nowo-ui-action__fallback" href="{{ action.fallbackHref }}"{% if context == 'row' or display == 'icon' %} title="{{ label }}" aria-label="{{ label }}"{% endif %}>{{ inner }}</a></noscript>
        {% endif %}
        {% if not confirm_external|default(false) %}
            {{ include(nowo_ui_partial('confirm', bundle), {
                id: confirm_id,
                confirm: action.confirm,
                action: action,
                action_href: href,
                framework: framework,
                bundle: bundle,
                nowo_ui_page_type: _pt,
            }, false) }}
        {% endif %}
    {% elseif action.isPost() %}
        {{ include('@NowoUiKitBundle/partials/_action_post.html.twig', {
            action: action,
            action_href: href,
            button_class: class,
            button_attrs: attrs,
            button_html: inner,
        }, false) }}
    {% elseif action.dialogId and href and not action.disabled %}
        <a class="{{ class }}" href="{{ href }}"{% for name, value in attrs %}{% if value is same as(true) %} {{ name }}{% elseif value is not null and value is not same as(false) %} {{ name }}="{{ value }}"{% endif %}{% endfor %} data-nowo-ui-dialog-open="{{ action.dialogId }}" data-nowo-ui-dialog-src="{{ href }}" aria-haspopup="dialog" aria-controls="{{ action.dialogId }}">{{ inner }}</a>
    {% elseif action.dialogId %}
        <button type="button" class="{{ class }}"{% for name, value in attrs %}{% if value is same as(true) %} {{ name }}{% elseif value is not null and value is not same as(false) %} {{ name }}="{{ value }}"{% endif %}{% endfor %}{% if action.disabled %} disabled{% endif %} data-nowo-ui-dialog-open="{{ action.dialogId }}" aria-haspopup="dialog" aria-controls="{{ action.dialogId }}">{{ inner }}</button>
    {% elseif action.modalId %}
        <button type="button" class="{{ class }}"{% for name, value in attrs %}{% if value is same as(true) %} {{ name }}{% elseif value is not null and value is not same as(false) %} {{ name }}="{{ value }}"{% endif %}{% endfor %}{% if action.disabled %} disabled{% endif %} {{ ui.modal_toggle_attrs(framework) }} {{ ui.modal_target_attr(action.modalId, framework) }}>{{ inner }}</button>
    {% else %}
        <a class="{{ class }}{% if action.disabled %} is-disabled{% endif %}" href="{{ href ?? '#' }}"{% for name, value in attrs %}{% if value is same as(true) %} {{ name }}{% elseif value is not null and value is not same as(false) %} {{ name }}="{{ value }}"{% endif %}{% endfor %}{% if action.disabled %} aria-disabled="true" tabindex="-1"{% endif %}>{{ inner }}</a>
    {% endif %}
{% if _wrap_tip %}</span>{% endif %}
{#- 2.70: a shared group this partial renders (confirm_shared true / a group id, or table_confirm: shared): its dialog once per request -#}
{% if confirm_id and _shared and _shared.render and nowo_ui_confirm_shared_once(_shared.id) %}
    {{ include(nowo_ui_partial('confirm_shared', bundle), {id: _shared.id, runtime: runtime ?? null, framework: framework, bundle: bundle, nowo_ui_page_type: _pt}, false) }}
{% endif %}
{% endif %}
