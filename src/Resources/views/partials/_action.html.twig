{#
  One view-model Action (REQ-UI-003, Nowo\UiKitBundle\View\Action) — toolbar button or row action.

  Required:
    - action: View\Action

  Optional:
    - context: toolbar (default; theme slot btn_<variant>) | row (ui.action classes + `action` slot + the
      `action_<variant>` slot of the resolved variant — primary | secondary | danger | neutral —, display modes;
      toolbar: neutral paints with btn_secondary, variant link with btn_link; a disabled row action adds the
      row_action_disabled slot)
    - display: icon | text | icon_text — row context: default nowo_ui_kit_row_actions_display; toolbar context:
      only when passed (context option, e.g. ListPage::filtersDisplay), default icon + text with an icon, else text.
      Action::display wins over both. Icon-only: icon (action.icon, else the kind icon) + visually-hidden label,
      aria-label / title, and the `btn_icon` slot in toolbar context
    - framework: css_framework override
    - bundle: bundle name for per-bundle theme exceptions
    - confirm_external: true = an action with a Confirm prints only its toggle button (the dialog is rendered
      elsewhere with the same id, e.g. once after the list table)

  Non-GET actions submit a POST form (CSRF-only FormView when given, else csrf token field); actions with a
  Confirm open the UiKit confirm <dialog>, whose confirm button submits. Action::fallbackHref (2.1) adds a
  <noscript> link to that URL (e.g. a page/confirm page) next to the dialog toggle. No inline on* handlers.
#}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set context = context|default('toolbar') %}
{% set framework = framework|default(null) %}
{% set bundle = bundle|default(null) %}
{% set _pt = nowo_ui_page_type|default(null) %}
{% set _context_display = display is defined and display in ['icon', 'text', 'icon_text'] ? display : null %}
{% set display = display|default(nowo_ui_kit_row_actions_display|default('icon')) %}
{% if display not in ['icon', 'text', 'icon_text'] %}
    {% set display = 'icon' %}
{% endif %}
{% if action.visible %}
    {% set display = action.display ?? (context == 'row' ? display : (_context_display ?? (action.icon ? 'icon_text' : 'text'))) %}
    {% set label = action.label is not null ? action.label|nowo_ui_trans : ('action.' ~ action.kind)|trans({}, 'NowoUiKitBundle') %}
    {% set href = action.href ?? (action.route ? path(action.route, action.params) : null) %}
    {% set variant = action.resolvedVariant() %}
    {% if context == 'row' %}
        {% set class = nowo_ui_theme.macroClasses('action', ui.action(action.kind, framework, variant == 'neutral' ? null : action.variant), bundle, _pt) %}
        {% set _variant_extra = variant in ['primary', 'secondary', 'danger', 'neutral'] ? nowo_ui_theme.extraClasses('action_' ~ variant, bundle, _pt) : '' %}
        {% set class = class ~ (_variant_extra ? ' ' ~ _variant_extra) ~ (action.disabled ? ' ' ~ nowo_ui_class('row_action_disabled', bundle, framework)) %}
    {% elseif variant in ['primary', 'secondary', 'danger', 'neutral', 'link'] %}
        {% set class = nowo_ui_class('btn_' ~ (variant == 'neutral' ? 'secondary' : variant), bundle, framework) ~ ' nowo-ui-action--' ~ action.kind %}
    {% else %}
        {% set class = nowo_ui_theme.macroClasses('btn', ui.btn(variant, null, framework), bundle, _pt) ~ ' nowo-ui-action--' ~ action.kind %}
    {% endif %}
    {% if context != 'row' and display == 'icon' %}
        {% set class = class ~ ' ' ~ nowo_ui_class('btn_icon', bundle, framework) %}
    {% endif %}
    {% set inner %}
        {%- if context == 'row' or display == 'icon' -%}
            {{ include('@NowoUiKitBundle/partials/_action_inner.html.twig', {display: display, icon_name: action.icon ?? action.kind, label: label}, false) }}
        {%- else -%}
            {%- if display == 'icon_text' -%}
                {{ include('@NowoUiKitBundle/components/_icon.html.twig', {name: action.icon ?? action.kind, label: label}, false) }}
            {%- endif -%}
            <span class="nowo-ui-action__label">{{ label }}</span>
        {%- endif -%}
    {% endset %}
    {% set attrs = action.attributes|merge(context == 'row' or display == 'icon' ? {title: label, 'aria-label': label} : {}) %}
    {% set confirm_id = action.confirmId() %}
    {% if confirm_id %}
        <button type="button" class="{{ class }}"{% for name, value in attrs %}{% if value is same as(true) %} {{ name }}{% elseif value is not null and value is not same as(false) %} {{ name }}="{{ value }}"{% endif %}{% endfor %}{% if action.disabled %} disabled{% endif %} {{ ui.confirm_toggle_attrs() }} {{ ui.confirm_target_attr(confirm_id) }}>{{ inner }}</button>
        {% if action.fallbackHref and not action.disabled %}
            <noscript><a class="{{ class }} nowo-ui-action__fallback" href="{{ action.fallbackHref }}"{% if context == 'row' or display == 'icon' %} title="{{ label }}" aria-label="{{ label }}"{% endif %}>{{ inner }}</a></noscript>
        {% endif %}
        {% if not confirm_external|default(false) %}
            {{ include(nowo_ui_partial('confirm', bundle), {
                id: confirm_id,
                confirm: action.confirm,
                action: action,
                action_href: href,
                framework: framework,
                bundle: bundle,
                nowo_ui_page_type: _pt,
            }, false) }}
        {% endif %}
    {% elseif action.isPost() %}
        {{ include('@NowoUiKitBundle/partials/_action_post.html.twig', {
            action: action,
            action_href: href,
            button_class: class,
            button_attrs: attrs,
            button_html: inner,
        }, false) }}
    {% elseif action.modalId %}
        <button type="button" class="{{ class }}"{% for name, value in attrs %}{% if value is same as(true) %} {{ name }}{% elseif value is not null and value is not same as(false) %} {{ name }}="{{ value }}"{% endif %}{% endfor %}{% if action.disabled %} disabled{% endif %} {{ ui.modal_toggle_attrs(framework) }} {{ ui.modal_target_attr(action.modalId, framework) }}>{{ inner }}</button>
    {% else %}
        <a class="{{ class }}{% if action.disabled %} is-disabled{% endif %}" href="{{ href ?? '#' }}"{% for name, value in attrs %}{% if value is same as(true) %} {{ name }}{% elseif value is not null and value is not same as(false) %} {{ name }}="{{ value }}"{% endif %}{% endfor %}{% if action.disabled %} aria-disabled="true" tabindex="-1"{% endif %}>{{ inner }}</a>
    {% endif %}
{% endif %}
